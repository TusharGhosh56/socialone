---
import Base from '../layouts/Base.astro';
import HeroVideo from '../components/HeroVideo.astro';
import AtmosphericCanvas from '../components/AtmosphericCanvas.astro';
import Button from '../components/Button.astro';

const pillars = [
  {
    title: 'Frontline Public Reality',
    desc: 'We build systems that operate in real policy, data, and institutional conditions across 15+ countries.',
    highlights: ['Population-scale systems', 'Equity & ground-truth validation', 'Sovereignty-first engineering'],
  },
  {
    title: 'Multidisciplinary Craft',
    desc: 'Our teams unite senior technologists, policy researchers, field evaluators, and econometricians.',
    highlights: ['Cross-domain paired delivery', 'Zero single-vendor lock-in', 'Rigorous empirical standards'],
  },
  {
    title: 'Durable Impact & Transfer',
    desc: 'We measure success by institutional capability transferred, not permanent advisory dependency.',
    highlights: ['Capability transfer by design', 'Open, accountable architectures', 'Long-term public trust'],
  },
];

const sampleRoles = [
  {
    id: 'ai-eval-lead',
    title: 'Lead AI Evaluation & Assurance Specialist',
    department: 'AI Evaluation & Audit',
    location: 'Hybrid · Global Delivery Hubs',
    type: 'Full-Time',
    summary: 'Lead independent algorithmic assurance, statistical bias audits, and empirical evaluation frameworks for public sector AI systems.',
    tags: ['Algorithmic Audit', 'MEL & Statistics', 'Responsible AI'],
  },
  {
    id: 'senior-ml-eng',
    title: 'Senior Applied ML & Systems Engineer',
    department: 'Engineering & Architecture',
    location: 'Hybrid · Remote Friendly',
    type: 'Full-Time',
    summary: 'Architect sovereign data pipelines, offline-first field models, and enterprise API integrations within government infrastructure.',
    tags: ['Python / PyTorch', 'Data Infrastructure', 'Sovereign AI'],
  },
  {
    id: 'public-sector-adv',
    title: 'Public Sector AI Strategy & Policy Lead',
    department: 'Practice Leadership',
    location: 'Washington DC / London / New Delhi',
    type: 'Full-Time',
    summary: 'Partner with senior government ministries and multilateral funders to structure AI governance roadmaps and institutional readiness.',
    tags: ['Public Policy', 'GovTech Advisory', 'Institutional Strategy'],
  },
];
---

<Base
  title="Careers | Join Our Team | APLYD"
  description="Explore career opportunities at APLYD. Build applied AI systems, independent evaluation frameworks, and institutional data infrastructure for public impact."
  keywords="APLYD Careers, AI Jobs, GovTech Careers, Applied Machine Learning Jobs, Public Sector AI Specialists, Athena Infonomics Careers"
>
  <div class="w-full">
    {/* ============================ HERO ============================ */}
    <section class="hero-internal-section bg-navy text-white pt-28 sm:pt-36 lg:pt-40 pb-16 sm:pb-24 lg:pb-28 min-h-screen min-h-[100dvh] flex flex-col justify-center relative overflow-hidden">
      {/* Thematic Cinematic Stock Video Background */}
      <HeroVideo
        src="/video/subpage-hero/Careers.mp4"
        overlayOpacity={0.65}
      />

      <div class="container-x relative z-10">
        <h1 class="max-w-4xl text-display font-light text-white leading-[1.08] text-3xl sm:text-5xl lg:text-6xl tracking-tight">
          Build applied AI systems that serve frontline public reality
        </h1>

        <p class="mt-4 sm:mt-5 max-w-3xl text-sm sm:text-lg lg:text-xl font-normal text-pale-navy/90 leading-relaxed">
          We work at the intersection of public policy, frontline evidence, and applied machine learning. Join a multidisciplinary team creating durable institutional intelligence across the globe.
        </p>
      </div>
    </section>

    {/* ============================ RICH ATMOSPHERIC CANVAS ============================ */}
    <AtmosphericCanvas>
      <div class="py-10 sm:py-16 lg:py-24 space-y-12 sm:space-y-16 lg:space-y-24">
        
        {/* SECTION 1: WHY BUILD AT APLYD */}
        <section class="container-x space-y-8 sm:space-y-12">
          <div class="max-w-3xl space-y-2.5 sm:space-y-4">
            <div class="text-xs font-bold uppercase tracking-widest text-gold">
              Our Practice Culture
            </div>
            <h2 class="text-2xl sm:text-4xl lg:text-5xl font-light text-navy tracking-tight leading-tight">
              Engineering AI where evidence and accountability matter most
            </h2>
            <p class="text-mid-navy text-sm sm:text-lg leading-relaxed">
              We don’t build speculative prototypes or demo-only chatbots. We design systems that integrate into statutory workflows, handle legacy data constraints, and transfer genuine capability to public teams.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6 lg:gap-8">
            {pillars.map((p) => (
              <div class="card-flip-hover rounded-2xl sm:rounded-3xl border border-hair bg-white/95 backdrop-blur-md p-5 sm:p-8 space-y-4 sm:space-y-6 shadow-sm group transition-all duration-500 hover:shadow-xl flex flex-col justify-between">
                <div class="space-y-3 sm:space-y-4 relative z-10">
                  <h3 class="text-lg sm:text-2xl font-light text-navy leading-snug transition-colors">
                    {p.title}
                  </h3>
                  <p class="text-mid-navy text-xs sm:text-small font-normal leading-relaxed flip-text transition-colors">
                    {p.desc}
                  </p>
                </div>

                <div class="pt-4 sm:pt-6 border-t border-hair space-y-1.5 sm:space-y-2 text-xs font-medium text-navy relative z-10">
                  {p.highlights.map((h) => (
                    <div class="flex items-center gap-2 flip-text transition-colors">
                      <span class="text-gold font-bold">✓</span>
                      <span>{h}</span>
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </section>

        {/* SECTION 2: OPEN ROLES / POSITIONS DECK */}
        <section class="container-x space-y-6 sm:space-y-12" id="open-roles">
          <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 sm:gap-6 border-b border-hair pb-4 sm:pb-8">
            <div class="space-y-2 sm:space-y-3 max-w-2xl">
              <div class="text-xs font-bold uppercase tracking-widest text-gold">
                Current Opportunities
              </div>
              <h2 class="text-2xl sm:text-4xl font-light text-navy tracking-tight">
                Featured Practice Positions
              </h2>
              <p class="text-mid-navy text-xs sm:text-base">
                Structured sample openings. When you apply, your application goes directly to our practice leadership.
              </p>
            </div>
            
            <a
              href="mailto:careers@aplyd.com?subject=Speculative%20Application%20-%20APLYD"
              class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-navy hover:text-gold transition-colors"
            >
              <span>General Inquiries</span>
              <span>→</span>
            </a>
          </div>

          <div class="space-y-3.5 sm:space-y-4">
            {sampleRoles.map((role) => (
              <div class="rounded-2xl border border-hair bg-white/95 backdrop-blur-md p-4 sm:p-8 shadow-sm hover:shadow-md transition-all duration-300 hover:border-gold/40 flex flex-col lg:flex-row lg:items-center justify-between gap-4 sm:gap-6">
                <div class="space-y-2 sm:space-y-3 max-w-3xl">
                  <div class="flex flex-wrap items-center gap-2">
                    <span class="rounded-md bg-pale-navy px-2 py-0.5 text-[10px] sm:text-[11px] font-bold uppercase tracking-wider text-navy border border-hair">
                      {role.department}
                    </span>
                    <span class="text-[11px] sm:text-xs text-mid-navy font-medium">
                      • {role.location}
                    </span>
                    <span class="text-[11px] sm:text-xs text-gold font-semibold">
                      • {role.type}
                    </span>
                  </div>

                  <h3 class="text-lg sm:text-2xl font-light text-navy">
                    {role.title}
                  </h3>

                  <p class="text-mid-navy text-xs sm:text-small font-normal leading-relaxed">
                    {role.summary}
                  </p>

                  <div class="flex flex-wrap items-center gap-1.5 sm:gap-2 pt-1">
                    {role.tags.map((t) => (
                      <span class="rounded-pill bg-paper px-2 py-0.5 text-[9px] sm:text-[10px] font-medium text-mid-navy border border-hair">
                        {t}
                      </span>
                    ))}
                  </div>
                </div>

                <div class="shrink-0 pt-1 lg:pt-0 w-full sm:w-auto">
                  <Button
                    href={`mailto:careers@aplyd.com?subject=Application:%20${encodeURIComponent(role.title)}`}
                    variant="primary"
                    class="w-full sm:w-auto text-center justify-center"
                  >
                    Apply for Role
                  </Button>
                </div>
              </div>
            ))}
          </div>
        </section>

        {/* SECTION 3: SPECULATIVE INQUIRY CTA */}
        <section class="container-x">
          <div class="rounded-2xl sm:rounded-3xl bg-navy text-white p-6 sm:p-10 lg:p-14 relative overflow-hidden shadow-xl border border-white/10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6 sm:gap-8">
            <div class="space-y-3 sm:space-y-4 max-w-2xl relative z-10">
              <div class="text-xs font-bold uppercase tracking-widest text-gold">
                Don't See Your Exact Role?
              </div>
              <h2 class="text-xl sm:text-3xl lg:text-4xl font-light text-white tracking-tight">
                We are always seeking exceptional researchers, engineers, and sector specialists.
              </h2>
              <p class="text-pale-navy/90 text-xs sm:text-small leading-relaxed">
                If you have deep experience in public sector transformation, machine learning evaluation, or econometric modeling, we would love to connect.
              </p>
            </div>

            <div class="relative z-10 shrink-0 w-full sm:w-auto">
              <Button href="mailto:careers@aplyd.com?subject=Speculative%20Inquiry%20-%20APLYD%20Leadership" variant="primary" class="w-full sm:w-auto text-center justify-center">
                Send Speculative Application
              </Button>
            </div>
          </div>
        </section>

      </div>
    </AtmosphericCanvas>
  </div>
</Base>
