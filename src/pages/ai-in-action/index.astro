---
import Base from '../../layouts/Base.astro';
import { caseStudyCategories } from '../../data/caseStudies';
import CaseStudyCategoryNav from '../../components/CaseStudyCategoryNav.astro';
import CaseStudyConversationCTA from '../../components/CaseStudyConversationCTA.astro';
import Button from '../../components/Button.astro';
import AtmosphericCanvas from '../../components/AtmosphericCanvas.astro';
import HeroVideo from '../../components/HeroVideo.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

import img01 from '../../assets/images/cases/01-agriculture-india.jpg';
import img02 from '../../assets/images/cases/02-education-evaluation-india.jpg';
import img03 from '../../assets/images/cases/03-education-mexico.jpg';
import img04 from '../../assets/images/cases/04-msme.jpg';
import img06 from '../../assets/images/cases/06-learning.jpg';
import img07 from '../../assets/images/cases/07-skilling.jpg';
import waterUtilityImg from '../../assets/images/cases/water-utility.jpg';
import msmeAiImg from '../../assets/images/cases/ai-msme.png';
import transformImg from '../../assets/images/cases/transform.jpg';

const categoryImages: Record<string, ImageMetadata> = {
  education: img02,
  agriculture: img01,
  msmes: msmeAiImg,
  msme: msmeAiImg,
  utilities: waterUtilityImg,
  'public-services-government': transformImg,
  'public-services': transformImg,
  'monitoring-evaluation-responsible-ai': img06,
  'monitoring-evaluation': img06,
};

const categories = Object.values(caseStudyCategories);
---

<Base
  title="AI in Action | Applied Case Studies & Evidence | APLYD"
  description="Explore APLYD's portfolio of applied AI work across Education, Agriculture, MSMEs, Utilities, Public Services, and Responsible AI Evaluation."
  keywords="APLYD Case Studies, Applied AI in Action, Government AI Deployments, Responsible AI Evaluation, AI in Agriculture, AI for Education Systems, MSME Digital Enablement AI, Utilities AI, Civic AI Case Evidence"
>
  <div class="w-full">
    {/* Hero Section */}
    <section class="hero-internal-section bg-navy text-white pt-28 sm:pt-36 lg:pt-40 pb-16 sm:pb-24 lg:pb-28 min-h-screen min-h-[100dvh] flex flex-col justify-center relative overflow-hidden">
      <HeroVideo
        src="/video/subpage-hero/all_cases.mp4"
        overlayOpacity={0.65}
      />
      <div class="container-x relative z-10">
        <h1 class="max-w-4xl text-display font-light text-white leading-[1.08] text-3xl sm:text-5xl lg:text-6xl tracking-tight">
          Applied AI across institutions and public systems
        </h1>

        <p class="mt-4 sm:mt-5 max-w-4xl lg:max-w-5xl text-sm sm:text-lg lg:text-xl font-normal text-pale-navy/90 leading-relaxed text-pretty">
          Explore our applied work across education, agriculture, small business adoption, municipal services, utilities, and independent AI assurance.
        </p>

        <div class="mt-6 sm:mt-8 max-w-4xl">
          <CaseStudyCategoryNav activeCategory="all" />
        </div>
      </div>
    </section>

    {/* Rich Atmospheric Canvas */}
    <AtmosphericCanvas>
      {/* All Categories Grid */}
      <section class="relative z-10" id="ai-directory-section">
        <div class="container-x">
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-8" id="ai-directory-grid">
            {categories.map((cat, idx) => (
              <div
                class={`ai-directory-card ai-directory-card-${idx} ai-directory-card-${cat.slug} rounded-2xl sm:rounded-3xl border border-hair bg-white/95 backdrop-blur-md shadow-sm flex flex-col group card-flip-hover overflow-hidden h-full`}
                data-card-spotlight
                data-category-index={idx}
              >
                {/* Full-Width Authentic Editorial Case Study Photography */}
                <div class="relative z-10 w-full aspect-[16/10] sm:aspect-[16/9] overflow-hidden bg-navy/5 border-b border-hair/80 shrink-0">
                  <Image
                    src={categoryImages[cat.slug] || img01}
                    alt={cat.title}
                    class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-navy/30 via-transparent to-transparent pointer-events-none"></div>
                </div>

                {/* Unified Content Body */}
                <div class="relative z-10 p-5 sm:p-7 flex flex-col flex-1">
                  <h2 class="text-xl sm:text-2xl font-bold text-navy mb-2 sm:mb-2.5 transition-colors line-clamp-2 min-h-[3.25rem] sm:min-h-[4rem] flex items-center">
                    {cat.title}
                  </h2>

                  <p class="text-xs sm:text-small text-mid-navy leading-relaxed mb-4 sm:mb-5 flip-text transition-colors min-h-[4.5rem] sm:min-h-[5.5rem] lg:min-h-[6.5rem]">
                    {cat.lead}
                  </p>

                  <div class="pt-3.5 sm:pt-4 border-t border-hair/80 mb-5 sm:mb-6">
                    <div class="text-[0.6875rem] sm:text-xs uppercase font-bold tracking-wider text-mid-navy/70 mb-2 sm:mb-2.5 flip-text transition-colors">
                      Featured Implementations:
                    </div>
                    <ul class="space-y-1.5 sm:space-y-2 text-xs sm:text-small font-bold text-navy min-h-[2.75rem] sm:min-h-[3.25rem]">
                      {cat.caseStudies.map((cs) => (
                        <li class="flex items-center gap-2 flip-text transition-colors">
                          <span class="h-1.5 w-1.5 rounded-full bg-gold shrink-0"></span>
                          <span class="line-clamp-1">{cs.title}</span>
                        </li>
                      ))}
                    </ul>
                  </div>

                  <div class="mt-auto pt-2">
                    <Button
                      href={`/ai-in-action/${cat.slug}`}
                      variant="outline"
                      class="w-full !flex items-center justify-center gap-1.5 whitespace-nowrap group-hover:!bg-gold group-hover:!text-navy group-hover:!border-gold transition-all duration-300 text-xs sm:text-small font-bold"
                    >
                      <span>Explore {cat.navLabel}</span>
                      <span class="inline-block transition-transform duration-micro group-hover:translate-x-1">&rarr;</span>
                    </Button>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* Start a conversation CTA */}
      <section class="relative z-10">
        <CaseStudyConversationCTA />
      </section>
    </AtmosphericCanvas>
  </div>
</Base>
