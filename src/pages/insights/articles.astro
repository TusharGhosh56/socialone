---
// src/pages/insights/articles.astro — Magazine Layout for Articles & The Journal
import Base from '../../layouts/Base.astro';
import AtmosphericCanvas from '../../components/AtmosphericCanvas.astro';
import MagazineCoverStory from '../../components/MagazineCoverStory.astro';
import ArticleArchiveSearch from '../../components/ArticleArchiveSearch.astro';
import Button from '../../components/Button.astro';
import HeroVideo from '../../components/HeroVideo.astro';
import { coverStory, archiveArticles } from '../../data/insights';
---

<Base
  title="The Journal | Articles & Perspectives | APLYD"
  description="Long-form editorial commentary on sovereign AI architecture, public-sector deployment, independent algorithmic auditing, and frontline adoption."
  keywords="APLYD Journal, Applied AI Articles, Sovereign AI Architecture, Public Sector AI Commentary, Responsible AI Evaluation"
>
  <div class="w-full">
    {/* ============================ HERO SECTION ============================ */}
    <section class="hero-internal-section bg-navy text-white pt-28 sm:pt-36 lg:pt-40 pb-16 sm:pb-24 lg:pb-28 min-h-screen min-h-[100dvh] flex flex-col justify-center relative overflow-hidden">
      <HeroVideo
        src="/video/optimized/gradient.mp4"
        overlayOpacity={0.65}
      />

      <div class="container-x relative z-10 space-y-4 sm:space-y-6">
        <h1 class="max-w-4xl text-display font-light text-white leading-[1.08] text-3xl sm:text-5xl lg:text-6xl tracking-tight">
          The journal
        </h1>

        <p class="max-w-4xl lg:max-w-5xl text-base sm:text-xl lg:text-2xl font-light text-pale-navy/95 leading-relaxed text-pretty">
          Long-form perspectives on applied AI, sovereign architecture, and public governance. Search the archive or explore our featured cover story.
        </p>
      </div>
    </section>

    {/* ============================ ATMOSPHERIC CANVAS ============================ */}
    <AtmosphericCanvas>
      {/* ============================ FEATURED COVER STORY ============================ */}
      <section class="relative z-10 py-10 sm:py-16" id="cover-story-section">
        <div class="container-x">
          <MagazineCoverStory story={coverStory} />
        </div>
      </section>

      {/* ============================ ARCHIVE SECTION ============================ */}
      <section class="relative z-10 py-10 sm:py-16" id="articles-archive-section">
        <div class="container-x">
          <ArticleArchiveSearch articles={archiveArticles} />
        </div>
      </section>

      {/* ============================ CTA ============================ */}
      <section class="relative z-10 py-8 sm:py-12">
        <div class="container-x">
          <div class="rounded-2xl sm:rounded-3xl border border-hair bg-white/95 backdrop-blur-md p-6 sm:p-10 lg:p-14 shadow-md flex flex-col md:flex-row items-start md:items-center justify-between gap-6 sm:gap-8 card-interactive-sheen final-cta-card">
            <div class="max-w-2xl relative z-10">
              <h3 class="text-2xl sm:text-3xl font-light text-navy mb-3">
                Explore applied AI in action
              </h3>
              <p class="text-base text-mid-navy leading-relaxed font-normal">
                Review our deployment evidence and field benchmarks across health, agriculture, utilities, and governance.
              </p>
            </div>
            <div class="relative z-10 w-full sm:w-auto">
              <Button href="/ai-in-action" variant="primary" class="w-full sm:w-auto text-center justify-center shadow-sm">
                Explore case studies &rarr;
              </Button>
            </div>
          </div>
        </div>
      </section>
    </AtmosphericCanvas>
  </div>
</Base>
