---
// Get in Touch (/contact) — the real destination for every "Partner With
// APLYD" / "Get In Touch" link sitewide (header, hero, footer, the Final
// CTA button on the homepage). The homepage's own section#contact stays in
// place as a teaser leading here, not a destination itself.
//
// BACKEND: static output, no adapter (see astro.config.mjs), so the form
// posts directly from the browser to the APLYD notification Lambda behind API
// Gateway — see src/scripts/contactPage.ts. The endpoint is read from
// PUBLIC_CONTACT_API_URL (a public URL, no credential); the browser origin
// must be on the Lambda's ALLOWED_ORIGIN list or CORS will reject it.
import Base from '../layouts/Base.astro';
import Reveal from '../components/Reveal.astro';
import { contactEmails, offices } from '../data/contactInfo';
import { serviceOptions, enquiryOptions } from '../data/contactOptions';
import { FIELD_LIMITS } from '../data/contactLimits';
---

<Base
  title="Contact APLYD | Partner With Us on Applied AI Solutions"
  description="Connect with APLYD's leadership and field practitioners to explore government AI partnerships, program evaluations, and institutional capability transfer."
  keywords="Contact APLYD, Government AI Consulting, AI Evaluation Partnership, Athena Infonomics Contact, Public Sector AI Engagement"
>
  <div class="pt-16 sm:pt-[4.5rem]">
    {/* ============================ 1. HERO + CONTACT FORM ============================ */}
    <section id="get-in-touch-hero" aria-labelledby="contact-h1" class="border-b border-hair/60 bg-paper py-12 sm:py-16 lg:py-20">
      <div class="container-x grid items-start gap-12 lg:grid-cols-12 lg:gap-14">
        {/* Left Column: Heading, Value Prop, Direct Contact Details (5 cols) */}
        <div class="space-y-8 lg:col-span-5">
          <div>
            <Reveal>
              <div class="mb-4 inline-flex items-center gap-2 rounded-pill bg-pale-navy/80 px-3.5 py-1 text-eyebrow font-bold uppercase tracking-[0.14em] text-navy">
                <span class="h-1.5 w-1.5 rounded-full bg-gold"></span>
                Get In Touch
              </div>
            </Reveal>
            <Reveal as="h1" delay={40} class="text-display font-black text-navy leading-[1.08]">
              <span id="contact-h1">Let's talk about what applied AI can do for your institution.</span>
            </Reveal>
            <Reveal as="p" delay={80} class="mt-5 text-lede font-normal text-mid-navy leading-relaxed">
              Whether you're exploring a partnership, evaluating a program, or just have a question — tell us a bit
              about what you're working on and we'll route it to the right person on the team.
            </Reveal>
          </div>

          {/* Direct Email Card */}
          <Reveal delay={120} class="rounded-2xl border border-hair/80 bg-white p-6 shadow-sm">
            <h2 id="contact-form-h2" class="text-small font-bold uppercase tracking-[0.1em] text-mid-navy">Direct Channels</h2>
            <ul class="mt-4 space-y-3">
              {
                contactEmails.map((c) => (
                  <li>
                    <a
                      href={`mailto:${c.email}`}
                      class="group flex items-center gap-3.5 rounded-xl border border-hair/60 bg-paper/60 p-3.5 text-body font-bold text-navy no-underline transition-all duration-base hover:border-smoke hover:bg-white hover:text-deep-gold hover:shadow-sm"
                    >
                      <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-pale-navy text-navy transition-colors duration-base group-hover:bg-pale-gold group-hover:text-deep-gold" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                          <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z" />
                        </svg>
                      </span>
                      <div class="min-w-0 flex-1">
                        <p class="text-eyebrow font-medium text-ash">{c.label}</p>
                        <p class="truncate text-small font-bold text-navy group-hover:text-deep-gold">{c.email}</p>
                      </div>
                    </a>
                  </li>
                ))
              }
            </ul>

            <div class="mt-5 flex items-center gap-3 border-t border-hair/60 pt-4 text-small text-mid-navy">
              <span class="grid h-5 w-5 shrink-0 place-items-center rounded-full bg-pale-gold text-deep-gold font-bold text-[10px]" aria-hidden="true">
                ✓
              </span>
              <span>Direct response from senior practice leadership.</span>
            </div>
          </Reveal>
        </div>

        {/* Right Column: Executive Contact Form (7 cols) */}
        <div class="lg:col-span-7">
          <Reveal delay={100} class="min-w-0 rounded-2xl border border-hair bg-white p-6 shadow-md sm:p-10">
            <div class="mb-7 border-b border-hair/60 pb-6">
              <h2 class="text-h3 font-bold text-navy">Send an enquiry</h2>
              <p class="mt-1 text-small text-mid-navy">
                Tell us about your organization's goals or challenges. All submissions are held in strict institutional confidence.
              </p>
            </div>

            <form id="contact-form" class="relative" data-contact-form>
              {/* Honeypot */}
              <div class="hp-field" aria-hidden="true">
                <label for="cf-ref">Leave this field blank</label>
                <input
                  id="cf-ref"
                  name="ref"
                  type="text"
                  tabindex="-1"
                  autocomplete="off"
                  data-honeypot
                  data-lpignore="true"
                  data-1p-ignore
                  data-bwignore
                  data-form-type="other"
                />
              </div>

              <div class="grid gap-5 sm:grid-cols-2 sm:gap-6">
                <div class="sm:col-span-1">
                  <label for="cf-name" class="mb-1.5 block text-small font-bold text-navy">
                    Your Name <span class="text-deep-gold">*</span>
                  </label>
                  <input
                    id="cf-name"
                    name="name"
                    type="text"
                    autocomplete="name"
                    required
                    placeholder="e.g. Dr. Priya Ramanathan"
                    maxlength={FIELD_LIMITS.name}
                    class="field-input"
                  />
                </div>
                <div class="sm:col-span-1">
                  <label for="cf-email" class="mb-1.5 block text-small font-bold text-navy">
                    Work Email <span class="text-deep-gold">*</span>
                  </label>
                  <input
                    id="cf-email"
                    name="email"
                    type="email"
                    autocomplete="email"
                    required
                    placeholder="e.g. priya@institution.org"
                    maxlength={FIELD_LIMITS.email}
                    class="field-input"
                  />
                </div>
                <div class="sm:col-span-2">
                  <label for="cf-org" class="mb-1.5 block text-small font-bold text-navy">
                    Organisation / Ministry <span class="font-normal text-ash">(optional)</span>
                  </label>
                  <input
                    id="cf-org"
                    name="organisation"
                    type="text"
                    autocomplete="organization"
                    placeholder="e.g. Ministry of Education / Multilateral Agency"
                    maxlength={FIELD_LIMITS.organisation}
                    class="field-input"
                  />
                </div>
                <div class="sm:col-span-2">
                  <label for="cf-looking-for" class="mb-1.5 block text-small font-bold text-navy">
                    What are you looking for? <span class="text-deep-gold">*</span>
                  </label>
                  <div class="relative">
                    <select id="cf-looking-for" name="lookingFor" required class="field-input appearance-none pr-10">
                      <option value="" selected disabled>Select an area of interest…</option>
                      <optgroup label="Services">
                        {serviceOptions.map((opt) => <option value={opt}>{opt}</option>)}
                      </optgroup>
                      <optgroup label="General enquiries">
                        {enquiryOptions.map((opt) => <option value={opt}>{opt}</option>)}
                      </optgroup>
                    </select>
                    <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3.5 text-mid-navy" aria-hidden="true">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m6 9 6 6 6-6" />
                      </svg>
                    </div>
                  </div>
                </div>
                <div class="sm:col-span-2">
                  <div class="mb-1.5">
                    <label for="cf-message" class="text-small font-bold text-navy">
                      Message <span class="text-deep-gold">*</span>
                    </label>
                  </div>
                  <textarea
                    id="cf-message"
                    name="message"
                    rows="4"
                    required
                    placeholder="Briefly describe your objectives, data availability, or specific public program..."
                    maxlength={FIELD_LIMITS.message}
                    class="field-input resize-y"
                  />
                  <div class="mt-1.5 flex items-center justify-between gap-2">
                    <span class="text-spec text-ash">Detailed description helps us prepare</span>
                    <p class="text-small text-ash" data-message-counter></p>
                  </div>
                </div>
              </div>

              <div class="mt-8 flex flex-wrap items-center justify-between gap-4 border-t border-hair/60 pt-6">
                <button
                  type="submit"
                  class="group inline-flex cursor-pointer items-center gap-0 rounded-pill bg-navy px-8 py-3.5 font-bold text-body text-white no-underline transition-[transform,box-shadow,background-color,color] duration-base ease-out will-change-transform hover:-translate-y-px hover:bg-deep-navy hover:shadow-lg"
                >
                  <span
                    aria-hidden="true"
                    class="inline-block h-2 w-0 rounded-full bg-gold opacity-0 transition-all duration-base ease-out group-hover:mr-2 group-hover:w-2 group-hover:opacity-100 motion-reduce:transition-none"
                  ></span>
                  <span data-submit-label>Send message</span>
                </button>
                <p
                  id="contact-form-status"
                  role="status"
                  aria-live="polite"
                  class="text-small text-mid-navy"
                  data-contact-form-status
                />
              </div>
            </form>

            {/* Success Panel */}
            <div class="contact-success" data-contact-success tabindex="-1" hidden>
              <span class="contact-success__icon" aria-hidden="true">
                <svg
                  width="28"
                  height="28"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M20 6 9 17l-5-5" />
                </svg>
              </span>
              <h3 class="mt-5 text-h3 font-bold text-navy">Thank you — your message is on its way.</h3>
              <p class="mx-auto mt-3 max-w-measure text-body text-mid-navy">
                We've received your enquiry and someone from the APLYD team will be in touch shortly.
              </p>
              <button type="button" class="contact-success__reset mt-7 inline-flex cursor-pointer items-center gap-2" data-contact-reset>
                <span>Send another message</span>
                <span aria-hidden="true">→</span>
              </button>
            </div>
          </Reveal>
        </div>
      </div>
    </section>

    {/* ============================ 2. OUR OFFICES ============================ */}
    <section aria-labelledby="offices-h2" class="bg-off-white py-14 sm:py-20">
      <div class="container-x">
        <div class="mb-10 max-w-2xl">
          <Reveal>
            <span class="text-eyebrow font-bold uppercase tracking-[0.14em] text-deep-gold">Global Presence</span>
          </Reveal>
          <Reveal as="h2" delay={40} class="mt-2 text-h2 font-bold text-navy">
            <span id="offices-h2">Our offices</span>
          </Reveal>
          <Reveal as="p" delay={80} class="mt-3 text-lede font-normal text-mid-navy">
            Headquartered and operating across five continents to support global institutions.
          </Reveal>
        </div>

        <div class="grid items-stretch gap-8 lg:grid-cols-12 lg:gap-10">
          {/* Left: Office Selection & Details (5 cols) */}
          <Reveal class="flex flex-col justify-between rounded-2xl border border-hair bg-white p-6 shadow-sm sm:p-8 lg:col-span-5">
            <div>
              <p class="text-small font-bold uppercase tracking-[0.08em] text-mid-navy">Select a location</p>
              {
                offices.length > 1 ? (
                  <div class="mt-4 flex flex-wrap gap-2" data-office-list role="tablist" aria-label="Office locations">
                    {offices.map((o, i) => (
                      <button
                        type="button"
                        class="office-pill"
                        data-office-index={i}
                        data-office-address={o.address}
                        data-office-query={o.mapQuery}
                        aria-pressed={i === 0 ? 'true' : 'false'}
                      >
                        {o.city}
                      </button>
                    ))}
                  </div>
                ) : null
              }
            </div>

            <div class="mt-8 border-t border-hair/60 pt-6">
              <p class="text-eyebrow font-bold uppercase tracking-[0.1em] text-mid-navy">Office Address</p>
              <p class="mt-2.5 flex items-start gap-3 text-body text-navy" data-office-address>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="mt-1 shrink-0 text-gold" aria-hidden="true">
                  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z" />
                </svg>
                <span class="leading-relaxed font-medium">{offices[0]?.address}</span>
              </p>
            </div>
          </Reveal>

          {/* Right: Interactive Map (7 cols) */}
          <Reveal delay={80} class="overflow-hidden rounded-2xl border border-hair bg-white shadow-sm lg:col-span-7 h-[360px] sm:h-[400px] lg:h-auto min-h-[360px]" data-office-map-wrap>
            <iframe
              data-office-map
              title="APLYD office location"
              src={`https://www.google.com/maps?q=${encodeURIComponent(offices[0]?.mapQuery ?? '')}&output=embed`}
              width="100%"
              height="100%"
              class="w-full h-full border-0 block min-h-[360px]"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            />
          </Reveal>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  .field-input {
    display: block;
    width: 100%;
    border-radius: 0.625rem;
    border: 1px solid var(--hair);
    background: var(--paper);
    padding: 0.8rem 1rem;
    font-family: inherit;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--navy);
    transition:
      border-color var(--dur-base) var(--ease-out),
      background-color var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out);
  }
  .field-input::placeholder {
    color: var(--ash);
    opacity: 0.75;
    font-weight: 300;
  }
  .field-input:hover {
    border-color: var(--smoke);
    background: var(--off-white);
  }
  .field-input:focus {
    outline: none;
    border-color: var(--gold);
    background: var(--white);
    box-shadow: 0 0 0 3px rgba(209, 156, 51, 0.2);
  }
  .field-input:focus-visible {
    outline: none;
    border-color: var(--gold);
    background: var(--white);
    box-shadow: 0 0 0 3px rgba(209, 156, 51, 0.2);
  }

  /* Honeypot wrapper — off the canvas but still a real, focusable, filled-in
     input as far as a form-scraping bot is concerned. Offset to the left so
     it can't extend the scrollable area (LTR overflow to the left doesn't). */
  .hp-field {
    position: absolute;
    left: -9999px;
    top: 0;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  /* Success panel. Deliberately no `display` of its own — the browser's
     default [hidden] rule is what keeps it out of the layout, and any display
     value set here would override it and leave the panel permanently visible. */
  .contact-success {
    padding: 2.5rem 1rem;
    text-align: center;
  }
  .contact-success:focus {
    outline: none;
  }
  .contact-success__icon {
    display: inline-grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    border-radius: 999px;
    background: var(--pale-gold);
    color: var(--deep-gold);
  }
  .contact-success__reset {
    border-radius: 999px;
    border: 1px solid var(--hair);
    background: var(--paper);
    color: var(--navy);
    padding: 0.75rem 1.6rem;
    font-size: 1rem;
    font-weight: 700;
    transition:
      border-color var(--dur-base) var(--ease-out),
      background-color var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }
  .contact-success__reset:hover {
    border-color: var(--gold);
    background: var(--white);
    transform: translateY(-1px);
  }

  [data-message-counter][data-state='warn'] {
    color: var(--mid-navy);
  }
  [data-message-counter][data-state='error'] {
    color: var(--error);
    font-weight: 700;
  }

  /* Reserve the line so the row doesn't reflow when a message first appears. */
  [data-contact-form-status] {
    min-height: 1.5rem;
  }
  [data-contact-form-status][data-state='success'] {
    color: var(--navy);
    font-weight: 700;
  }
  [data-contact-form-status][data-state='error'] {
    color: var(--error);
    font-weight: 700;
  }

  /* The submit button's hover lift comes from Tailwind utilities, which
     still apply while disabled — the ID here outranks them. */
  #contact-form button[type='submit']:disabled,
  #contact-form button[type='submit']:disabled:hover {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
  }

  .office-pill {
    border-radius: 999px;
    border: 1px solid var(--hair);
    background: var(--paper);
    color: var(--navy);
    padding: 0.45rem 1rem;
    font-size: 0.875rem;
    font-weight: 700;
    cursor: pointer;
    transition:
      background-color var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out),
      color var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out);
  }
  .office-pill:hover {
    border-color: var(--gold);
    background: var(--white);
  }
  .office-pill[aria-pressed='true'] {
    background: var(--navy);
    border-color: var(--navy);
    color: var(--white);
    box-shadow: var(--shadow-sm);
  }
</style>

<script>
  import { initContactPage } from '../scripts/contactPage';
  initContactPage();
</script>
