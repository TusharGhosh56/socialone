     underneath — unchanged when the video isn't showing. */
  .future-cta__video-wrap {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
    transition: opacity 500ms var(--ease-out);
  }
  #contact:has(.future-cta__trigger:hover) .future-cta__video-wrap,
  #contact:has(.future-cta__trigger:focus-visible) .future-cta__video-wrap {
    opacity: 1;
