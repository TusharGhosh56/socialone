<script>
  import { initTilt } from '../scripts/tilt';
  import { settledOffsetY } from '../scripts/flowLine';
  import { initApproachBurst } from '../scripts/approachBurst';
  import { initServiceOrbit } from '../scripts/serviceOrbit';
  import { initGoldWaveform } from '../scripts/goldWaveform';
  import { initCardSpotlight } from '../scripts/cardSpotlight';
  import { initTimelineTraveler } from '../scripts/timelineTraveler';
  initTilt();
  initServiceOrbit();
  initGoldWaveform();
  initCardSpotlight();
  initTimelineTraveler();

  // The ambient burst lives in What We Do now, centred precisely on the
  // same point flowLine.ts's "what-we-do" milestone anchors to (.connect-dot)
  // — approachBurst.ts always draws its origin at its own box's vertical
  // centre, so this sizes/positions that box (full section width already
  // comes from CSS's left:0;right:0) symmetrically around the dot's real Y,
  // clamped to whichever side (above/below) has less room so it never
  // overflows the section's own bounds.
  function alignWhatWeDoBurst() {
    const section = document.getElementById('what-we-do');
    const burst = section?.querySelector<HTMLElement>('[data-approach-burst]');
    const dot = section?.querySelector<HTMLElement>('.connect-dot');
    if (!section || !burst || !dot) return;
    const sectionRect = section.getBoundingClientRect();
    const dotRect = dot.getBoundingClientRect();
    // Same not-yet-revealed-ancestor correction flowLine.ts's own milestone
    // measurement needs (settledOffsetY) — .connect-dot lives inside a
    // [data-reveal] wrapper (.connect-wrap), and measuring it before that
    // reveal has fired reads its temporary pre-reveal position (translated
    // down ~16px), which would otherwise get baked into this alignment.
    const dotY = dotRect.top + dotRect.height / 2 - sectionRect.top - settledOffsetY(dot);
    const half = Math.min(dotY, sectionRect.height - dotY);
    burst.style.top = `${dotY - half}px`;
    burst.style.height = `${half * 2}px`;
  }
  alignWhatWeDoBurst();
  window.addEventListener('resize', alignWhatWeDoBurst, { passive: true });
  // Same gap flowLine.ts's own milestone measurement already learned to
  // close (see its screenCenterX/settledOffsetY comment: "nothing then
  // corrects it until an unrelated resize event... forces a fresh measure()
  // ... which is why 'zoom out then in' appeared to fix it") — this only had
  // the resize listener, not the window.load one, so anything that settles
  // between this initial call and full page load (images, the preloader's
  // own body scroll-lock while it's up, etc.) could still bake in a stale
  // measurement until a real resize (zoom) forced a recompute. Re-running
  // here, plus a synthetic resize event so approachBurst.ts's own internal
  // origin/W recompute too, closes it the same way flowLine.ts already does.
  window.addEventListener('load', () => {
    alignWhatWeDoBurst();
    window.dispatchEvent(new Event('resize'));
  });
  // `load` doesn't cover everything either — web fonts fetch lazily and
  // don't block it (that's the whole point of font-display:swap), so a
  // font-swap reflow can still land AFTER `load` has already fired and
  // already re-measured. document.fonts.ready resolves once fonts actually
  // finish, which is the more precise signal for this specific case.
  document.fonts?.ready?.then(() => {
    alignWhatWeDoBurst();
    window.dispatchEvent(new Event('resize'));
  });

  // Our Foundation's rotating rings — sm+ only (see the markup comment in
  // that section for the full horizontal/vertical reasoning); below 640px
  // this is skipped entirely and a plain CSS rule takes over instead (the
  // rings' centre sits fixed on the section's own top-right corner there,
  // per explicit product decision — no text "centre" worth tracking once
  // the section grew much taller on mobile). Same resync events as
  // alignWhatWeDoBurst() above, for the same reasons (fonts/images settling
  // after this first measurement, no `resize` event of its own to catch it).
  function positionFoundationRings() {
    const section = document.getElementById('about');
    const text = section?.querySelector<HTMLElement>('[data-foundation-text]');
    const rings = section?.querySelector<HTMLElement>('[data-foundation-rings]');
    if (!section || !text || !rings) return;
    if (document.documentElement.clientWidth < 640) {
      rings.style.top = '';
      return;
    }
    const sectionRect = section.getBoundingClientRect();
    const textRect = text.getBoundingClientRect();
    const centerY = textRect.top + textRect.height / 2 - sectionRect.top;
    rings.style.top = `${centerY}px`;
  }
  positionFoundationRings();
  window.addEventListener('resize', positionFoundationRings, { passive: true });
  window.addEventListener('load', positionFoundationRings);
  document.fonts?.ready?.then(positionFoundationRings);

  // Must run AFTER alignWhatWeDoBurst()'s own initial call above: this
  // measures the burst canvas's own box on load to size its pixel buffer,
  // and needs to see the FINAL top/height set by that function, not the
  // full-section-height box it started life at — same "measure after
  // layout settles, then size the canvas" ordering this codebase already
  // leans on elsewhere (getting it backwards previously caused the burst
  // to render stretched/blurry).
  initApproachBurst();
</script>

