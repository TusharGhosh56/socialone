  }

  /* ------------------------------------------------------------------ */
  /* 3 · THE PROBLEM — friction cards (right column). Hover/focus swaps    */
  /* the flat off-white card for the same dark navy gradient + moving      */
  /* sheen used sitewide (.gradient-navy/.gradient-sheen — How We Work,    */
  /* Trust metrics), plus a small revealed description. The dark layer     */
  /* lives on ::before (opacity 0→1) rather than swapping the card's own   */
  /* background-image directly — background-image itself doesn't          */
  /* transition smoothly, only opacity/color do, so this is what gives     */
  /* the fade-to-dark its actual animation; the moving-highlight layer     */
  /* reuses the sitewide @keyframes hero-sheen (global.css) rather than    */
  /* a one-off animation, so the motion reads as the same "alive" gradient */
  /* as the rest of the site. `.friction-card`'s own transition list       */
  /* below deliberately REPEATS [data-flow-fade]'s opacity/transform       */
  /* transition (same selector specificity, this rule loads later so it    */
  /* would otherwise silently replace — not merge with — that one and      */
  /* kill the scroll-in/out fade) alongside the border-color transition    */
  /* this component actually adds. */
  .friction-card {
    position: relative;
    transition:
      opacity 500ms var(--ease-out),
      transform 500ms var(--ease-out),
      border-color var(--dur-base) var(--ease-out);
  }
  .friction-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-base) var(--ease-out);
    background-image:
      linear-gradient(
        100deg,
        transparent 15%,
        rgba(74, 83, 138, 0.4) 40%,
        rgba(209, 156, 51, 0.08) 52%,
        transparent 78%
      ),
      linear-gradient(180deg, #0d1030 0%, #171d47 40%, #171d47 68%, #0d1030 100%);
    background-size: 260% 100%, 100% 100%;
    background-position: 0% 0%, 0 0;
    animation: hero-sheen 16s ease-in-out infinite;
  }
  .friction-card:hover,
  .friction-card:focus {
    border-color: transparent;
  }
  .friction-card:hover::before,
  .friction-card:focus::before {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .friction-card {
      transition: none;
    }
    .friction-card::before {
      transition: none;
      animation: none;
      background-position: 45% 0%, 0 0;
    }
  }

  /* ------------------------------------------------------------------ */
  /* 3 · THE CHALLENGE — principle card row width-on-hover. Only lg+       */
  /* (the true 1-row-of-4 layout) gets the width steal; at sm's 2-per-row  */
  /* and mobile's 1-per-row the row already reads fine with PrincipleItem's
     own height-only grow. Column count is fixed at 4 real cards, so this
     is a plain per-index :has() swap rather than anything dynamic — if
     principles.ts ever gets a 5th entry this needs a 5th rule (and a 5-col
     grid) to match, not something derivable automatically. `.challenge-
     cards`'s own grid-auto-rows (set via Tailwind, index.astro) reserves
     each row at PrincipleItem's own fixed height, and items-end bottom-
     anchors every card within it. 1.2857fr solves g/(g+3) = 0.3 — i.e. the
     hovered column claims 30% of the row (up from an equal 25%) while the
     other three each drop to 1/4.2857 ≈ 23.3% — chosen because it maps to
     a concrete 250px→300px resting→hover width at the actual measured
     card width, per explicit product decision (not an arbitrary ratio). */
  @media (min-width: 1024px) {
    .challenge-cards:has(> :nth-child(1) .principle-card:hover),
    .challenge-cards:has(> :nth-child(1) .principle-card:focus-visible) {
      grid-template-columns: 1.2857fr 1fr 1fr 1fr;
    }
    .challenge-cards:has(> :nth-child(2) .principle-card:hover),
    .challenge-cards:has(> :nth-child(2) .principle-card:focus-visible) {
      grid-template-columns: 1fr 1.2857fr 1fr 1fr;
    }
    .challenge-cards:has(> :nth-child(3) .principle-card:hover),
    .challenge-cards:has(> :nth-child(3) .principle-card:focus-visible) {
      grid-template-columns: 1fr 1fr 1.2857fr 1fr;
    }
    .challenge-cards:has(> :nth-child(4) .principle-card:hover),
    .challenge-cards:has(> :nth-child(4) .principle-card:focus-visible) {
      grid-template-columns: 1fr 1fr 1fr 1.2857fr;
    }
    .challenge-cards {
      transition: grid-template-columns var(--dur-base) var(--ease-out);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .challenge-cards {
      transition: none;
    }
  }
</style>
