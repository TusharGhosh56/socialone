---
import Base from '../layouts/Base.astro';
import Reveal from '../components/Reveal.astro';
import Button from '../components/Button.astro';
import MetricCard from '../components/MetricCard.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ServiceOrbit from '../components/ServiceOrbit.astro';
import StepCarousel from '../components/StepCarousel.astro';
import PrincipleItem from '../components/PrincipleItem.astro';
import CaseCarousel from '../components/CaseCarousel.astro';
import TeamCarousel from '../components/TeamCarousel.astro';
import FaqItem from '../components/FaqItem.astro';
import HeroFlow from '../components/HeroFlow/HeroFlow.astro';
// FlowChart (the original 7-station version) is archived, not deleted — its
// <FlowChart /> usage below is commented out, but the component files
// themselves are untouched. FlowChartV2 is the live duplicate.
import FlowChart from '../components/FlowChart/FlowChart.astro';
import FlowChartV2 from '../components/FlowChartV2/FlowChartV2.astro';

import { metrics } from '../data/metrics';
import { services } from '../data/services';
import { steps } from '../data/steps';
import { principles } from '../data/principles';
import { engagementPrinciples } from '../data/engagementPrinciples';
import { cases } from '../data/cases';
import { teamRowA, teamRowB } from '../data/team';
import { faqs } from '../data/faqs';

// Friction points (§3) — restrained inline icons. `description` is revealed
// on hover/focus only (see .friction-card in the <style> block below).
const frictions = [
  {
    label: "Pilot projects that don't scale",
    icon: 'scale',
    description:
      "Proofs of concept that prove the idea but never make it into everyday budgets, systems, or decisions.",
  },
  {
    label: 'Insights that arrive too late',
    icon: 'clock',
    description: 'Analysis that lands after the decision window has already closed, when it can no longer change the outcome.',
  },
  {
    label: 'Knowledge that remains fragmented',
    icon: 'fragment',
    description: 'Data and lessons trapped in silos instead of shared across teams, systems, and institutions.',
  },
];

// FAQ — split into 2 independent columns (first half / second half) rather
// than a CSS grid's row-major cells: a real grid ties both columns' row
// heights together, so opening one item in the left column visibly pushed
// the right column's items apart too (an empty gap opening up beside a
// question that never itself expanded) — explicitly reported as a bug.
// Two plain stacked columns have no shared rows to tie together, so
// expanding an item only ever affects its own column.
const faqMid = Math.ceil(faqs.length / 2);
const faqColumns = [faqs.slice(0, faqMid), faqs.slice(faqMid)];

---

<Base
  title="APLYD | Applied AI for Governments & Impact-Focused Institutions"
  description="APLYD moves artificial intelligence from pilot to public service—engineering sovereign, field-tested AI solutions and institutional capability for governments, multilaterals, and global impact organizations."
  keywords="Applied AI, Government AI, GovTech AI Solutions, Public Sector Digital Transformation, Decision Intelligence, Institutional AI Capability, Sovereign AI Infrastructure, Sovereign Codebase Handover, Athena Infonomics, Independent AI Evaluation, Responsible AI in Government, Civic AI, Public Systems AI, AI for Global Development"
>
  <span id="top" aria-hidden="true"></span>

  {/* Hero + FlowChart are two independent rounded cards on the page's normal
      light background (see .hero-flow-stack, global.css) stacked with zero
      gap, each section painting its own background. Vision & Mission (which
      used to also live in this stack, between FlowChart and Trust) was
      removed entirely per explicit product decision — Trust now sits flush
      against FlowChartV2 instead, same zero-gap treatment as before. */}
  <div class="hero-flow-stack">
    {/* ==================== 1 · HERO (video card) ==================== */}
    <HeroFlow />

    {/* ================ 1b · ARCHIVED — ORIGINAL FLOWCHART ================
        Hidden per explicit product decision (trimmed station roster, bigger
        stations, full viewport height, no eyebrow — see FlowChartV2 below).
        Kept here, commented out rather than deleted, in case the original
        7-station version is wanted again later — src/components/FlowChart/
        (the component files themselves) is untouched, just unused while
        this stays commented out.

    <FlowChart />

    ================================================================= */}

    {/* ================ 1b · FLOW (data-to-decisions animation) ================
        FlowChartV2 — the live duplicate. See src/components/FlowChartV2/
        for the full rationale (Institution/Delivery/Ownership dropped,
        Ownership's satellite folded into Impact, ~1.3x bigger stations,
        full viewport height, no eyebrow, heading/body copy moved here from
        Trust after an earlier session's accidental swap — see Trust's own
        comment below). */}
    <FlowChartV2 />
  </div>

  {/* =========================== 2 · TRUST ===========================
      Copy below is Trust's real text, restored here after an earlier
      session accidentally swapped it with FlowChart's — FlowChartV2 now
      carries the "From AI pilots to institutional capability." copy that
      used to live here instead. */}
  <section id="trust" aria-labelledby="trust-h2" class="section-y scroll-mt-24 bg-off-white">
    <div class="container-x">
      <Reveal as="h2" class="max-w-[20ch] text-h2 font-bold">
        <span id="trust-h2">Trusted by institutions solving complex public challenges.</span>
      </Reveal>
      <Reveal as="p" delay={60} class="mt-5 max-w-measure text-lede font-light text-mid-navy">
        Built on sixteen years of proven delivery through Athena Infonomics, across 5 continents for
        governments, donors, and impact-focused institutions.
      </Reveal>
    </div>

    {/* The card's BACKGROUND is full-bleed (sibling of the .container-x
        above, not nested inside it — square corners, matches the rest of
        this redesign), but the stat numbers themselves stay within a
        nested .container-x so they align with the heading/paragraph above
        rather than spreading edge to edge — two different "full width"s at
        once. The card's own horizontal padding (px-6/px-10) moved to this
        inner container-x's built-in padding-inline instead, so it isn't
        double-applied on top of it; py-10/py-14 (vertical) stays on the
        card. relative z-10 on the inner container-x (rather than
        metric-row directly) is what keeps the stats above .gradient-sheen's
        own absolutely-positioned z-index:1 sweep layer (the stacking-
        context gotcha) — .gradient-navy already sets position:relative on
        the card itself. */}
    <Reveal delay={160} class="mt-12 gradient-navy gradient-sheen py-10 sm:py-14">
      <div class="container-x relative z-10">
        <div class="metric-row grid grid-cols-2 gap-x-4 gap-y-10 sm:grid-cols-3 lg:grid-cols-5">
          {metrics.map((m) => <MetricCard {...m} />)}
        </div>
      </div>
    </Reveal>
  </section>

  {/* ========================= 3 · THE CHALLENGE =========================
      Formerly "6 · WHY APLYD" — moved here to replace the old friction-card
      Challenge section per explicit product decision (see the archived,
      commented-out original further down, kept in place in case it's
      reused for a different section later rather than deleted outright).
      Heading/subheading text is carried over verbatim from that old
      section; only the description paragraphs and the principle cards'
      content changed. id="why-aplyd" kept as-is (nav.ts's anchor still
      targets it) even though the eyebrow/nav label is now "The Challenge",
      to avoid an unrelated id churn on top of everything else moving. */}
  <section id="why-aplyd" aria-labelledby="why-h2" class="section-y scroll-mt-24 bg-paper">
    <div class="container-x">
      {/* Heading/subheading left, description right — same 2-col split as
          the old friction-card Challenge section used (text/pointers), so
          the heading still starts at the same left edge as every other
          section. justify-center on the right column roughly aligns its
          paragraph with the (taller, 2-line) left column's h3, same
          vertical-centering convention that section used for its own right
          column. */}
      <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
        <div>
          <Reveal as="h2" class="text-h2 font-bold">
            <span id="why-h2">Why today's AI efforts struggle</span>
          </Reveal>
          <Reveal as="h3" delay={100} class="mt-6 text-h3 font-bold text-mid-navy">
            Technology isn't the hardest part.
          </Reveal>
        </div>
        <div class="flex max-w-measure flex-col justify-center lg:mt-2">
          <Reveal as="p" delay={140} class="text-navy/90">
            Governments and impact-focused institutions are investing in AI to improve how public
            services are planned and delivered. Yet many AI initiatives struggle to move beyond
            pilots or become part of everyday government operations.
          </Reveal>
          <Reveal as="p" delay={180} class="mt-4 text-navy/90">
            Technology is only one piece of the puzzle. Successful AI implementation also depends on
            data, institutions, governance, capability and continuous measurement. Without these, even
            the most advanced AI systems rarely deliver lasting impact.
          </Reveal>
        </div>
      </div>

      {/* 1×4 — one row of portrait cards at lg+, stepping down to 2×2 then a
          single column as the viewport narrows (same responsive shape as
          every other multi-card grid on this page, e.g. ServiceCard's).
          auto-rows/items-end reserve each row at PrincipleItem's own
          hover-height and bottom-anchor every card within it, so a card
          growing taller on hover never shifts the row (or the section
          below it) — see the .challenge-cards rule near the bottom of this
          file for the matching width-on-hover behaviour at lg+. */}
      <div class="challenge-cards mt-14 grid grid-cols-1 auto-rows-auto items-stretch gap-6 sm:grid-cols-2 lg:grid-cols-4 lg:auto-rows-[420px] lg:items-end">
        {principles.map((p, i) => <Reveal delay={160 + i * 100}><PrincipleItem {...p} /></Reveal>)}
      </div>
    </div>
  </section>

  {/* ======================= 4 · WHAT APLYD DOES ======================= */}
  <section id="what-we-do" aria-labelledby="what-h2" class="section-y scroll-mt-24 bg-off-white relative">
    {/* Ambient burst (src/scripts/approachBurst.ts) — relocated here from
        How We Work, per the user's redirect (not Future of AI). A direct
        child of the section (sibling of .container-x below), plain
        `inset:0` (see .approach-burst in the <style> block near the bottom
        of this file) gives it the confirmed "full section-width bleed"
        with zero alignment JS needed — unlike its old How We Work home,
        which had to stretch it out past a column by hand. Its origin lands
        on the SECTION's own visual centre rather than being pixel-matched
        to .connect-dot's exact position below (that'd need new measurement
        JS); close enough for an ambient background layer. .container-x
        below gets `relative z-10` so the orbit/card content paints above
        this z-index:0 layer — same stacking-context requirement the old
        How We Work version needed. */}
    <Reveal delay={140} class="approach-burst" data-approach-burst>
      <canvas class="approach-burst__canvas" data-approach-canvas aria-hidden="true"></canvas>
    </Reveal>
    <div class="container-x relative z-10">
      <Reveal as="h2" class="text-h2 font-bold">
        <span id="what-h2">What APLYD does</span>
      </Reveal>
      {/* max-w-md forces a clean two-line wrap (was max-w-measure/68ch,
          nearly one long line reaching well past centre) so the text stays
          clear of the flowing line's vertical run down the centre rail.
          id="what-subhead" is flowLine.ts's own mobile-only jog anchor (see
          that file's whatWeDoJogY()) — needed since ServiceCard.astro's own
          card titles are ALSO <h3>s inside this section, so a plain
          `#what-we-do h3` selector would ambiguously match those too. */}
      <Reveal as="h3" delay={100} id="what-subhead" class="mt-4 max-w-md text-h3 font-bold text-mid-navy">
        We help institutions move from AI ambition to real-world impact.
      </Reveal>

      {/* .connect-dot is the master flowing line's milestone anchor for this
          section (an invisible 0-size positional marker — flowLine.ts reads
          its centre point) — untouched by the orbit infographic below; it
          stays a plain sibling `<span>` so flowLine.ts's `.connect-dot`
          query and screenCenterX() math keep working exactly as before. At
          md+ the ServiceOrbit lives in the SAME centred wrapper so its own
          visual centre lands on this span's 50%/50% point for free — below
          md, ServiceOrbit is hidden entirely (a circular infographic has no
          room to breathe at phone widths) in favour of the plain card grid,
          same as this section always rendered pre-orbit. Only one of the
          two is ever in-flow at a time, so the wrapper's height (and thus
          .connect-dot's centred position) always matches whichever is
          visible. mx-auto centres this on the true CSS viewport width
          (document.documentElement.clientWidth) — same as flowLine.ts's
          screenCenterX() now uses, after fixing that it was previously
          reading window.innerWidth (includes the scrollbar) and drifting a
          few px off from where content actually centres. */}
      <Reveal delay={140} class="connect-wrap relative mt-16">
        <div class="relative mx-auto max-w-2xl">
          <span class="connect-dot absolute left-1/2 top-1/2 h-0 w-0 -translate-x-1/2 -translate-y-1/2" aria-hidden="true"></span>

          <div class="hidden md:flex md:justify-center">
            <ServiceOrbit services={services} />
          </div>

          <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 sm:gap-10 md:hidden">
            {services.map((s) => <ServiceCard {...s} />)}
          </div>
        </div>
      </Reveal>
    </div>
  </section>

  {/* ======================== 5 · PRINCIPLES ========================
      Was "How We Work" — same StepCarousel/StepRow expand-on-hover
      mechanic and video background as before, just new content (4
      principles, not 5 steps) and icon badges instead of step numbers
      (StepCarousel.astro's badge now renders either, see that file). An
      earlier attempt replaced the whole carousel with a plain static grid
      — explicitly reverted; the interactive structure stays, only the
      content changes. Old 5-step content archived further down (search
      "ARCHIVED — ORIGINAL HOW WE WORK SECTION"), not deleted, in case it's
      wanted again — src/data/engagementPrinciples.ts reuses 4 of its 5
      photos as a placeholder pending real photos for these principles (see
      that file's own comment for the pairing rationale). id="how-we-work"/
      "how-h2" kept as-is (flowLine.ts's milestones + nav.ts's anchor still
      target them) even though the content is now Principles, same reasoning
      as the Challenge section keeping id="why-aplyd". */}
  <section id="how-we-work" aria-labelledby="how-h2" class="section-y scroll-mt-24 relative overflow-hidden">
    <div class="how-we-work__video-wrap" aria-hidden="true">
      <video class="how-we-work__video" poster="/video/posters/gradient.webp" autoplay loop muted playsinline preload="auto">
        <source src="/video/optimized/gradient.mp4" type="video/mp4" />
      </video>
      <div class="how-we-work__video-fade"></div>
    </div>
    <div class="container-x relative z-10">
      <div class="flex flex-col gap-6 md:flex-row md:items-start md:justify-between">
        <div>
          <Reveal as="h2" class="text-h2 font-bold text-white">
            <span id="how-h2">The principles behind every engagement</span>
          </Reveal>
          <Reveal as="p" delay={90} class="mt-4 max-w-[64ch] text-lede font-light text-pale-navy">
            Technology alone doesn't create lasting public value. The way programmes are
            designed, delivered and measured matters just as much. These four principles guide
            every engagement and shape how we work with governments and impact-focused institutions.
          </Reveal>
        </div>
        {/* ARCHIVED — "Learn More" button, hidden per explicit product
            decision. Commented out rather than deleted in case it's wanted
            again later, same convention as the archived Challenge/How We
            Work sections above.
        <Reveal delay={140} class="shrink-0">
          <Button href="#ai-in-action" variant="outline-light">Learn More</Button>
        </Reveal>
        */}
      </div>
    </div>

    {/* Same container-x (both-side padding + 1200px cap/centering) as the
        heading row above — not a hand-approximated left-only padding, so
        it stays pixel-aligned with the heading at every viewport width,
        including the wide-screen case where container-x's own centering
        insets it more than just var(--container-pad) alone would. */}
    <div class="container-x relative z-10 mt-10 md:mt-12">
      <StepCarousel steps={engagementPrinciples} ariaLabel="Our principles" />
    </div>
  </section>

  {/* ================ 6 · ARCHIVED — ORIGINAL CHALLENGE SECTION ================
      Hidden per explicit product decision (its content/heading/subheading
      moved to "3 · THE CHALLENGE" above, now holding the repurposed Why
      APLYD copy instead). Kept here, commented out rather than deleted, in
      case this friction-card treatment gets reused for a different section
      later. `frictions` (top of this file's frontmatter) is only consumed
      here — if this ever gets deleted for good, that data/the .friction-card
      styles below can go with it.

  <section aria-labelledby="problem-h2" class="section-y scroll-mt-24 bg-paper">
    <div class="container-x grid gap-10 lg:grid-cols-2 lg:gap-16">
      <div class="max-w-measure" data-flow-col="challenge-text">
        <Reveal><SectionEyebrow label="The Challenge" /></Reveal>
        <Reveal as="h2" delay={60} class="mt-4 text-h2 font-bold">
          <span id="problem-h2">Why today's AI efforts struggle</span>
        </Reveal>
        <Reveal as="h3" delay={100} class="mt-6 text-h3 font-bold text-mid-navy">
          Technology isn't the hardest part.
        </Reveal>
        <Reveal as="p" delay={140} class="mt-4 text-navy/90">
          Governments and development organisations are investing in AI at an unprecedented pace.
          Yet many initiatives remain pilots, struggle to scale, or fail to become part of everyday
          decision-making.
        </Reveal>
        <Reveal as="p" delay={180} class="mt-4 text-navy/90">
          The challenge is rarely the technology itself. It is building the institutional capability
          needed to adopt, govern, and sustain AI over time.
        </Reveal>
      </div>

      <div class="flex flex-col justify-center gap-6 lg:mt-2" data-flow-col="challenge-pointers">
        {frictions.map((f) => (
          <div
            data-flow-fade
            tabindex="0"
            class="friction-card group relative flex items-start gap-4 rounded-lg border border-hair bg-off-white p-5"
          >
            <span class="relative z-10 grid h-11 w-11 shrink-0 place-items-center rounded-md bg-pale-navy text-navy transition-colors duration-base ease-out group-hover:bg-white/10 group-hover:text-white group-focus:bg-white/10 group-focus:text-white">
              {f.icon === 'scale' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                  <path d="M4 20V10M12 20V4M20 20v-7" stroke-linecap="round" />
                </svg>
              )}
              {f.icon === 'clock' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                  <circle cx="12" cy="12" r="8" />
                  <path d="M12 8v4l3 2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              )}
              {f.icon === 'fragment' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                  <path d="M4 4h7v7H4zM13 13h7v7h-7z" />
                  <path d="M13 4h7v5M4 15v5h5" stroke-linecap="round" />
                </svg>
              )}
            </span>
            <div class="relative z-10 min-w-0">
              <p class="font-bold text-navy transition-colors duration-base ease-out group-hover:text-white group-focus:text-white">
                {f.label}
              </p>
              <div class="friction-card__desc-wrap grid grid-rows-[0fr] transition-[grid-template-rows] duration-base ease-out group-hover:grid-rows-[1fr] group-focus:grid-rows-[1fr]">
                <p class="min-h-0 overflow-hidden text-small leading-snug text-white/75 transition-[margin-top] duration-base ease-out mt-0 group-hover:mt-2 group-focus:mt-2">
                  {f.description}
                </p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  ================================================================= */}

  {/* ================ 5 · ARCHIVED — ORIGINAL HOW WE WORK SECTION ================
      Hidden per explicit product decision (replaced by "5 · PRINCIPLES"
      above, same id="how-we-work"/"how-h2"). Kept here, commented out
      rather than deleted, in case the step-carousel treatment gets reused
      later. `steps` (imported at the top of this file from
      src/data/steps.ts) is only consumed here — StepCarousel.astro/
      StepRow.astro and the 5 how-we-work photo assets are likewise unused
      while this stays commented out, but left in place for the same reason.

  <section id="how-we-work" aria-labelledby="how-h2" class="section-y scroll-mt-24 relative overflow-hidden">
    <div class="how-we-work__video-wrap" aria-hidden="true">
      <video class="how-we-work__video" poster="/video/posters/gradient.webp" autoplay loop muted playsinline preload="auto">
        <source src="/video/optimized/gradient.mp4" type="video/mp4" />
      </video>
      <div class="how-we-work__video-fade"></div>
    </div>
    <div class="container-x relative z-10">
      <div class="flex flex-col gap-6 md:flex-row md:items-start md:justify-between">
        <div>
          <Reveal><SectionEyebrow label="Our Approach" tone="dark" /></Reveal>
          <Reveal as="h2" delay={60} class="mt-4 text-h2 font-bold text-white">
            <span id="how-h2">How we work</span>
          </Reveal>
          <Reveal as="p" delay={90} class="mt-4 max-w-[64ch] text-lede font-light text-pale-navy">
            One continuous partnership across the full arc — from assessment and field
            delivery, through AI design and independent evaluation, to long-term scale.
          </Reveal>
        </div>
        <Reveal delay={140} class="shrink-0">
          <Button href="#ai-in-action" variant="outline-light">Explore Our Work</Button>
        </Reveal>
      </div>
    </div>

    <div class="container-x relative z-10 mt-10 md:mt-12">
      <StepCarousel steps={steps} />
    </div>
  </section>

  ================================================================= */}

  {/* ======================= 7 · AI IN ACTION ======================= */}
  {/* Ambient gold particle waveform (src/scripts/goldWaveform.ts, also used
      below in Our Foundation) — a plain sibling of .container-x, full-bleed
      via `inset:0` (see .gold-waveform in the <style> block near the bottom
      of this file), needs no alignment JS since it isn't anchored to any
      specific element the way What We Do's burst is. .container-x below
      gets `relative z-10` so the heading and case cards paint above this
      z-index:0 layer — same stacking-context requirement as every other
      full-bleed background on this page. */}
  <section id="ai-in-action" aria-labelledby="cases-h2" class="relative section-y scroll-mt-24 bg-off-white">
    <div class="gold-waveform" data-gold-waveform aria-hidden="true">
      <canvas class="gold-waveform__canvas" data-gold-waveform-canvas></canvas>
    </div>
    <div class="container-x relative z-10">
      <Reveal as="h2" class="text-h2 font-bold">
        <span id="cases-h2">AI in Action</span>
      </Reveal>
      <Reveal as="p" delay={100} class="mt-4 text-lede font-light text-mid-navy">
        Applied intelligence, already at work.
      </Reveal>
    </div>

    {/* Full-bleed (sibling of .container-x, not nested inside it — the
        "full-bleed content inside a section" convention) so the peek cards
        crop at the section's true edge, not container-x's 1200px cap. */}
    <div class="relative z-10 mt-12">
      <CaseCarousel cases={cases} />
    </div>
  </section>

  {/* ================ 8 · ARCHIVED — ORIGINAL FOUNDATION SECTION ================
      Removed and archived per explicit product decision, together with the
      timeline it contained (2010s/2021/2022/2025 row — that was archived
      first, then this request came in to take the whole section with it).
      Kept here, commented out rather than deleted, in case it's reused
      later. `positionFoundationRings()` in this file's own page script
      block below, and src/scripts/timelineTraveler.ts's call/import, are
      both left in place unused (same "left in place for the same reason"
      convention as the archived FlowChart's own still-present import) —
      both self-guard (early-return once their target elements no longer
      exist), so nothing needs to change there to un-break the page.
      flowLine.ts's own milestones/routing through this section were NOT
      left similarly inert, though — it now jogs straight from Case
      Studies' heading to Our Team instead of routing through here; restore
      that too if this section ever comes back (see this project's memory
      for exactly what changed and why). `navLinks`' "About Us" entry
      (src/data/nav.ts) still points to href="#about" — that anchor no
      longer resolves to anything now that this section is gone; flagged,
      not fixed here, since it wasn't explicitly asked for.

  8 · BACKED BY ATHENA
  Same ambient gold waveform as AI in Action (src/scripts/goldWaveform.ts)
  — `.gradient-navy` already sets `position:relative` on the section
  itself, so no extra positioning needed there. `.container-x` gets
  `relative z-10` so it paints above both this z-index:0 layer AND
  `.gradient-sheen::before`'s own z-index:1 moving highlight — that sheen
  previously painted above this section's plain in-flow content by
  default (the stacking-context gotcha in CLAUDE.md), just without a
  strong enough background to make it visually obvious.

  <section
    id="about"
    aria-labelledby="about-h2"
    class="section-y scroll-mt-24 gradient-navy gradient-sheen overflow-hidden"
  >
    <div class="gold-waveform" data-gold-waveform aria-hidden="true">
