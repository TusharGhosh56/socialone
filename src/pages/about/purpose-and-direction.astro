---
import Base from '../../layouts/Base.astro';
import SectionEyebrow from '../../components/SectionEyebrow.astro';
import Button from '../../components/Button.astro';

const sectors = [
  {
    title: 'Government',
    desc: 'Building AI into public systems, frontline decision-making and workforce capability, within real policy, data and operational constraints.',
    icon: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4',
  },
  {
    title: 'Nonprofits',
    desc: 'Connecting programme evidence, partner knowledge and workflows to strengthen strategy, programme operations and delivery.',
    icon: 'M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9',
  },
  {
    title: 'Philanthropy',
    desc: 'Using portfolio evidence and shared infrastructure to strengthen investment decisions, grantee capability and responsible adoption.',
    icon: 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  },
];
---

<Base
  title="Purpose & Direction | Mission & Vision | APLYD"
  description="Why APLYD exists and where we are headed: embedding intelligence across public institutions to enable faster, fairer and more informed decisions."
  keywords="APLYD Purpose, AI Mission, Public Sector AI Vision, Institutional AI Capability"
>
  <div class="pt-20 sm:pt-24 lg:pt-28">
    {/* ============================ HERO ============================ */}
    <section class="border-b border-hair bg-paper py-16 sm:py-24 lg:py-28 relative overflow-hidden">
      <div class="container-x relative z-10">
        <div class="mb-6 inline-flex items-center gap-2 rounded-pill bg-pale-navy/80 px-4 py-1.5 text-eyebrow font-bold uppercase tracking-[0.14em] text-navy">
          <span class="h-2 w-2 rounded-full bg-gold"></span>
          About APLYD · Purpose & Direction
        </div>

        <h1 class="max-w-4xl text-display font-light text-navy leading-[1.05] text-4xl sm:text-6xl lg:text-7xl">
          Why we exist, and where we're headed
        </h1>

        <p class="mt-8 max-w-3xl text-xl sm:text-2xl font-normal text-mid-navy leading-relaxed">
          Two statements sit behind everything we do. The first is our purpose today. The second is the future that work is building toward.
        </p>
      </div>
    </section>

    {/* ============================ SECTION 1: OUR MISSION ============================ */}
    <section class="py-20 sm:py-28 bg-white border-b border-hair">
      <div class="container-x">
        <div class="max-w-3xl mb-12">
          <SectionEyebrow label="Our Purpose Today" />
          <h2 class="mt-3 text-3xl sm:text-4xl lg:text-5xl font-black text-navy leading-tight">
            Our mission
          </h2>
        </div>

        {/* Mission Statement Block */}
        <div class="rounded-3xl border border-hair bg-paper/60 p-8 sm:p-12 lg:p-16 mb-16 relative overflow-hidden shadow-sm">
          <div class="border-l-4 border-gold pl-6 sm:pl-10">
            <blockquote class="text-2xl sm:text-3xl lg:text-4xl font-light text-navy leading-snug">
              “To help institutions build the systems, capabilities, and intelligence to make better decisions at scale.”
            </blockquote>
            <p class="mt-8 text-lg sm:text-xl text-mid-navy leading-relaxed max-w-4xl">
              The challenge in public-sector AI is not only developing the technology. It is creating the conditions for institutions to adopt, operate and improve it. We work across that journey, from identifying the decisions and services where AI can add value, to understanding delivery realities, building systems that fit institutional workflows, and measuring what changes in practice.
            </p>
          </div>
        </div>

        {/* 3 Sector Focus Cards */}
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {sectors.map((sector) => (
            <div class="group rounded-3xl border border-hair bg-white p-8 sm:p-10 shadow-sm flex flex-col justify-between hover:border-smoke hover:shadow-lg transition-all duration-base">
              <div>
                <div class="h-12 w-12 rounded-2xl bg-pale-navy text-navy flex items-center justify-center mb-6 group-hover:bg-navy group-hover:text-white transition-colors">
                  <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d={sector.icon} />
                  </svg>
                </div>
                <h3 class="text-2xl font-bold text-navy mb-4">
                  {sector.title}
                </h3>
                <p class="text-base sm:text-lg text-mid-navy leading-relaxed">
                  {sector.desc}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ============================ SECTION 2: OUR VISION ============================ */}
    <section class="py-20 sm:py-28 bg-white border-b border-hair">
      <div class="container-x">
        <div class="gradient-navy gradient-sheen rounded-3xl p-10 sm:p-16 lg:p-20 text-white relative overflow-hidden shadow-2xl">
          <div class="relative z-10 max-w-4xl">
            <div class="inline-flex items-center gap-2 rounded-pill bg-white/10 px-4 py-1.5 text-eyebrow font-bold uppercase tracking-[0.14em] text-gold mb-8 backdrop-blur-sm">
              <span class="h-2 w-2 rounded-full bg-gold"></span>
              The Future We Are Building
            </div>
            
            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight mb-8 !text-white">
              Our vision
            </h2>

            <div class="border-l-4 border-gold pl-6 sm:pl-10 mb-10">
              <p class="text-2xl sm:text-3xl lg:text-4xl font-light text-white leading-snug">
                Intelligence embedded across public institutions, enabling faster, fairer, and more informed decisions.
              </p>
            </div>

            <div class="space-y-6 text-lg sm:text-xl font-light text-white/90 leading-relaxed max-w-3xl">
              <p>
                The measure of progress is not the number of pilots launched, but whether systems can be adopted, sustained and improved within the institutions they are designed to serve. That means building for continuity across changes in staff, resources and operating conditions, with the governance and evidence required to support long-term use.
              </p>
              <p class="pt-4 border-t border-white/10 font-normal text-white">
                A system that depends indefinitely on an external vendor does not create durable institutional capability. We build toward institutions that can operate, govern and improve their own AI systems, with ownership and capability developed from the outset.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* ============================ NEXT SECTION CTA ============================ */}
    <section class="py-16 sm:py-24 bg-paper">
      <div class="container-x">
        <div class="rounded-3xl border border-hair bg-white p-8 sm:p-12 shadow-sm flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
          <div>
            <div class="text-xs uppercase font-bold tracking-widest text-gold mb-2">Methodology</div>
            <h3 class="text-2xl sm:text-3xl font-bold text-navy">
              See how we move from vision to operational reality.
            </h3>
          </div>
          <Button href="/services/our-approach" variant="primary" class="whitespace-nowrap">
            See our approach &rarr;
          </Button>
        </div>
      </div>
    </section>
  </div>
</Base>
