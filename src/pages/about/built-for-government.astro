---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import AtmosphericCanvas from '../../components/AtmosphericCanvas.astro';
import GoldWaveform from '../../components/GoldWaveform.astro';
import GradientVideo from '../../components/GradientVideo.astro';
import HeroVideo from '../../components/HeroVideo.astro';
import pillar1Img from '../../assets/images/how-we-work/card_01-web.jpg';
import pillar2Img from '../../assets/images/how-we-work/card_02-web.jpg';
---

<Base
  title="Built for Government | Applied AI for Public Systems | APLYD"
  description="APLYD applies AI within real policy, data and operating constraints, moving government work from pilot to public service that institutions can run and own."
  keywords="Built for Government, Sovereign AI, Public Sector AI, Institutional AI, Government Digital Transformation, Civic Tech, AI Sovereignty, Workflow Integration, Public Trust AI"
>
  <div class="w-full">
    {/* ============================ HERO ============================ */}
    <section class="hero-internal-section bg-navy text-white pt-28 sm:pt-36 lg:pt-40 pb-16 sm:pb-24 lg:pb-28 min-h-screen min-h-[100dvh] flex flex-col justify-center relative overflow-hidden">
      {/* Thematic Cinematic Stock Video Background */}
      <HeroVideo
        src="/video/subpage-hero/Built for Government.mp4"
        overlayOpacity={0.65}
      />

      <div class="container-x relative z-10 space-y-4 sm:space-y-6">
        <h1 class="max-w-4xl text-display font-light text-white leading-[1.08] text-3xl sm:text-5xl lg:text-6xl tracking-tight">
          Built for government, and the institutions that serve at scale
        </h1>

        <p class="max-w-3xl text-base sm:text-xl lg:text-2xl font-light text-pale-navy/95 leading-relaxed">
          APLYD is the applied AI venture of Athena Infonomics. We work with institutions that operate at scale, including governments, funders, multilaterals and impact-focused organisations. Our work focuses on the point where AI moves from a pilot or prototype into a system that can be implemented, operated and improved within an institution.
        </p>
      </div>
    </section>

    {/* ============================ RICH ATMOSPHERIC CANVAS ============================ */}
    <AtmosphericCanvas>
      {/* ============================ SECTION 1: WHY AI STALLS ============================ */}
      <section class="relative z-10 py-10 sm:py-16" id="operational-reality">
        <div class="container-x space-y-6 sm:space-y-8">
          <div class="rounded-2xl sm:rounded-3xl border border-hair bg-white/95 backdrop-blur-md p-6 sm:p-10 lg:p-14 shadow-sm space-y-4 sm:space-y-6 max-w-4xl">
            <h2 class="text-2xl sm:text-3xl lg:text-4xl font-light tracking-tight text-navy leading-tight">
              Why AI stalls inside institutions
            </h2>
            <p class="text-base sm:text-lg lg:text-xl text-mid-navy leading-relaxed font-normal">
              AI initiatives often encounter challenges beyond the model itself. Data may not adequately reflect the people a service is intended to reach. Systems may not fit established workflows. Implementation knowledge may remain with external providers, and without appropriate measurement, institutions may have limited evidence on whether a system is delivering its intended outcomes.
            </p>
          </div>
        </div>
      </section>

      {/* ============================ SECTION 2: WHAT BUILT FOR GOVERNMENT MEANS ============================ */}
      <section class="relative z-10 py-10 sm:py-16" id="architectural-requirements">
        <div class="container-x space-y-8 sm:space-y-12">
          
          <div class="max-w-4xl space-y-4 sm:space-y-6">
            <h2 class="text-2xl sm:text-3xl lg:text-4xl font-light tracking-tight text-navy leading-tight" id="arch-h2">
              What "built for government" means
            </h2>
            <div class="space-y-4 text-base sm:text-lg lg:text-xl text-mid-navy leading-relaxed font-normal" id="arch-desc">
              <p>
                We start with the decision, service or workflow that needs to improve and assess where AI can create meaningful value within existing policy, data and operating constraints. Governance, security, interoperability and decision rights are considered as part of system design and implementation.
              </p>
              <p>
                We also build institutional capability alongside the technology, so teams have the ownership, training, documentation and operating processes required to manage and improve systems over time.
              </p>
            </div>
          </div>

          {/* Clean Dual Visual Pillars */}
          <div class="relative grid grid-cols-1 lg:grid-cols-2 gap-6 sm:gap-8 pillar-grid" id="dual-pillars">
            <div class="pillar-card pillar-card-1 relative rounded-2xl sm:rounded-3xl border border-hair bg-white/95 backdrop-blur-md p-6 sm:p-8 lg:p-10 space-y-5 sm:space-y-6 shadow-sm flex flex-col justify-between group transition-all duration-500 hover:shadow-lg" data-pillar="1">
              <div class="space-y-4 sm:space-y-5 relative z-10">
                <div class="relative w-full h-44 sm:h-52 lg:h-56 rounded-2xl overflow-hidden border border-hair/90 shadow-sm bg-navy/5 group/img">
                  <Image
                    src={pillar1Img}
                    alt="Built for Government implementation"
                    class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                    widths={[360, 600, 720]}
                    sizes="(min-width: 1024px) 50vw, 100vw"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-navy/60 via-navy/10 to-transparent pointer-events-none"></div>
                </div>
                <p class="text-sm sm:text-base lg:text-lg text-mid-navy leading-relaxed font-normal">
                  We start with the decision, service or workflow that needs to improve and assess where AI can create meaningful value within existing policy, data and operating constraints. Governance, security, interoperability and decision rights are considered as part of system design and implementation.
                </p>
              </div>
            </div>

            <div class="pillar-card pillar-card-2 relative rounded-2xl sm:rounded-3xl border border-hair bg-white/95 backdrop-blur-md p-6 sm:p-8 lg:p-10 space-y-5 sm:space-y-6 shadow-sm flex flex-col justify-between group transition-all duration-500 hover:shadow-lg" data-pillar="2">
              <div class="space-y-4 sm:space-y-5 relative z-10">
                <div class="relative w-full h-44 sm:h-52 lg:h-56 rounded-2xl overflow-hidden border border-hair/90 shadow-sm bg-navy/5 group/img">
                  <Image
                    src={pillar2Img}
                    alt="Institutional capability and system ownership"
                    class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                    widths={[360, 600, 720]}
                    sizes="(min-width: 1024px) 50vw, 100vw"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-navy/60 via-navy/10 to-transparent pointer-events-none"></div>
                </div>
                <p class="text-sm sm:text-base lg:text-lg text-mid-navy leading-relaxed font-normal">
                  We also build institutional capability alongside the technology, so teams have the ownership, training, documentation and operating processes required to manage and improve systems over time.
                </p>
              </div>
            </div>
          </div>

        </div>
      </section>

      {/* ============================ SECTION 3: BEYOND GOVERNMENT ============================ */}
      <section class="relative z-10 py-8 sm:py-12">
        <div class="container-x">
          <div class="rounded-2xl sm:rounded-3xl gradient-navy-mesh gradient-sheen p-6 sm:p-10 lg:p-14 text-white relative overflow-hidden shadow-xl">
            <GradientVideo variant="gold" overlayOpacity={0.6} />
            <GoldWaveform alpha="1.2" />

            <div class="relative z-10 max-w-4xl space-y-4 sm:space-y-6">
              <h2 class="text-2xl sm:text-3xl lg:text-4xl font-light tracking-tight text-white leading-tight">
                Beyond government
              </h2>
              <p class="text-base sm:text-xl lg:text-2xl font-light text-pale-navy/95 leading-relaxed">
                The same approach applies to other institutions working at scale, including nonprofits and funders. Across these contexts, our work is guided by a common standard: AI that is responsible, measurable and institutionally owned.
              </p>
            </div>
          </div>
        </div>
      </section>

      {/* ============================ CTA ============================ */}
      <section class="relative z-10 py-8 sm:py-14">
        <div class="container-x">
          <div class="rounded-2xl sm:rounded-3xl border border-hair bg-white/95 backdrop-blur-md p-6 sm:p-10 lg:p-14 shadow-sm flex flex-col md:flex-row items-start md:items-center justify-between gap-6 sm:gap-8 card-interactive-sheen final-cta-card">
            <div class="max-w-2xl relative z-10">
              <div class="text-xs uppercase font-bold tracking-widest text-gold mb-2">How We Work</div>
              <h3 class="text-2xl sm:text-3xl font-light text-navy mb-3">
                See how we work
              </h3>
              <p class="text-base text-mid-navy leading-relaxed font-normal">
                Explore the four principles guiding every APLYD engagement.
              </p>
            </div>
            <div class="relative z-10 w-full sm:w-auto">
              <Button href="/about/how-we-work" variant="primary" class="w-full sm:w-auto text-center justify-center shadow-sm">
                See how we work &rarr;
              </Button>
            </div>
          </div>
        </div>
      </section>
    </AtmosphericCanvas>
  </div>
</Base>
