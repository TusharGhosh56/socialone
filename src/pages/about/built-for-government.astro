---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import AtmosphericCanvas from '../../components/AtmosphericCanvas.astro';
import GoldWaveform from '../../components/GoldWaveform.astro';
import GradientVideo from '../../components/GradientVideo.astro';
import HeroVideo from '../../components/HeroVideo.astro';

import imgGov from '../../assets/images/capabilities/work-governance.jpg';
import imgTech from '../../assets/images/capabilities/insight-ai.jpg';
import imgStalls from '../../assets/images/built-for-gov/ai-stalls.png';
---

<Base
  title="Built for Government | Applied AI for Public Systems | APLYD"
  description="APLYD applies AI within real policy, data and operating constraints, moving government work from pilot to public service that institutions can run and own."
  keywords="Built for Government, Sovereign AI, Public Sector AI, Institutional AI, Government Digital Transformation, Civic Tech, AI Sovereignty, Workflow Integration, Public Trust AI"
>
  <div class="w-full">
    {/* ============================ HERO ============================ */}
    <section class="hero-internal-section bg-navy text-white pt-28 sm:pt-36 lg:pt-40 pb-16 sm:pb-24 lg:pb-28 min-h-screen min-h-[100dvh] flex flex-col justify-center relative overflow-hidden">
      <HeroVideo
        src="/video/subpage-hero/Built for Government.mp4"
        overlayOpacity={0.65}
      />

      <div class="container-x relative z-10 space-y-4 sm:space-y-6">
        <h1 class="max-w-4xl text-display font-light text-white leading-[1.08] text-3xl sm:text-5xl lg:text-6xl tracking-tight">
          Built for government, and the institutions that serve at scale
        </h1>

        <p class="max-w-4xl lg:max-w-5xl text-base sm:text-xl lg:text-2xl font-light text-pale-navy/95 leading-relaxed text-pretty">
          APLYD is the applied AI venture of Athena Infonomics. We work with institutions that operate at scale, including governments, funders, multilaterals and impact-focused organisations. Our work focuses on the point where AI moves from a pilot or prototype into a system that can be implemented, operated and improved within an institution.
        </p>
      </div>
    </section>

    {/* ============================ ATMOSPHERIC CANVAS ============================ */}
    <AtmosphericCanvas>
      {/* ============================ 60/40 STICKY SHOWCASE: WHY AI STALLS -> WHAT BUILT FOR GOV MEANS ============================ */}
      
      {/* Mobile Presentation (<1024px): Clean Stacked Sections */}
      <div class="block lg:hidden space-y-12 py-8">
        {/* Mobile Act 1 */}
        <div class="container-x space-y-6">
          <h2 class="text-2xl sm:text-3xl font-light tracking-tight text-navy leading-tight" id="stalls-heading-mobile">
            Why AI stalls inside institutions
          </h2>
          <p class="text-base sm:text-lg text-mid-navy leading-relaxed font-normal">
            AI initiatives often encounter challenges beyond the model itself. Data may not adequately reflect the people a service is intended to reach. Systems may not fit established workflows. Implementation knowledge may remain with external providers, and without appropriate measurement, institutions may have limited evidence on whether a system is delivering its intended outcomes.
          </p>
          <div class="aspect-[16/10] w-full rounded-2xl border border-hair overflow-hidden shadow-sm bg-navy/5">
            <Image
              src={imgStalls}
              alt="Institutional challenges in public systems"
              class="w-full h-full object-cover"
              widths={[400, 700]}
              sizes="100vw"
            />
          </div>
        </div>

        {/* Mobile Act 2 */}
        <div class="container-x space-y-6">
          <h2 class="text-2xl sm:text-3xl font-light tracking-tight text-navy leading-tight" id="arch-h2-mobile">
            What "built for government" means
          </h2>
          <div class="space-y-4">
            <p class="text-base sm:text-lg text-mid-navy leading-relaxed font-normal">
              We start with the decision, service or workflow that needs to improve and assess where AI can create meaningful value within existing policy, data and operating constraints. Governance, security, interoperability and decision rights are considered as part of system design and implementation.
            </p>
            <p class="text-base sm:text-lg text-mid-navy leading-relaxed font-normal">
              We also build institutional capability alongside the technology, so teams have the ownership, training, documentation and operating processes required to manage and improve systems over time.
            </p>
          </div>
          <div class="aspect-[16/10] w-full rounded-2xl border border-hair overflow-hidden shadow-sm bg-navy/5">
            <Image
              src={imgGov}
              alt="System design and policy alignment"
              class="w-full h-full object-cover object-right"
              style="object-position: right center;"
              widths={[400, 700]}
              sizes="100vw"
            />
          </div>
        </div>
      </div>

      {/* Desktop Presentation (>=1024px): 60/40 Pinned Sticky Chapter Flow */}
      <section id="bfg-sticky-showcase" class="hidden lg:block relative z-10 h-[220vh] w-full">
        <div class="sticky top-0 h-screen w-full flex items-stretch overflow-hidden">
          
          {/* Left 60%: Text Stage */}
          <div class="w-[60%] h-full flex flex-col justify-center pl-16 sm:pl-20 lg:pl-28 xl:pl-36 pr-8 sm:pr-12 lg:pr-16 xl:pr-24 relative z-10">
            <div class="max-w-2xl relative min-h-[380px] flex items-center">
              {/* Act 1 Text */}
              <div id="bfg-text-act-1" class="transition-all duration-700 ease-out space-y-6">
                <h2 class="text-4xl xl:text-5xl font-light tracking-tight text-navy leading-tight" id="stalls-heading">
                  Why AI stalls inside institutions
                </h2>
                <p class="text-lg xl:text-xl text-mid-navy leading-relaxed font-normal text-pretty">
                  AI initiatives often encounter challenges beyond the model itself. Data may not adequately reflect the people a service is intended to reach. Systems may not fit established workflows. Implementation knowledge may remain with external providers, and without appropriate measurement, institutions may have limited evidence on whether a system is delivering its intended outcomes.
                </p>
              </div>

              {/* Act 2 Text (Cross-fades in from left) */}
              <div id="bfg-text-act-2" class="absolute inset-0 transition-all duration-700 ease-out space-y-6 flex flex-col justify-center opacity-0 pointer-events-none -translate-x-8">
                <h2 class="text-4xl xl:text-5xl font-light tracking-tight text-navy leading-tight" id="arch-h2">
                  What "built for government" means
                </h2>
                <div class="space-y-4">
                  <p class="text-lg xl:text-xl text-mid-navy leading-relaxed font-normal text-pretty">
                    We start with the decision, service or workflow that needs to improve and assess where AI can create meaningful value within existing policy, data and operating constraints. Governance, security, interoperability and decision rights are considered as part of system design and implementation.
                  </p>
                  <p class="text-lg xl:text-xl text-mid-navy leading-relaxed font-normal text-pretty">
                    We also build institutional capability alongside the technology, so teams have the ownership, training, documentation and operating processes required to manage and improve systems over time.
                  </p>
                </div>
              </div>
            </div>
          </div>

          {/* Right 40%: Seamless Integrated Visual Stage */}
          <div class="w-[40%] h-full relative overflow-hidden flex items-center justify-end">
            {/* Nested Vertical & Horizontal Feathering Masks (100% cross-browser) */}
            <div class="relative w-full h-full [mask-image:linear-gradient(to_bottom,transparent_0%,black_14%,black_86%,transparent_100%)] [-webkit-mask-image:linear-gradient(to_bottom,transparent_0%,black_14%,black_86%,transparent_100%)]">
              <div class="relative w-full h-full [mask-image:linear-gradient(to_right,transparent_0%,black_12%,black_100%)] [-webkit-mask-image:linear-gradient(to_right,transparent_0%,black_12%,black_100%)]">
                
                {/* Image 1 */}
                <div id="bfg-img-act-1" class="absolute inset-0 w-full h-full transition-all duration-700 ease-out">
                  <Image
                    src={imgStalls}
                    alt="Institutional challenges in public systems"
                    class="w-full h-full object-cover"
                    widths={[800, 1200, 1600]}
                    sizes="40vw"
                  />
                </div>

                {/* Image 2 (Cross-fades in from right) */}
                <div id="bfg-img-act-2" class="absolute inset-0 w-full h-full transition-all duration-700 ease-out opacity-0 pointer-events-none translate-x-8">
                  <Image
                    src={imgGov}
                    alt="System design and policy alignment"
                    class="w-full h-full object-cover object-right"
                    style="object-position: right center;"
                    widths={[800, 1200, 1600]}
                    sizes="40vw"
                  />
                </div>

              </div>
            </div>
          </div>

        </div>
      </section>

      {/* ============================ SECTION 3: BEYOND GOVERNMENT ============================ */}
      <section class="relative z-10 py-8 sm:py-12" id="beyond-gov-monument">
        <div class="container-x">
          <div class="rounded-3xl gradient-navy-mesh gradient-sheen p-8 sm:p-12 lg:p-16 text-white relative overflow-hidden shadow-xl">
            <GradientVideo variant="gold" overlayOpacity={0.6} />
            <GoldWaveform alpha="1.2" />

            <div class="relative z-10 max-w-4xl space-y-4 sm:space-y-6">
              <h2 class="text-2xl sm:text-4xl lg:text-5xl font-light tracking-tight text-white leading-tight" id="beyond-h2">
                Beyond government
              </h2>
              <p class="text-base sm:text-xl lg:text-2xl font-light text-pale-navy/95 leading-relaxed">
                The same approach applies to other institutions working at scale, including nonprofits and funders. Across these contexts, our work is guided by a common standard: AI that is responsible, measurable and institutionally owned.
              </p>
            </div>
          </div>
        </div>
      </section>

      {/* ============================ CTA ============================ */}
      <section class="relative z-10 py-8 sm:py-12">
        <div class="container-x">
          <div class="rounded-2xl sm:rounded-3xl border border-hair bg-white/95 backdrop-blur-md p-6 sm:p-10 lg:p-14 shadow-md flex flex-col md:flex-row items-start md:items-center justify-between gap-6 sm:gap-8 card-interactive-sheen final-cta-card">
            <div class="max-w-2xl relative z-10">
              <h3 class="text-2xl sm:text-3xl font-light text-navy mb-3">
                See how we work
              </h3>
              <p class="text-base text-mid-navy leading-relaxed font-normal">
                Explore the four principles guiding every APLYD engagement.
              </p>
            </div>
            <div class="relative z-10 w-full sm:w-auto">
              <Button href="/about/how-we-work" variant="primary" class="w-full sm:w-auto text-center justify-center shadow-sm">
                See how we work &rarr;
              </Button>
            </div>
          </div>
        </div>
      </section>
    </AtmosphericCanvas>
  </div>

  <script>
    function initBfgShowcase() {
      const outer = document.getElementById('bfg-sticky-showcase');
      const text1 = document.getElementById('bfg-text-act-1');
      const text2 = document.getElementById('bfg-text-act-2');
      const img1 = document.getElementById('bfg-img-act-1');
      const img2 = document.getElementById('bfg-img-act-2');

      if (!outer || !text1 || !text2 || !img1 || !img2) return;

      let ticking = false;

      function update() {
        if (window.innerWidth < 1024) return;

        const rect = outer!.getBoundingClientRect();
        const scrollHeight = outer!.offsetHeight - window.innerHeight;
        if (scrollHeight <= 0) return;

        const progress = Math.max(0, Math.min(1, -rect.top / scrollHeight));
        const isAct2 = progress >= 0.42;

        if (isAct2) {
          // Act 1 exits: text slides left & fades, image slides right & fades
          text1!.style.opacity = '0';
          text1!.style.transform = 'translate3d(-32px, 0, 0)';
          text1!.style.pointerEvents = 'none';

          img1!.style.opacity = '0';
          img1!.style.transform = 'translate3d(32px, 0, 0)';
          img1!.style.pointerEvents = 'none';

          // Act 2 enters
          text2!.style.opacity = '1';
          text2!.style.transform = 'translate3d(0, 0, 0)';
          text2!.style.pointerEvents = 'auto';

          img2!.style.opacity = '1';
          img2!.style.transform = 'translate3d(0, 0, 0)';
          img2!.style.pointerEvents = 'auto';
        } else {
          // Act 1 enters
          text1!.style.opacity = '1';
          text1!.style.transform = 'translate3d(0, 0, 0)';
          text1!.style.pointerEvents = 'auto';

          img1!.style.opacity = '1';
          img1!.style.transform = 'translate3d(0, 0, 0)';
          img1!.style.pointerEvents = 'auto';

          // Act 2 exits
          text2!.style.opacity = '0';
          text2!.style.transform = 'translate3d(-32px, 0, 0)';
          text2!.style.pointerEvents = 'none';

          img2!.style.opacity = '0';
          img2!.style.transform = 'translate3d(32px, 0, 0)';
          img2!.style.pointerEvents = 'none';
        }
        ticking = false;
      }

      function onScroll() {
        if (!ticking) {
          requestAnimationFrame(update);
          ticking = true;
        }
      }

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      update();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initBfgShowcase);
    } else {
      initBfgShowcase();
    }
    document.addEventListener('astro:page-load', initBfgShowcase);
  </script>
</Base>
