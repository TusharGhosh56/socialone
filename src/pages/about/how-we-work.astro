---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import AtmosphericCanvas from '../../components/AtmosphericCanvas.astro';
import HeroVideo from '../../components/HeroVideo.astro';
import img01 from '../../assets/images/how-we-work/card_01-web.jpg';
import img02 from '../../assets/images/how-we-work/card_02-web.jpg';
import img03 from '../../assets/images/how-we-work/card_03-web.jpg';
import img04 from '../../assets/images/how-we-work/card_04-web.jpg';

const principles = [
  {
    phase: 'Inside the Institution',
    title: 'We work inside the institution',
    image: img01,
    alt: 'Working alongside institutional implementation teams',
    paragraphs: [
      'We work alongside the teams responsible for implementation, aligning with delivery objectives and staying engaged through deployment and beyond. This helps ensure that the system reflects existing workflows, operational requirements and the realities of the institution in which it will be used.',
      'Effective implementation depends on this context. Solutions designed without an understanding of how work is actually carried out can struggle with adoption. Working within the institution allows those constraints to inform design from the outset.',
    ],
  },
  {
    phase: 'Sovereign Handover',
    title: 'We hand the system over',
    image: img02,
    alt: 'Capability transfer and workforce training',
    paragraphs: [
      'Capability transfer is built into every engagement. We leave trained teams, documentation and operating routines that enable the institution to manage the system after implementation.',
      'From the outset, we consider who will operate the system, how it will be supported and maintained, and what capabilities are required to manage it effectively. The objective is durable institutional ownership, not continued dependence on an external provider.',
    ],
  },
  {
    phase: 'Evidence-Driven',
    title: 'We decide from evidence',
    image: img03,
    alt: 'Evidence-driven decision making and measurement',
    paragraphs: [
      'Evidence informs decisions throughout the engagement, from selecting and prioritising use cases to assessing readiness for scale. We combine field data, user experience and measurement to understand how a system performs in practice and what it changes for the people and services it is intended to support.',
      'This includes looking beyond aggregate performance to identify gaps in coverage, adoption and outcomes. Decisions to improve, continue or scale are based on evidence from implementation rather than demonstration alone.',
    ],
  },
  {
    phase: 'Independent Assurance',
    title: 'We evaluate independently',
    image: img04,
    alt: 'Independent algorithmic evaluation and auditing',
    paragraphs: [
      'We only evaluate systems that no one in our group built, and we do not bid to build systems that we have evaluated. Evaluation is kept structurally separate from delivery.',
    ],
    h3Title: 'Independent by Design',
    subParagraphs: [
      'Evaluation is most useful when its findings are not shaped by an interest in a particular outcome. Keeping assurance separate from delivery allows institutions to assess system performance, safety, fairness and impact with greater independence.',
      'This approach also enables us to evaluate systems developed by other providers without creating a conflict between evaluation and implementation. The principle applies equally to our own work: systems we build are not evaluated by us.',
    ],
  },
];
---

<Base
  title="How We Work | Four Principles | APLYD"
  description="Four principles behind every APLYD engagement, and why each one matters when AI has to work inside a real public institution."
  keywords="APLYD Principles, AI Delivery Methodology, Embedded AI Practice, Independent AI Evaluation, Sovereign AI Handover, Institutional Capability Building, Algorithmic Assurance, Public Sector AI Implementation"
>
  <div class="w-full">
    {/* ============================ HERO ============================ */}
    <section class="hero-internal-section bg-navy text-white pt-28 sm:pt-36 lg:pt-40 pb-16 sm:pb-24 lg:pb-28 min-h-screen min-h-[100dvh] flex flex-col justify-center relative overflow-hidden">
      {/* Thematic Cinematic Stock Video Background */}
      <HeroVideo
        src="/video/subpage-hero/how we work.mp4"
        overlayOpacity={0.62}
      />

      <div class="container-x relative z-10 space-y-5 sm:space-y-6">
        <div class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-3.5 py-1 text-xs font-bold uppercase tracking-widest text-gold backdrop-blur-sm">
          <span class="h-1.5 w-1.5 rounded-full bg-gold"></span>
          <span>APLYD Principles · Delivery Methodology</span>
        </div>

        <h1 class="max-w-4xl text-display font-light text-white leading-[1.08] text-3xl sm:text-5xl lg:text-6xl tracking-tight">
          Four principles behind every engagement
        </h1>

        <p class="max-w-3xl text-base sm:text-xl lg:text-2xl font-light text-pale-navy/95 leading-relaxed">
          Technology alone does not create lasting public value. Whether an AI system delivers and endures depends on how it is designed, implemented and measured within the realities of an institution. Four principles guide our work, each addressing a common challenge in taking AI from a pilot to sustained institutional use.
        </p>
      </div>
    </section>

    {/* ============================ RICH ATMOSPHERIC CANVAS ============================ */}
    <AtmosphericCanvas>
      {/* ============================ 4 PRINCIPLES CHAPTERS ============================ */}
      <section class="relative z-10 py-10 sm:py-16">
        <div class="container-x space-y-10 sm:space-y-14 lg:space-y-16">
          {principles.map((p, idx) => {
            const isEven = idx % 2 === 0;
            return (
              <article
                id={`principle-row-${idx}`}
                class="rounded-2xl sm:rounded-3xl border border-hair bg-white/95 backdrop-blur-md overflow-hidden shadow-md grid grid-cols-1 lg:grid-cols-12 gap-0 items-stretch group transition-all duration-500 hover:shadow-xl"
              >
                {/* Narrative Column */}
                <div class={`p-6 sm:p-10 lg:p-14 lg:col-span-7 flex flex-col justify-center space-y-4 sm:space-y-6 ${!isEven ? 'order-1 lg:order-2' : ''}`}>
                  <div class="inline-flex items-center gap-2 rounded-full border border-hair bg-pale-navy/90 px-3.5 py-1 text-xs font-bold uppercase tracking-widest text-navy w-fit">
                    <span class="h-1.5 w-1.5 rounded-full bg-gold"></span>
                    <span>Principle · {p.phase}</span>
                  </div>

                  <h2 class="text-2xl sm:text-3xl lg:text-4xl font-light leading-tight tracking-tight text-navy">
                    {p.title}
                  </h2>

                  <div class="space-y-3.5 sm:space-y-4 text-base sm:text-lg lg:text-xl leading-relaxed font-normal text-mid-navy">
                    {p.paragraphs.map((para) => (
                      <p>{para}</p>
                    ))}
                  </div>

                  {p.h3Title && (
                    <div class="pt-4 sm:pt-6 border-t border-hair/80 space-y-3">
                      <h3 class="text-xl sm:text-2xl font-light text-navy leading-snug">
                        {p.h3Title}
                      </h3>
                      <div class="space-y-3 text-base sm:text-lg leading-relaxed font-normal text-mid-navy">
                        {p.subParagraphs?.map((sp) => (
                          <p>{sp}</p>
                        ))}
                      </div>
                    </div>
                  )}
                </div>

                {/* Edge-to-Edge Media Column */}
                <div class={`lg:col-span-5 relative min-h-[260px] sm:min-h-[340px] lg:min-h-full overflow-hidden bg-navy/5 ${!isEven ? 'order-2 lg:order-1' : ''}`}>
                  <Image
                    src={p.image}
                    alt={p.alt}
                    class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                    widths={[400, 700, 900]}
                    sizes="(min-width: 1024px) 42vw, 100vw"
                  />
                  <div class={`absolute inset-0 bg-gradient-to-t ${isEven ? 'lg:bg-gradient-to-l' : 'lg:bg-gradient-to-r'} from-navy/30 via-transparent to-transparent pointer-events-none`}></div>
                </div>

              </article>
            );
          })}
        </div>
      </section>

      {/* ============================ CTA ============================ */}
      <section class="relative z-10 py-8 sm:py-14">
        <div class="container-x">
          <div class="rounded-2xl sm:rounded-3xl border border-hair bg-white/95 backdrop-blur-md p-6 sm:p-10 lg:p-14 shadow-md flex flex-col md:flex-row items-start md:items-center justify-between gap-6 sm:gap-8 card-interactive-sheen final-cta-card">
            <div class="max-w-2xl relative z-10">
              <div class="text-xs uppercase font-bold tracking-widest text-gold mb-2">Explore Capabilities</div>
              <h3 class="text-2xl sm:text-3xl font-light text-navy mb-3">
                Explore our capabilities
              </h3>
              <p class="text-base text-mid-navy leading-relaxed font-normal">
                Discover our applied AI capabilities across government, nonprofits, and global philanthropy.
              </p>
            </div>
            <div class="relative z-10 w-full sm:w-auto">
              <Button href="/services/our-capabilities/government" variant="primary" class="w-full sm:w-auto text-center justify-center shadow-sm">
                Explore our capabilities &rarr;
              </Button>
            </div>
          </div>
        </div>
      </section>
    </AtmosphericCanvas>
  </div>
</Base>
