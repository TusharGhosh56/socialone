---
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import InteractiveFootprint from '../../components/InteractiveFootprint.astro';
import AtmosphericCanvas from '../../components/AtmosphericCanvas.astro';
import GoldWaveform from '../../components/GoldWaveform.astro';
import GradientVideo from '../../components/GradientVideo.astro';
import HeroVideo from '../../components/HeroVideo.astro';
import BedrockCurvedShowcase from '../../components/BedrockCurvedShowcase.astro';
---

<Base
  title="16 Years of Proof | APLYD by Athena Infonomics"
  description="APLYD is built on sixteen years of Athena Infonomics work in research, measurement, digital systems and last-mile data across governments and funders."
  keywords="Athena Infonomics, APLYD Heritage, Global Public Sector Experience, Evidence-Driven AI"
>
  <div class="w-full">
    {/* ============================ HERO ============================ */}
    <section class="hero-internal-section bg-navy text-white pt-28 sm:pt-36 lg:pt-40 pb-16 sm:pb-24 lg:pb-28 min-h-screen min-h-[100dvh] flex flex-col justify-center relative overflow-hidden">
      {/* Thematic Cinematic Stock Video Background */}
      <HeroVideo
        src="/video/trust.mp4"
        overlayOpacity={0.62}
      />

      <div class="container-x relative z-10 space-y-4 sm:space-y-6">
        <h1 class="max-w-4xl text-display font-light text-white leading-[1.08] text-3xl sm:text-5xl lg:text-6xl tracking-tight">
          Sixteen years of delivery behind a new kind of AI practice
        </h1>

        <p class="max-w-4xl lg:max-w-5xl text-base sm:text-xl lg:text-2xl font-light text-pale-navy/95 leading-relaxed text-pretty">
          APLYD builds on sixteen years of Athena Infonomics’ work across governments, funders and public institutions, with a focus on evidence, measurement and implementation. That experience provides the institutional and sector context needed to apply AI within real public systems, where data, workflows, governance and delivery conditions matter as much as the technology.
        </p>
      </div>
    </section>

    {/* ============================ RICH ATMOSPHERIC CANVAS ============================ */}
    <AtmosphericCanvas>
      {/* ============================ SECTION 1: THE BEDROCK (CURVED DUAL ARC SHOWCASE) ============================ */}
      <section class="relative z-10 pt-12 sm:pt-20 pb-8 sm:pb-14" id="bedrock-section">
        <div class="container-x space-y-6 sm:space-y-8 mb-8 sm:mb-12">
          <div class="max-w-4xl space-y-3 sm:space-y-4">
            <h2 class="text-2xl sm:text-4xl lg:text-5xl font-light text-navy leading-tight" id="bedrock-heading">
              The bedrock
            </h2>
            <p class="text-base sm:text-lg lg:text-xl text-mid-navy leading-relaxed font-normal">
              Athena Infonomics has built its work around four complementary capabilities. Together, they provide the sector knowledge, evidence infrastructure and delivery experience that underpin APLYD’s approach to applied AI.
            </p>
          </div>
        </div>

        {/* Interactive Dual Semi-Circle Scroll Trajectory Showcase */}
        <BedrockCurvedShowcase />
      </section>

      {/* ============================ SECTION 2: WHAT APLYD ADDS (DEEP MONUMENT) ============================ */}
      <section class="relative z-10 py-8 sm:py-14" id="aplyd-adds-section">
        <div class="container-x">
          <div class="rounded-2xl sm:rounded-3xl gradient-navy-mesh gradient-sheen p-6 sm:p-12 lg:p-16 text-white relative overflow-hidden shadow-2xl">
            <GradientVideo variant="gold" overlayOpacity={0.6} />
            <GoldWaveform alpha="1.2" />

            <div class="relative z-10 max-w-4xl space-y-4 sm:space-y-6">
              <h2 class="text-2xl sm:text-4xl lg:text-5xl font-light tracking-tight text-white leading-tight" id="aplyd-adds-heading">
                What APLYD adds
              </h2>
              <p class="text-base sm:text-xl lg:text-2xl font-light text-pale-navy/95 leading-relaxed">
                APLYD brings applied AI expertise to this foundation: modern machine learning, natural language processing and computer vision, combined with enterprise engineering and system integration. This allows us to design and deploy AI systems that fit existing institutional realities.
              </p>
            </div>
          </div>
        </div>
      </section>

      {/* ============================ SECTION 3: GLOBAL REACH & DELIVERY EXPERIENCE ============================ */}
      <section class="relative z-10 py-10 sm:py-16" id="global-reach-section">
        <div class="container-x space-y-8 sm:space-y-12">
          <div class="max-w-4xl space-y-3 sm:space-y-4">
            <h2 class="text-2xl sm:text-4xl lg:text-5xl font-light text-navy leading-tight" id="global-heading">
              Global reach and delivery experience
            </h2>
            <p class="text-base sm:text-lg lg:text-xl text-mid-navy leading-relaxed font-normal">
              Across more than 440 engagements in 65+ countries, Athena Infonomics has worked with national and local governments, multilateral institutions, bilateral development agencies and global philanthropies.
            </p>
          </div>

          {/* Interactive Global Proof Matrix with White Vector Map & Pulsing Nodes */}
          <div id="footprint-matrix-wrap">
            <InteractiveFootprint />
          </div>
        </div>
      </section>

      {/* ============================ CTA ============================ */}
      <section class="relative z-10 py-8 sm:py-14">
        <div class="container-x">
          <div class="rounded-2xl sm:rounded-3xl border border-hair bg-white/95 backdrop-blur-md p-6 sm:p-10 lg:p-14 shadow-md flex flex-col md:flex-row items-start md:items-center justify-between gap-6 sm:gap-8 card-interactive-sheen final-cta-card">
            <div class="max-w-2xl relative z-10">
              <h3 class="text-2xl sm:text-3xl font-light text-navy mb-3">
                See what we build
              </h3>
              <p class="text-base text-mid-navy leading-relaxed font-normal">
                Explore our applied AI capabilities across government, philanthropy and nonprofits.
              </p>
            </div>
            <div class="relative z-10 w-full sm:w-auto">
              <Button href="/services/our-capabilities/government" variant="primary" class="w-full sm:w-auto text-center justify-center shadow-sm">
                See what we build &rarr;
              </Button>
            </div>
          </div>
        </div>
      </section>
    </AtmosphericCanvas>
  </div>
</Base>
