---
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import InteractiveFootprint from '../../components/InteractiveFootprint.astro';
import AtmosphericCanvas from '../../components/AtmosphericCanvas.astro';
import GoldWaveform from '../../components/GoldWaveform.astro';
import GradientVideo from '../../components/GradientVideo.astro';

const bedrockPillars = [
  {
    phase: 'Governance & Strategy',
    title: 'Policy research and advisory',
    desc: 'Sector knowledge, institutional analysis, governance and public policy formulation that inform how institutions understand problems, make decisions and design interventions.',
    artifacts: ['Sector Readiness Baselines', 'Governance Frameworks', 'Regulatory Guidance'],
  },
  {
    phase: 'Evidence & Learning',
    title: 'Measurement and evaluation',
    desc: 'Baselines, MEL systems, independent evidence generation and implementation learning that help institutions assess performance and understand what is working in practice.',
    artifacts: ['Independent MEL Frameworks', 'Baseline Assessments', 'Impact Evaluations'],
  },
  {
    phase: 'Engineering & Integration',
    title: 'Digital tools and systems',
    desc: 'MIS platforms, product design, system architecture and core data-platform integration that connect technology to institutional workflows and operating environments.',
    artifacts: ['Enterprise MIS Platforms', 'Data Pipeline Hookups', 'Workforce Tooling'],
  },
  {
    phase: 'Field Intelligence',
    title: 'Last-mile data networks',
    desc: 'Community Compass, field intelligence networks, ground data collection and validation that bring evidence from delivery settings into institutional decision-making.',
    artifacts: ['Community Compass', 'Ground Truth Networks', 'Frontline Telemetry'],
  },
];
---

<Base
  title="16 Years of Proof | APLYD by Athena Infonomics"
  description="APLYD is built on sixteen years of Athena Infonomics work in research, measurement, digital systems and last-mile data across governments and funders."
  keywords="Athena Infonomics, APLYD Heritage, Global Public Sector Experience, Evidence-Driven AI"
>
  <div class="pt-20 sm:pt-24 lg:pt-28">
    {/* ============================ HERO ============================ */}
    <section class="bg-institutional-grid text-white py-16 sm:py-24 lg:py-28 relative overflow-hidden">
      {/* Animated Fluid Gradient Video Background */}
      <GradientVideo variant="blue" overlayOpacity={0.62} />
      {/* Ambient Molestone Gold Particle Waveform */}
      <GoldWaveform alpha="1.4" />

      <div class="pointer-events-none absolute -left-40 top-1/4 h-96 w-96 rounded-full bg-navy/60 blur-[120px]" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -right-32 top-10 h-[32rem] w-[32rem] rounded-full bg-gold/10 blur-[140px]" aria-hidden="true"></div>

      <div class="container-x relative z-10">
        <div class="mb-6 inline-flex items-center gap-2 rounded-pill bg-white/10 px-4 py-1.5 text-eyebrow font-bold uppercase tracking-[0.14em] text-gold backdrop-blur-sm border border-white/15">
          <span class="h-2 w-2 rounded-full bg-gold"></span>
          About APLYD · 16 Years of Proof
        </div>

        <h1 class="max-w-4xl text-display font-light text-white leading-[1.05] text-4xl sm:text-6xl lg:text-7xl">
          Sixteen years of delivery behind a new kind of AI practice
        </h1>

        <p class="mt-8 max-w-3xl text-xl sm:text-2xl font-normal text-pale-navy/90 leading-relaxed">
          APLYD builds on sixteen years of Athena Infonomics’ work across governments, funders and public institutions, with a focus on evidence, measurement and implementation. That experience provides the institutional and sector context needed to apply AI within real public systems, where data, workflows, governance and delivery conditions matter as much as the technology.
        </p>
      </div>
    </section>

    {/* ============================ RICH ATMOSPHERIC CANVAS ============================ */}
    <AtmosphericCanvas>
      {/* ============================ SECTION 1: THE BEDROCK ============================ */}
      <section class="relative z-10" id="bedrock-section">
        <div class="container-x space-y-12">
          <div class="max-w-4xl space-y-4">
            <div class="text-xs font-bold uppercase tracking-widest text-gold" id="bedrock-eyebrow">Institutional Foundation</div>
            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-light text-navy leading-tight" id="bedrock-heading">
              The bedrock: Four complementary capabilities
            </h2>
            <p class="text-lg sm:text-xl text-mid-navy leading-relaxed font-normal pt-2">
              Athena Infonomics has built its work around four complementary capabilities. Together, they provide the sector knowledge, evidence infrastructure and delivery experience that underpin APLYD’s approach to applied AI.
            </p>
          </div>

          {/* 4 Bedrock Pillars Connected Display */}
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8" id="bedrock-grid">
            {bedrockPillars.map((item, idx) => (
              <div class={`bedrock-card bedrock-card-${idx} group rounded-3xl border border-hair bg-white/95 backdrop-blur-md p-8 sm:p-10 space-y-6 card-flip-hover flex flex-col justify-between`} data-bedrock-index={idx}>
                <div class="space-y-4 relative z-10">
                  <div class="flex items-center justify-between border-b border-hair/60 pb-3">
                    <span class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-widest text-gold">
                      <span class="h-1.5 w-1.5 rounded-full bg-gold"></span>
                      {item.phase}
                    </span>
                    <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-pale-navy text-navy flip-badge transition-colors">
                      Core Domain
                    </span>
                  </div>

                  <h3 class="text-2xl sm:text-3xl font-light text-navy leading-snug transition-colors">
                    {item.title}
                  </h3>

                  <p class="text-base sm:text-lg text-mid-navy leading-relaxed font-normal flip-text transition-colors">
                    {item.desc}
                  </p>
                </div>

                {/* Artifacts checklist */}
                <div class="pt-4 border-t border-hair/60 space-y-2 relative z-10">
                  <div class="text-xs font-bold uppercase tracking-wider text-mid-navy/70 flip-text transition-colors">Institutional Deliverables</div>
                  <div class="flex flex-wrap gap-2">
                    {item.artifacts.map((art) => (
                      <span class="text-xs font-medium px-3 py-1 rounded-pill bg-paper border border-hair text-navy flip-tag transition-colors">
                        {art}
                      </span>
                    ))}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* ============================ SECTION 2: GLOBAL FOOTPRINT MAP & STATS ============================ */}
      <section class="relative z-10" id="global-reach-section">
        <div class="container-x space-y-12">
          <div class="max-w-3xl space-y-4">
            <div class="text-xs font-bold uppercase tracking-widest text-gold" id="global-eyebrow">Global Reach</div>
            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-light text-navy leading-tight" id="global-heading">
              Sixteen years of global delivery
            </h2>
            <p class="text-lg sm:text-xl text-mid-navy leading-relaxed font-normal">
              Proven public sector impact across 5 continents, serving leading multilateral institutions, national governments, and global philanthropies.
            </p>
          </div>

          {/* Global Interactive Footprint Matrix (Metrics + Live World Operations Map) */}
          <div class="rounded-3xl border border-hair bg-white/95 backdrop-blur-md p-4 sm:p-8 shadow-sm" id="footprint-matrix-wrap">
            <InteractiveFootprint />
          </div>
        </div>
      </section>

      {/* ============================ CTA ============================ */}
      <section class="relative z-10">
        <div class="container-x">
          <div class="rounded-3xl border border-hair bg-white/95 backdrop-blur-md p-8 sm:p-14 shadow-md flex flex-col md:flex-row items-start md:items-center justify-between gap-8 card-interactive-sheen final-cta-card">
            <div class="max-w-2xl relative z-10">
              <div class="text-xs uppercase font-bold tracking-widest text-gold mb-2">Next in About APLYD</div>
              <h3 class="text-2xl sm:text-3xl font-light text-navy mb-3">
                Explore our mission and vision
              </h3>
              <p class="text-base text-mid-navy leading-relaxed font-normal">
                Understand why APLYD exists and the future of applied intelligence in public systems.
              </p>
            </div>
            <div class="relative z-10">
              <Button href="/about/purpose-and-direction" variant="primary" class="whitespace-nowrap shadow-sm">
                Purpose & Direction &rarr;
              </Button>
            </div>
          </div>
        </div>
      </section>
    </AtmosphericCanvas>
  </div>
</Base>
