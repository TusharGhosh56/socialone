---
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import AtmosphericCanvas from '../../components/AtmosphericCanvas.astro';
import HeroVideo from '../../components/HeroVideo.astro';
import { Image } from 'astro:assets';
import { team, type TeamTag } from '../../data/team';

const groups: { tag: TeamTag; title: string }[] = [
  {
    tag: 'Leadership',
    title: 'Leadership',
  },
  {
    tag: 'AI & Digital Transformation',
    title: 'AI & Digital Transformation',
  },
  {
    tag: 'Evaluation & Consulting',
    title: 'Evaluation & Consulting',
  },
];

function getInitials(fullName: string): string {
  const parts = fullName.replace(/^Dr\.?\s+/i, '').split(' ').filter(Boolean);
  if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();
  return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
}
---

<Base
  title="The People Behind APLYD | Team & Leadership"
  description="The leadership and specialists behind APLYD and Athena Infonomics, across AI, delivery and evaluation."
  keywords="APLYD Leadership, Athena Infonomics Founders, AI Practice Leaders, Public Sector AI Specialists, AI Engineers, Algorithmic Evaluation Experts, Decision Intelligence Team"
>
  <div class="pt-20 sm:pt-24 lg:pt-28">
    {/* ============================ HERO ============================ */}
    <section class="hero-internal-section bg-navy text-white py-12 sm:py-16 lg:py-20 min-h-[380px] sm:min-h-[460px] lg:min-h-[520px] flex flex-col justify-center relative overflow-hidden">
      {/* Thematic Cinematic Stock Video Background */}
      <HeroVideo
        src="/video/helping2.mp4"
        overlayOpacity={0.65}
      />

      <div class="container-x relative z-10 space-y-5 sm:space-y-6">
        <div class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-3.5 py-1 text-xs font-bold uppercase tracking-widest text-gold backdrop-blur-sm">
          <span class="h-1.5 w-1.5 rounded-full bg-gold"></span>
          <span>APLYD Roster · Multidisciplinary Practice</span>
        </div>

        <h1 class="max-w-4xl text-display font-light text-white leading-[1.08] text-3xl sm:text-5xl lg:text-6xl tracking-tight">
          Specialists across AI, delivery and evaluation
        </h1>
      </div>
    </section>

    {/* ============================ RICH ATMOSPHERIC CANVAS ============================ */}
    <AtmosphericCanvas>
      {/* ============================ TEAM GROUPS ============================ */}
      <section class="relative z-10 py-10 sm:py-16">
        <div class="container-x space-y-12 sm:space-y-16 lg:space-y-20">
          {groups.map((group, idx) => {
            const members = team.filter((m) => m.tag === group.tag);
            return (
              <div id={`people-group-${idx}`} class={`space-y-6 sm:space-y-8 people-group-${idx}`}>
                <div class="border-b border-hair pb-3 sm:pb-4 flex items-center justify-between">
                  <h2 id={`people-group-heading-${idx}`} class="text-2xl sm:text-3xl lg:text-4xl font-light text-navy leading-tight">
                    {group.title}
                  </h2>
                  <span class="text-xs font-mono font-bold text-mid-navy/60">{members.length} Members</span>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 sm:gap-6 lg:gap-8">
                  {members.map((member) => (
                    <article class="people-card group rounded-2xl sm:rounded-3xl border border-hair bg-white/95 backdrop-blur-md p-4 sm:p-6 shadow-sm flex flex-col justify-between card-interactive-sheen transition-all duration-500 hover:shadow-xl hover:border-gold/40">
                      <div class="relative z-10">
                        <div class="relative mb-4 sm:mb-5 aspect-[4/5] w-full overflow-hidden rounded-xl sm:rounded-2xl bg-paper border border-hair/80">
                          {member.linkedin && (
                            <a
                              href={member.linkedin}
                              target="_blank"
                              rel="noopener noreferrer"
                              aria-label={`${member.name} on LinkedIn`}
                              class="absolute right-2 top-2 sm:right-3 sm:top-3 z-10 flex h-7 w-7 sm:h-8 sm:w-8 items-center justify-center rounded-full border border-hair bg-white/90 text-navy opacity-0 shadow-sm backdrop-blur-sm transition-opacity duration-200 group-hover:opacity-100 hover:border-gold hover:text-gold"
                            >
                              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                <path d="M6.94 8.5H4.06V19.5H6.94V8.5ZM5.5 7.25A1.75 1.75 0 1 0 5.5 3.75A1.75 1.75 0 0 0 5.5 7.25ZM19.94 19.5H17.06V13.75C17.06 12.35 16.5 11.5 15.28 11.5C14.36 11.5 13.81 12.12 13.56 12.72C13.47 12.94 13.44 13.24 13.44 13.55V19.5H10.56S10.6 9.34 10.56 8.5H13.44V9.79C13.83 9.16 14.55 8.26 16.48 8.26C18.88 8.26 19.94 9.86 19.94 12.68V19.5Z" />
                              </svg>
                            </a>
                          )}
                          {member.photo ? (
                            <Image
                              src={member.photo}
                              alt={member.name}
                              width={320}
                              height={400}
                              format="webp"
                              quality={85}
                              class="people-photo h-full w-full object-cover grayscale contrast-105 transition-all duration-700 ease-out group-hover:grayscale-0 group-hover:scale-105"
                            />
                          ) : (
                            <div class="people-initials flex h-full w-full items-center justify-center bg-pale-navy/50 font-serif text-2xl sm:text-3xl font-light text-navy transition-all duration-500">
                              {getInitials(member.name)}
                            </div>
                          )}
                        </div>

                        <h3 class="text-base sm:text-lg font-light text-navy leading-snug">
                          {member.name}
                        </h3>

                        <div class="mt-1 text-[0.6875rem] sm:text-xs font-bold uppercase tracking-wider text-deep-gold">
                          {member.title}
                        </div>

                        {member.subtitle && (
                          <div class="mt-1 text-[0.6875rem] sm:text-xs text-mid-navy/80 line-clamp-2 font-normal">
                            {member.subtitle}
                          </div>
                        )}
                      </div>
                    </article>
                  ))}
                </div>
              </div>
            );
          })}
        </div>
      </section>

      {/* ============================ CTA ============================ */}
      <section class="relative z-10 py-8 sm:py-14">
        <div class="container-x">
          <div class="rounded-2xl sm:rounded-3xl border border-hair bg-white/95 backdrop-blur-md p-6 sm:p-10 lg:p-14 shadow-md flex flex-col md:flex-row items-start md:items-center justify-between gap-6 sm:gap-8 card-interactive-sheen final-cta-card">
            <div class="max-w-2xl relative z-10">
              <div class="text-xs uppercase font-bold tracking-widest text-gold mb-2">Partner With APLYD</div>
              <h3 class="text-2xl sm:text-3xl font-light text-navy mb-3">
                Partner With APLYD
              </h3>
              <p class="text-base text-mid-navy leading-relaxed font-normal">
                Reach out to discuss your institutional AI challenges and explore how our team can support your delivery.
              </p>
            </div>
            <div class="relative z-10 w-full sm:w-auto">
              <Button href="/get-in-touch" variant="primary" class="w-full sm:w-auto text-center justify-center shadow-sm">
                Partner With APLYD &rarr;
              </Button>
            </div>
          </div>
        </div>
      </section>
    </AtmosphericCanvas>
  </div>
</Base>

<style>
  @media (max-width: 1023px) {
    .people-card.is-in-view .people-photo {
      filter: grayscale(0%) contrast(100%);
      transform: scale(1.03);
    }
    .people-card.is-in-view {
      border-color: rgba(200, 160, 75, 0.45);
      box-shadow: 0 8px 24px -4px rgba(10, 25, 47, 0.08);
    }
  }

  @media (hover: hover) and (min-width: 1024px) {
    .people-card:hover .people-photo {
      filter: grayscale(0%) contrast(100%);
      transform: scale(1.05);
    }
  }
</style>

<script>
  function setupPeopleScrollObserver() {
    const cards = document.querySelectorAll('.people-card');
    if (!cards.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-in-view');
          } else {
            const rect = entry.boundingClientRect;
            if (rect.top > window.innerHeight || rect.bottom < 0) {
              entry.target.classList.remove('is-in-view');
            }
          }
        });
      },
      {
        threshold: [0.15, 0.4],
        rootMargin: '0px 0px -10% 0px',
      }
    );

    cards.forEach((card) => observer.observe(card));
  }

  setupPeopleScrollObserver();
  document.addEventListener('astro:page-load', setupPeopleScrollObserver);
</script>
