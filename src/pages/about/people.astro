---
import Base from '../../layouts/Base.astro';
import SectionEyebrow from '../../components/SectionEyebrow.astro';
import Button from '../../components/Button.astro';
import { Image } from 'astro:assets';
import { team, type TeamTag } from '../../data/team';

const groups: { tag: TeamTag; title: string; description: string }[] = [
  {
    tag: 'Leadership',
    title: 'Leadership',
    description: 'Founders and practice leadership guiding APLYD and Athena Infonomics across strategy, governance and institutional partnerships.',
  },
  {
    tag: 'AI & Digital Transformation',
    title: 'AI & Digital Transformation',
    description: 'Engineers, product leads and domain architects building scalable AI platforms and operational workflows.',
  },
  {
    tag: 'Evaluation & Consulting',
    title: 'Evaluation & Consulting',
    description: 'Specialists in measurement, evaluation, research and last-mile evidence systems.',
  },
];

function getInitials(fullName: string): string {
  const parts = fullName.replace(/^Dr\.?\s+/i, '').split(' ').filter(Boolean);
  if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();
  return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
}
---

<Base
  title="The People Behind APLYD | Team & Leadership"
  description="The leadership and specialists behind APLYD and Athena Infonomics, across AI, delivery and evaluation."
  keywords="APLYD Leadership, Athena Infonomics Founders, AI Practice Leaders, Public Sector AI Specialists"
>
  <div class="pt-20 sm:pt-24 lg:pt-28">
    {/* ============================ HERO ============================ */}
    <section class="border-b border-hair bg-paper py-16 sm:py-24 lg:py-28 relative overflow-hidden">
      <div class="container-x relative z-10">
        <div class="mb-6 inline-flex items-center gap-2 rounded-pill bg-pale-navy/80 px-4 py-1.5 text-eyebrow font-bold uppercase tracking-[0.14em] text-navy">
          <span class="h-2 w-2 rounded-full bg-gold"></span>
          About APLYD · The People Behind APLYD
        </div>

        <h1 class="max-w-4xl text-display font-light text-navy leading-[1.05] text-4xl sm:text-6xl lg:text-7xl">
          Specialists across AI, delivery and evaluation
        </h1>

        <p class="mt-8 max-w-3xl text-xl sm:text-2xl font-normal text-mid-navy leading-relaxed">
          APLYD brings together experienced practitioners from machine learning, public policy, institutional systems, and independent evaluation to solve complex delivery challenges at scale.
        </p>
      </div>
    </section>

    {/* ============================ TEAM GROUPS ============================ */}
    <section class="py-20 sm:py-28 bg-white border-b border-hair">
      <div class="container-x space-y-24">
        {groups.map((group, gIdx) => {
          const members = team.filter((m) => m.tag === group.tag);
          return (
            <div class="border-t border-hair pt-16 first:border-t-0 first:pt-0">
              <div class="mb-12 max-w-3xl">
                <SectionEyebrow label={`Group 0${gIdx + 1}`} />
                <h2 class="mt-3 text-3xl sm:text-4xl font-black text-navy leading-tight">
                  {group.title}
                </h2>
                <p class="mt-3 text-lg sm:text-xl text-mid-navy leading-relaxed">{group.description}</p>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 lg:gap-8">
                {members.map((person) => (
                  <div class="group relative flex flex-col items-center rounded-3xl border border-hair bg-paper/50 p-8 text-center shadow-sm transition-all duration-base hover:border-smoke hover:bg-white hover:shadow-lg">
                    {/* LinkedIn button */}
                    {person.linkedin && (
                      <a
                        href={person.linkedin}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`${person.name} on LinkedIn`}
                        class="absolute right-4 top-4 flex h-8 w-8 items-center justify-center rounded-full border border-hair bg-white text-navy shadow-sm transition-colors duration-micro hover:border-gold hover:text-gold"
                      >
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                          <path d="M6.94 8.5H4.06V19.5H6.94V8.5ZM5.5 7.25A1.75 1.75 0 1 0 5.5 3.75A1.75 1.75 0 0 0 5.5 7.25ZM19.94 19.5H17.06V13.75C17.06 12.35 16.5 11.5 15.28 11.5C14.36 11.5 13.81 12.12 13.56 12.72C13.47 12.94 13.44 13.24 13.44 13.55V19.5H10.56S10.6 9.34 10.56 8.5H13.44V9.79C13.83 9.16 14.55 8.26 16.48 8.26C18.88 8.26 19.94 9.86 19.94 12.68V19.5Z" />
                        </svg>
                      </a>
                    )}

                    {/* Avatar / Photo */}
                    <div class="relative mt-2">
                      {person.photo ? (
                        <Image
                          src={person.photo}
                          alt={`${person.name} - ${person.title}`}
                          width={192}
                          height={192}
                          format="webp"
                          quality={85}
                          loading="eager"
                          class="h-28 w-28 rounded-full object-cover shadow-sm ring-4 ring-white"
                        />
                      ) : (
                        <div class="grid h-28 w-28 place-items-center rounded-full bg-pale-navy text-2xl font-bold text-navy shadow-sm ring-4 ring-white">
                          {getInitials(person.name)}
                        </div>
                      )}
                    </div>

                    {/* Name & Roles */}
                    <h3 class="mt-6 text-xl font-bold text-navy leading-snug">
                      {person.name}
                    </h3>
                    <p class="mt-1.5 text-small font-medium text-navy/85 leading-snug">
                      {person.title}
                    </p>
                    {person.subtitle && (
                      <p class="mt-1 text-xs text-mid-navy/70 leading-snug">
                        {person.subtitle}
                      </p>
                    )}

                    <div class="mt-auto pt-6">
                      <span class="inline-block rounded-pill bg-pale-navy/70 px-3.5 py-1 text-[0.6875rem] font-bold uppercase tracking-wider text-navy">
                        {person.tag}
                      </span>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          );
        })}
      </div>
    </section>

    {/* ============================ NEXT SECTION CTA ============================ */}
    <section class="py-16 sm:py-24 bg-paper">
      <div class="container-x">
        <div class="rounded-3xl border border-hair bg-white p-8 sm:p-12 shadow-sm flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
          <div>
            <div class="text-xs uppercase font-bold tracking-widest text-gold mb-2">Start a Dialogue</div>
            <h3 class="text-2xl sm:text-3xl font-bold text-navy">
              Connect with our practice leaders and domain specialists.
            </h3>
          </div>
          <Button href="/contact" variant="primary" class="whitespace-nowrap">
            Partner With APLYD &rarr;
          </Button>
        </div>
      </div>
    </section>
  </div>
</Base>
