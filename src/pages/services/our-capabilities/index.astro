---
import Base from '../../../layouts/Base.astro';
import Button from '../../../components/Button.astro';
import AtmosphericCanvas from '../../../components/AtmosphericCanvas.astro';
import HeroVideo from '../../../components/HeroVideo.astro';
import { sectorDataList } from '../../../data/capabilities';

const sectors = [
  sectorDataList.government,
  sectorDataList.nonprofits,
  sectorDataList.philanthropy,
];
---

<Base
  title="Our Capabilities | Applied AI Across Sectors | APLYD"
  description="Explore APLYD's applied AI capabilities across government, nonprofits, and philanthropy."
  keywords="APLYD Capabilities, Government AI, Nonprofit AI, Philanthropy AI Strategy, GovTech AI Solutions, Institutional AI Readiness, Public Sector AI Engineering, Independent AI Assurance"
>
  <div class="pt-20 sm:pt-24 lg:pt-28">
    {/* ============================ HERO ============================ */}
    <section class="hero-internal-section bg-navy text-white py-12 sm:py-16 min-h-[460px] sm:min-h-[500px] lg:min-h-[520px] flex flex-col justify-center relative overflow-hidden">
      {/* Thematic Cinematic Stock Video: Vibrant Community & Multi-Sector Impact */}
      <HeroVideo
        src="/video/capability.mp4"
        overlayOpacity={0.62}
      />

      <div class="container-x relative z-10">
        <div class="mb-4 inline-flex items-center gap-2 rounded-pill bg-white/10 px-3.5 py-1 text-eyebrow font-bold uppercase tracking-[0.14em] text-gold backdrop-blur-sm border border-white/15">
          <span class="h-1.5 w-1.5 rounded-full bg-gold"></span>
          Services · Our Capabilities
        </div>

        <h1 class="max-w-4xl text-display font-light text-white leading-[1.08] text-4xl sm:text-5xl lg:text-6xl tracking-tight">
          Applied AI capabilities across sectors
        </h1>

        <p class="mt-5 max-w-3xl text-base sm:text-lg lg:text-xl font-normal text-pale-navy/90 leading-relaxed">
          We work across the full AI implementation journey, from assessing readiness and identifying use cases to building systems and establishing internal institutional capability.
        </p>
      </div>
    </section>

    {/* ============================ RICH ATMOSPHERIC CANVAS ============================ */}
    <AtmosphericCanvas>
      {/* ============================ SECTORS ============================ */}
      <section class="relative z-10" id="sector-overview-section">
        <div class="container-x space-y-12">
          <div class="grid grid-cols-1 lg:grid-cols-3 gap-8" id="sector-overview-grid">
            {sectors.map((sector, idx) => (
              <div class={`sector-overview-card sector-overview-card-${idx} rounded-3xl border border-hair bg-white/95 backdrop-blur-md p-8 sm:p-10 shadow-sm flex flex-col justify-between space-y-8 hover:border-gold/40 hover:shadow-md transition-all duration-300 card-interactive-sheen`} data-sector-index={idx}>
                <div class="space-y-4 relative z-10">
                  <div class="sector-overview-badge inline-flex items-center gap-2 rounded-pill bg-pale-navy px-3.5 py-1 text-xs font-bold uppercase tracking-widest text-navy border border-hair transition-all duration-300">
                    <span class="sector-overview-dot h-1.5 w-1.5 rounded-full bg-gold transition-all duration-300"></span>
                    {sector.label}
                  </div>
                  <h2 class="text-2xl sm:text-3xl font-light text-navy leading-snug">
                    {sector.heroH1}
                  </h2>
                  <p class="text-base text-mid-navy leading-relaxed font-normal">
                    {sector.heroLead}
                  </p>
                </div>

                <div class="pt-6 border-t border-hair space-y-4 relative z-10">
                  <div class="text-xs font-bold uppercase tracking-wider text-mid-navy/70">
                    Core Capabilities
                  </div>
                  <ul class="space-y-2.5">
                    {sector.capabilities.map((cap) => (
                      <li class="flex items-start gap-2 text-small font-medium text-navy">
                        <span class="text-gold font-bold mt-0.5">✓</span>
                        <span>{cap.title}</span>
                      </li>
                    ))}
                  </ul>
                  
                  <div class="pt-4">
                    <Button href={`/services/our-capabilities/${sector.id}`} variant="primary" class="w-full justify-center text-center">
                      View {sector.label} Capabilities &rarr;
                    </Button>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* ============================ CTA ============================ */}
      <section class="relative z-10">
        <div class="container-x">
          <div class="rounded-3xl border border-hair bg-white/95 backdrop-blur-md p-6 sm:p-10 lg:p-14 shadow-md flex flex-col md:flex-row items-start md:items-center justify-between gap-6 sm:gap-8 card-interactive-sheen final-cta-card">
            <div class="max-w-2xl relative z-10">
              <div class="text-xs uppercase font-bold tracking-widest text-gold mb-2">Our Methodology</div>
              <h3 class="text-2xl sm:text-3xl font-light text-navy mb-3">
                How we deliver across these capabilities
              </h3>
              <p class="text-base text-mid-navy leading-relaxed font-normal">
                Explore our four-stage delivery model from strategy and design to delivery and independent assurance.
              </p>
            </div>
            <div class="relative z-10 w-full sm:w-auto">
              <Button href="/services/our-approach" variant="primary" class="w-full sm:w-auto text-center justify-center shadow-sm">
                Explore Our Approach &rarr;
              </Button>
            </div>
          </div>
        </div>
      </section>
    </AtmosphericCanvas>
  </div>
</Base>
