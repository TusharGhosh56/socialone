---
import Base from '../../../layouts/Base.astro';
import Button from '../../../components/Button.astro';
import AtmosphericCanvas from '../../../components/AtmosphericCanvas.astro';
import { sectorDataList } from '../../../data/capabilities';

const sectors = [
  sectorDataList.government,
  sectorDataList.nonprofits,
  sectorDataList.philanthropy,
];
---

<Base
  title="Our Capabilities | Applied AI Across Sectors | APLYD"
  description="Explore APLYD's applied AI capabilities across government, nonprofits, and philanthropy."
  keywords="APLYD Capabilities, Government AI, Nonprofit AI, Philanthropy AI Strategy, Institutional AI"
>
  <div class="pt-20 sm:pt-24 lg:pt-28">
    {/* ============================ HERO ============================ */}
    <section class="bg-institutional-grid text-white py-16 sm:py-24 lg:py-28 relative overflow-hidden">
      <div class="pointer-events-none absolute -left-40 top-1/4 h-96 w-96 rounded-full bg-navy/60 blur-[120px]" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -right-32 top-10 h-[32rem] w-[32rem] rounded-full bg-gold/10 blur-[140px]" aria-hidden="true"></div>

      <div class="container-x relative z-10">
        <div class="mb-6 inline-flex items-center gap-2 rounded-pill bg-white/10 px-4 py-1.5 text-eyebrow font-bold uppercase tracking-[0.14em] text-gold backdrop-blur-sm border border-white/15">
          <span class="h-2 w-2 rounded-full bg-gold"></span>
          Services · Our Capabilities
        </div>

        <h1 class="max-w-5xl text-display font-light text-white leading-[1.05] text-4xl sm:text-6xl lg:text-7xl">
          Applied AI capabilities across sectors
        </h1>

        <p class="mt-8 max-w-4xl text-xl sm:text-2xl font-normal text-pale-navy/90 leading-relaxed">
          We work across the full AI implementation journey, from assessing readiness and identifying use cases to building systems and establishing internal institutional capability.
        </p>
      </div>
    </section>

    {/* ============================ RICH ATMOSPHERIC CANVAS ============================ */}
    <AtmosphericCanvas>
      {/* ============================ SECTORS ============================ */}
      <section class="relative z-10">
        <div class="container-x space-y-12">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {sectors.map((sector) => (
              <div class="rounded-3xl border border-hair bg-white/95 backdrop-blur-md p-8 sm:p-10 shadow-sm flex flex-col justify-between space-y-8 hover:border-gold/40 hover:shadow-md transition-all duration-300">
                <div class="space-y-4">
                  <div class="text-xs font-bold uppercase tracking-widest text-gold">
                    {sector.label}
                  </div>
                  <h2 class="text-2xl sm:text-3xl font-light text-navy leading-snug">
                    {sector.heroH1}
                  </h2>
                  <p class="text-base text-mid-navy leading-relaxed font-normal">
                    {sector.heroLead}
                  </p>
                </div>

                <div class="pt-6 border-t border-hair space-y-4">
                  <div class="text-xs font-bold uppercase tracking-wider text-mid-navy/70">
                    Core Capabilities
                  </div>
                  <ul class="space-y-2.5">
                    {sector.capabilities.map((cap) => (
                      <li class="flex items-start gap-2 text-small font-medium text-navy">
                        <span class="text-gold font-bold mt-0.5">✓</span>
                        <span>{cap.title}</span>
                      </li>
                    ))}
                  </ul>
                  
                  <div class="pt-4">
                    <Button href={`/services/our-capabilities/${sector.id}`} variant="primary" class="w-full justify-center text-center">
                      View {sector.label} Capabilities &rarr;
                    </Button>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* ============================ CTA ============================ */}
      <section class="relative z-10">
        <div class="container-x">
          <div class="rounded-3xl border border-hair bg-white/95 backdrop-blur-md p-8 sm:p-14 shadow-md flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
            <div class="max-w-2xl">
              <div class="text-xs uppercase font-bold tracking-widest text-gold mb-2">Our Methodology</div>
              <h3 class="text-2xl sm:text-3xl font-light text-navy mb-3">
                How we deliver across these capabilities
              </h3>
              <p class="text-base text-mid-navy leading-relaxed font-normal">
                Explore our four-stage delivery model from strategy and design to delivery and independent assurance.
              </p>
            </div>
            <Button href="/services/our-approach" variant="primary" class="whitespace-nowrap shadow-sm">
              Explore Our Approach &rarr;
            </Button>
          </div>
        </div>
      </section>
    </AtmosphericCanvas>
  </div>
</Base>
