---
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';

const stages = [
  {
    num: '01',
    stageName: 'Explore',
    title: 'Strategy and direction',
    desc: 'We help institutions identify where AI can deliver measurable public value. This starts with the problem: understanding operational bottlenecks, the decisions being made, and the evidence needed to support them. We assess institutional readiness, evaluate available data, and define use cases with clear outcomes and delivery paths.',
  },
  {
    num: '02',
    stageName: 'Design',
    title: 'Field and delivery',
    desc: 'Before building, we examine the environment in which the system will operate. This means understanding frontline workflows, user needs, connectivity and operational constraints. We design systems that integrate with existing processes, address data quality and representation, and account for the realities of field implementation.',
  },
  {
    num: '03',
    stageName: 'Deliver',
    title: 'Design, build and scale',
    desc: 'We build production-ready systems designed for institutional use. We work alongside existing teams throughout implementation, ensuring solutions fit operational realities. Every engagement includes capability transfer: leaving institutions with the technical infrastructure, documentation and trained staff to own and manage the system.',
  },
  {
    num: '04',
    stageName: 'Assure',
    title: 'Evaluation and assurance',
    desc: 'We evaluate whether systems work as intended in practice. We conduct rigorous, independent assessments of performance, accuracy, fairness and user adoption. Crucially, evaluation is kept separate from delivery: we only evaluate systems we did not build, giving institutions objective evidence to inform decisions about continuation, refinement or scale.',
  },
];
---

<Base
  title="Our Approach | From Strategy to Assurance | APLYD"
  description="How APLYD moves an institution from the decision worth improving, through build, to independent assurance."
  keywords="APLYD Approach, AI Implementation Journey, Strategy to Assurance, Institutional AI Delivery"
>
  <div class="pt-20 sm:pt-24 lg:pt-28">
    {/* ============================ HERO ============================ */}
    <section class="bg-institutional-grid text-white py-16 sm:py-24 lg:py-28 relative overflow-hidden border-b border-white/10">
      <div class="container-x relative z-10">
        <div class="mb-6 inline-flex items-center gap-2 rounded-pill bg-white/10 px-4 py-1.5 text-eyebrow font-bold uppercase tracking-[0.14em] text-gold backdrop-blur-sm border border-white/15">
          <span class="h-2 w-2 rounded-full bg-gold"></span>
          Services · Our Approach
        </div>

        <h1 class="max-w-5xl text-display font-light text-white leading-[1.05] text-4xl sm:text-6xl lg:text-7xl">
          From the decision worth improving to a system that lasts
        </h1>

        <div class="mt-8 max-w-4xl space-y-6 text-xl sm:text-2xl font-normal text-pale-navy/90 leading-relaxed">
          <p>
            Applied AI is easier to pilot than to sustain. Whether it creates lasting value depends on the decisions made before implementation: the problem being addressed, the evidence behind it, the conditions for deployment, and the institutional capacity to own and operate what is built.
          </p>
          <p class="text-lg sm:text-xl text-pale-navy/80">
            We organise our work across four stages, from strategy and direction through design, delivery and assurance. Institutions can engage at any stage based on their needs, or work with us across the full journey.
          </p>
        </div>
      </div>
    </section>

    {/* ============================ INTERCONNECTED LIFECYCLE ============================ */}
    <section class="py-16 sm:py-20 bg-white border-b border-hair">
      <div class="container-x">
        <div class="max-w-4xl space-y-4">
          <div class="text-xs font-bold uppercase tracking-widest text-gold">The Delivery Journey</div>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-light text-navy leading-tight">
            Each stage is designed to strengthen the next
          </h2>
          <p class="text-lg sm:text-xl text-mid-navy leading-relaxed font-normal pt-2">
            A poorly defined problem can lead to the wrong solution. A system without clear measures of performance cannot be improved or responsibly scaled. And a solution without institutional ownership is difficult to sustain. The four stages below set out how we move from identifying the right opportunity to building systems that can be used, measured and maintained.
          </p>
        </div>
      </div>
    </section>

    {/* ============================ THE FOUR STAGES ============================ */}
    <section class="py-16 sm:py-24 bg-paper border-b border-hair">
      <div class="container-x space-y-12">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {stages.map((stage) => (
            <div class="rounded-3xl border border-hair bg-white p-8 sm:p-10 shadow-sm flex flex-col justify-between space-y-6">
              <div class="space-y-4">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-bold uppercase tracking-widest text-gold">
                    Stage {stage.num}
                  </span>
                  <span class="inline-flex items-center rounded-pill bg-pale-navy px-3 py-1 text-xs font-bold uppercase tracking-wider text-navy">
                    {stage.stageName}
                  </span>
                </div>
                <h3 class="text-2xl sm:text-3xl font-light text-navy leading-snug">
                  {stage.title}
                </h3>
                <p class="text-base sm:text-lg text-mid-navy leading-relaxed font-normal">
                  {stage.desc}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ============================ CTA ============================ */}
    <section class="py-16 sm:py-24 bg-paper">
      <div class="container-x">
        <div class="rounded-3xl border border-hair bg-white p-8 sm:p-14 shadow-sm flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
          <div class="max-w-2xl">
            <div class="text-xs uppercase font-bold tracking-widest text-gold mb-2">Next in Services</div>
            <h3 class="text-2xl sm:text-3xl font-light text-navy mb-3">
              Explore our capabilities across sectors
            </h3>
            <p class="text-base text-mid-navy leading-relaxed">
              See how our approach translates into applied capabilities for government, nonprofits, and philanthropy.
            </p>
          </div>
          <Button href="/services/our-capabilities/government" variant="primary" class="whitespace-nowrap">
            Explore our capabilities &rarr;
          </Button>
        </div>
      </div>
    </section>
  </div>
</Base>
