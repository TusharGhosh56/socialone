---
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import ApproachStageExplorer from '../../components/ApproachStageExplorer.astro';
import AtmosphericCanvas from '../../components/AtmosphericCanvas.astro';
import GoldWaveform from '../../components/GoldWaveform.astro';
import GradientVideo from '../../components/GradientVideo.astro';
import HeroVideo from '../../components/HeroVideo.astro';
---

<Base
  title="Our Approach | From Strategy to Assurance | APLYD"
  description="How APLYD moves an institution from the decision worth improving, through build, to independent assurance."
  keywords="APLYD Approach, AI Implementation Journey, Strategy to Assurance, Institutional AI Delivery, Frontline AI Co-Design, Sovereign Handover, Algorithmic Audit, AI Lifecycle Management"
>
  <div class="w-full">
    {/* ============================ HERO ============================ */}
    <section class="hero-internal-section bg-navy text-white pt-28 sm:pt-36 lg:pt-40 pb-16 sm:pb-24 lg:pb-28 min-h-screen min-h-[100dvh] flex flex-col justify-center relative overflow-hidden">
      {/* Thematic Cinematic Stock Video Background: Decision Systems & Architecture */}
      <HeroVideo
        src="/video/optimized/our_approach.mp4"
        overlayOpacity={0.65}
      />

      <div class="container-x relative z-10 space-y-6 sm:space-y-8">
        <div class="space-y-4 sm:space-y-6">
          <h1 class="max-w-4xl text-display font-light text-white leading-[1.08] text-3xl sm:text-5xl lg:text-6xl tracking-tight">
            From the decision worth improving to a system that lasts
          </h1>

          <p class="max-w-4xl lg:max-w-5xl text-base sm:text-xl lg:text-2xl font-light text-pale-navy/95 leading-relaxed">
            Applied AI is easier to pilot than to sustain. Whether it creates lasting value depends on the decisions made before implementation: the problem being addressed, the evidence behind it, the conditions for deployment, and the institutional capacity to own and operate what is built.
          </p>
        </div>
      </div>
    </section>

    {/* ============================ RICH ATMOSPHERIC CANVAS ============================ */}
    <AtmosphericCanvas>
      {/* ============================ THE FOUR METHODOLOGY STAGES ============================ */}
      <section class="relative z-10 py-6 sm:py-10 lg:py-0 w-full">
        <ApproachStageExplorer />
      </section>

      {/* ============================ CTA ============================ */}
      <section class="relative z-10 pt-4 pb-12 sm:pb-16">
        <div class="container-x">
          <div class="rounded-3xl border border-hair bg-white/95 backdrop-blur-md p-6 sm:p-10 lg:p-14 shadow-md flex flex-col md:flex-row items-start md:items-center justify-between gap-6 sm:gap-8 card-interactive-sheen final-cta-card">
            <div class="max-w-2xl relative z-10">
              <div class="text-xs uppercase font-bold tracking-widest text-gold mb-2">Explore Capabilities</div>
              <h3 class="text-2xl sm:text-3xl font-light text-navy mb-3">
                Explore our capabilities
              </h3>
              <p class="text-base text-mid-navy leading-relaxed font-normal">
                Discover our applied AI capabilities across government, nonprofits, and global philanthropy.
              </p>
            </div>
            <div class="relative z-10 w-full sm:w-auto">
              <Button href="/services/our-capabilities/government" variant="primary" class="w-full sm:w-auto text-center justify-center shadow-sm">
                Explore our capabilities &rarr;
              </Button>
            </div>
          </div>
        </div>
      </section>
    </AtmosphericCanvas>
  </div>
</Base>
