---
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import ApproachStageExplorer from '../../components/ApproachStageExplorer.astro';

const pipelinePhases = [
  { step: '01', name: 'Explore', title: 'Strategy & Direction', tag: 'Problem First' },
  { step: '02', name: 'Design', title: 'Field & Delivery', tag: 'Frontline Context' },
  { step: '03', name: 'Deliver', title: 'Design, Build & Scale', tag: 'Capability Transfer' },
  { step: '04', name: 'Assure', title: 'Evaluation & Assurance', tag: 'Independent Audit' },
];
---

<Base
  title="Our Approach | From Strategy to Assurance | APLYD"
  description="How APLYD moves an institution from the decision worth improving, through build, to independent assurance."
  keywords="APLYD Approach, AI Implementation Journey, Strategy to Assurance, Institutional AI Delivery"
>
  <div class="pt-20 sm:pt-24 lg:pt-28">
    {/* ============================ HERO ============================ */}
    <section class="bg-institutional-grid text-white py-16 sm:py-24 lg:py-28 relative overflow-hidden border-b border-white/10">
      <div class="container-x relative z-10">
        <div class="mb-6 inline-flex items-center gap-2 rounded-pill bg-white/10 px-4 py-1.5 text-eyebrow font-bold uppercase tracking-[0.14em] text-gold backdrop-blur-sm border border-white/15">
          <span class="h-2 w-2 rounded-full bg-gold"></span>
          Services · Our Approach
        </div>

        <h1 class="max-w-5xl text-display font-light text-white leading-[1.05] text-4xl sm:text-6xl lg:text-7xl">
          From the decision worth improving to a system that lasts
        </h1>

        <div class="mt-8 max-w-4xl space-y-6 text-xl sm:text-2xl font-normal text-pale-navy/90 leading-relaxed">
          <p>
            Applied AI is easier to pilot than to sustain. Whether it creates lasting value depends on the decisions made before implementation: the problem being addressed, the evidence behind it, the conditions for deployment, and the institutional capacity to own and operate what is built.
          </p>
          <p class="text-lg sm:text-xl text-pale-navy/80">
            We organise our work across four stages, from strategy and direction through design, delivery and assurance. Institutions can engage at any stage based on their needs, or work with us across the full journey.
          </p>
        </div>
      </div>
    </section>

    {/* ============================ CONNECTED PIPELINE OVERVIEW ============================ */}
    <section class="py-14 sm:py-16 bg-paper border-b border-hair">
      <div class="container-x space-y-8">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
          <div>
            <div class="text-xs font-bold uppercase tracking-widest text-gold mb-1">
              End-to-End Methodology
            </div>
            <h2 class="text-2xl sm:text-3xl font-light text-navy">
              The four stages of institutional AI delivery
            </h2>
          </div>
          <p class="text-small text-mid-navy max-w-md">
            Each stage addresses a specific point of failure in standard AI initiatives, ensuring solutions fit operational realities.
          </p>
        </div>

        {/* Connected Step Pipeline */}
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 relative">
          {pipelinePhases.map((phase, pIdx) => (
            <div class="relative flex flex-col justify-between rounded-2xl bg-white p-6 border border-hair shadow-sm hover:border-gold/50 transition-colors">
              <div class="space-y-2">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-bold uppercase tracking-widest text-gold">
                    {phase.step}
                  </span>
                  <span class="text-[10px] uppercase font-bold px-2 py-0.5 rounded bg-pale-navy text-navy">
                    {phase.tag}
                  </span>
                </div>
                <div class="text-lg font-bold text-navy">{phase.title}</div>
              </div>
              <div class="pt-4 mt-4 border-t border-hair/60 flex items-center justify-between text-xs text-mid-navy">
                <span>Phase: <strong class="text-navy">{phase.name}</strong></span>
                <span class="text-gold font-bold">&rarr;</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ============================ INTERACTIVE STAGE EXPLORER WORKBENCH ============================ */}
    <section class="py-16 sm:py-24 bg-white border-b border-hair">
      <div class="container-x space-y-12">
        <div class="max-w-3xl space-y-3">
          <div class="text-xs font-bold uppercase tracking-widest text-gold">
            Interactive Stage Deep-Dive
          </div>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-light text-navy leading-tight">
            Explore the four delivery stages
          </h2>
          <p class="text-lg text-mid-navy leading-relaxed font-normal">
            Click on any phase below to examine our operational methodology, core objectives, and architectural deliverables.
          </p>
        </div>

        <ApproachStageExplorer />
      </div>
    </section>

    {/* ============================ STRUCTURAL INDEPENDENCE CALLOUT ============================ */}
    <section class="py-16 sm:py-24 bg-paper border-b border-hair">
      <div class="container-x">
        <div class="rounded-3xl gradient-navy gradient-sheen p-8 sm:p-14 lg:p-16 text-white relative overflow-hidden shadow-xl">
          <div class="relative z-10 max-w-4xl space-y-6">
            <div class="inline-flex items-center gap-2 rounded-pill bg-white/10 px-4 py-1.5 text-eyebrow font-bold uppercase tracking-[0.14em] text-gold backdrop-blur-sm border border-white/15">
              <span class="h-2 w-2 rounded-full bg-gold"></span>
              Independent by Design
            </div>
            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-light text-white leading-tight">
              Evaluation is structurally separate from delivery
            </h2>
            <p class="text-lg sm:text-2xl font-light text-pale-navy/90 leading-relaxed">
              We only evaluate systems that no one in our group built, and we do not bid to build systems that we have evaluated. Keeping assurance separate from delivery allows institutions to assess system performance, safety, fairness and impact with complete independence—ensuring evaluation findings are never influenced by an interest in a delivery outcome.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* ============================ CTA ============================ */}
    <section class="py-16 sm:py-24 bg-white">
      <div class="container-x">
        <div class="rounded-3xl border border-hair bg-paper p-8 sm:p-14 shadow-sm flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
          <div class="max-w-2xl">
            <div class="text-xs uppercase font-bold tracking-widest text-gold mb-2">Engage With APLYD</div>
            <h3 class="text-2xl sm:text-3xl font-light text-navy mb-3">
              Ready to explore an implementation?
            </h3>
            <p class="text-base text-mid-navy leading-relaxed font-normal">
              Talk to our practice leads about your institution's specific delivery objectives and AI readiness.
            </p>
          </div>
          <Button href="/contact" variant="primary" class="whitespace-nowrap">
            Partner With APLYD &rarr;
          </Button>
        </div>
      </div>
    </section>
  </div>
</Base>
