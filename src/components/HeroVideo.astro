---
// HeroVideo.astro — Cinematic stock video background for internal page hero sections
export interface VideoItem {
  id: string;
  src: string;
  poster?: string;
  storyTag?: string;
}

interface Props {
  src?: string;
  poster?: string;
  storyTag?: string;
  videos?: VideoItem[];
  activeId?: string;
  overlayOpacity?: number;
  class?: string;
  showBadge?: boolean;
}

const {
  src,
  poster,
  storyTag = 'Applied Intelligence · Human Impact',
  videos,
  activeId,
  overlayOpacity = 0.55,
  class: className = '',
  showBadge = true,
} = Astro.props;

function getPosterForVideo(videoSrc: string): string {
  const filename = videoSrc.split('/').pop()?.replace(/\.[^/.]+$/, '') || '';
  const cleanName = filename.replace(/\s+/g, '_').toLowerCase();
  return `/video/posters/${cleanName}.webp`;
}

// Determine video sources list with auto-derived poster paths
const videoList: VideoItem[] = videos && videos.length > 0 
  ? videos.map((v) => ({ ...v, poster: v.poster || getPosterForVideo(v.src) })) 
  : (src 
      ? [{ id: 'default', src, poster: poster || getPosterForVideo(src), storyTag }] 
      : [{ id: 'default', src: '/video/optimized/1.mp4', poster: '/video/posters/1.webp', storyTag }]);

const currentActiveId = activeId || videoList[0].id;
const currentActiveItem = videoList.find((v) => v.id === currentActiveId) || videoList[0];
---

<div class={`hero-video-stage pointer-events-none absolute inset-0 overflow-hidden ${className}`} aria-hidden="true">
  {/* Instant WebP Static Poster Underlay — guarantees 0ms visual paint with zero blank void */}
  {videoList.map((item) => (
    <img
      src={item.poster}
      alt=""
      loading="eager"
      decoding="async"
      fetchpriority="high"
      class={`hero-video-poster absolute inset-0 h-full w-full object-cover transition-opacity duration-700 ease-in-out ${
        item.id === currentActiveId ? 'opacity-100' : 'opacity-0 pointer-events-none'
      }`}
      data-hero-poster={item.id}
    />
  ))}

  {videoList.map((item) => (
    <video
      class={`hero-video-el absolute inset-0 h-full w-full object-cover transition-opacity duration-700 ease-in-out ${
        item.id === currentActiveId ? 'opacity-100 is-active' : 'opacity-0 pointer-events-none'
      }`}
      data-hero-bg-video={item.id}
      poster={item.poster}
      autoplay
      loop
      muted
      playsinline
      preload="auto"
    >
      <source src={item.src} type={item.src.endsWith('.webm') ? 'video/webm' : 'video/mp4'} />
    </video>
  ))}

  {/* Cinematic Navy Gradient Overlay (Preserves video clarity while ensuring AAA text contrast) */}
  <div
    class="hero-video-overlay absolute inset-0"
    style={`background: linear-gradient(180deg, rgba(11, 14, 43, 0.42) 0%, rgba(11, 14, 43, ${overlayOpacity}) 45%, rgba(11, 14, 43, ${Math.min(overlayOpacity + 0.28, 0.92)}) 75%, #0b0e2b 100%);`}
  ></div>

  {/* Soft Radial Vignette for Deep Subject Focus */}
  <div class="hero-video-vignette absolute inset-0 pointer-events-none"></div>

  {/* Ambient Golden & Azure Atmospheric Glows */}
  <div class="pointer-events-none absolute -right-24 top-10 h-[36rem] w-[36rem] rounded-full bg-gold/15 blur-[130px]"></div>
  <div class="pointer-events-none absolute -left-28 bottom-0 h-80 w-80 rounded-full bg-navy/60 blur-[100px]"></div>
</div>

<style>
  .hero-video-stage {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    overflow: hidden;
  }
  .hero-video-poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
    will-change: opacity;
    z-index: 1;
  }
  .hero-video-el {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
    will-change: opacity;
    z-index: 1;
  }
  .hero-video-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }
  .hero-video-vignette {
    position: absolute;
    inset: 0;
    z-index: 3;
    background: radial-gradient(circle at 60% 35%, transparent 30%, rgba(11, 14, 43, 0.45) 85%);
    pointer-events: none;
  }
</style>

<script>
  function ensureHeroVideosPlay() {
    const videos = document.querySelectorAll<HTMLVideoElement>('video[data-hero-bg-video]');
    videos.forEach((video) => {
      video.muted = true;
      if (video.paused) {
        const playPromise = video.play();
        if (playPromise !== undefined) {
          playPromise.catch(() => {
            // Autoplay was prevented or suppressed
          });
        }
      }
    });
  }

  // Ensure videos play immediately and on Astro view transitions
  ensureHeroVideosPlay();
  document.addEventListener('astro:page-load', ensureHeroVideosPlay);
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) {
      ensureHeroVideosPlay();
    }
  });
</script>
