---
// InteractiveFootprint.astro — State-of-the-art interactive Global Proof & Footprint matrix
// Featuring the exact white vector world map (from partners page), pulsing radar nodes,
// animated golden network trails, and clean floating hover dossier cards.
const metrics = [
  { value: '440+', label: 'Engagements Delivered', badge: 'Public & Social Sector', detail: 'From national digital health to agriculture & climate' },
  { value: '240+', label: 'Global Clients', badge: 'Trusted Institutions', detail: 'Governments, UN agencies, Bilaterals & Foundations' },
  { value: '95+', label: 'Specialists Across Practice', badge: 'Applied AI & Policy', detail: 'Data engineers, econometricians & domain experts' },
  { value: '65+', label: 'Countries with Projects', badge: 'Global Delivery', detail: 'Across Africa, South Asia, Southeast Asia & Americas' },
  { value: '5', label: 'Continents in Field Ops', badge: 'Population Scale', detail: 'Active ground intelligence and data networks' },
  { value: '120+', label: 'People Across the Group', badge: 'Athena Infonomics Ecosystem', detail: 'Multidisciplinary talent driving lasting capability' },
];
---

<div class="space-y-8 sm:space-y-12 lg:space-y-16" data-interactive-footprint>
  {/* ==================== 1. LIVE METRIC TILES (CLEAN EDITORIAL, NO BOXES) ==================== */}
  <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-8 sm:gap-x-10 sm:gap-y-12 lg:gap-x-12 lg:gap-y-14" id="footprint-metrics-grid">
    {metrics.map((m) => (
      <div class="flex flex-col justify-between pt-4 sm:pt-6 border-t border-hair/90">
        <div class="flex items-center gap-2 mb-2 sm:mb-4">
          <span class="h-1.5 w-1.5 rounded-full bg-gold shrink-0"></span>
          <span class="text-[0.6875rem] sm:text-xs font-bold uppercase tracking-widest text-mid-navy">
            {m.badge}
          </span>
        </div>

        <div class="my-1 sm:my-2">
          <div
            class="text-3xl sm:text-5xl lg:text-6xl font-light text-navy tracking-tight font-display"
            data-metric-target={m.value}
          >
            {m.value}
          </div>
          <div class="text-[0.6875rem] sm:text-xs uppercase tracking-wider font-bold text-navy mt-1.5 sm:mt-2">
            {m.label}
          </div>
        </div>

        <p class="text-xs sm:text-sm text-mid-navy leading-relaxed mt-2 sm:mt-4">
          {m.detail}
        </p>
      </div>
    ))}
  </div>

  {/* ==================== 2. WHITE THEME VECTOR WORLD MAP CONSOLE ==================== */}
  <div class="rounded-2xl sm:rounded-3xl border border-hair bg-white/95 backdrop-blur-md p-4 sm:p-8 lg:p-10 shadow-sm relative overflow-hidden" id="global-map-console">
    <div class="relative z-10">
      {/* Console Top Bar */}
      <div class="pb-6 border-b border-hair">
        <h3 class="text-2xl sm:text-3xl font-light tracking-tight text-navy">
          Global Operations & Presence Map
        </h3>
      </div>

      {/* Full-Width White Vector World Map Canvas Container */}
      <div class="footprint-map-card w-full relative rounded-2xl overflow-hidden border border-hair bg-gradient-to-br from-paper/30 via-white to-pale-navy/20 mt-6 min-h-[420px] sm:min-h-[520px] lg:min-h-[600px] flex items-center justify-center shadow-xs">
        
        {/* Dynamic Rich Hover Dossier Tooltip (Clean Without Status Footer) */}
        <div
          id="footprint-rich-tooltip"
          class="footprint-tooltip pointer-events-none opacity-0 transition-all duration-200 absolute z-30 bg-navy/95 text-white p-4 sm:p-5 rounded-2xl shadow-xl border border-white/20 max-w-sm backdrop-blur-md"
        >
          <div class="flex items-center justify-between gap-2 mb-2">
            <span class="inline-block rounded-full bg-gold/20 px-2.5 py-0.5 text-[10px] sm:text-[11px] font-bold uppercase tracking-wider text-gold tooltip-year">
              Established 2010
            </span>
            <span class="text-[11px] font-mono text-white/60 tooltip-country">India</span>
          </div>

          <h4 class="text-base sm:text-lg font-bold !text-white mb-1 tooltip-title">
            India HQ & Core Lab
          </h4>

          <p class="text-xs sm:text-sm text-pale-navy leading-relaxed font-light mt-1.5 tooltip-role">
            Global founding headquarters, applied AI labs & core engineering center
          </p>
        </div>

        {/* SVG Canvas where D3 renders vector countries, animated arcs, and pulsing radar pins */}
        <svg id="footprint-vector-svg" class="w-full h-full block select-none"></svg>
      </div>

    </div>
  </div>

  {/* ==================== 3. DISTINCTION BANNER (GLOBAL + FT RANKING) ==================== */}
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    {/* Left: Global Delivery Infrastructure */}
    <div class="lg:col-span-7 rounded-3xl border border-hair bg-white p-8 sm:p-12 shadow-sm flex flex-col justify-between hover:border-smoke hover:shadow-lg transition-all duration-base">
      <div>
        <h4 class="text-2xl sm:text-3xl font-bold text-navy mb-4">
          Global Delivery Infrastructure
        </h4>
        <p class="text-lg text-mid-navy leading-relaxed">
          Founded in India in 2010. Offices in the <strong class="font-bold text-navy">US, UK, Kenya and Bangladesh</strong>, with delivery hubs across Africa and South Asia, providing the sovereign institutional access required to deploy AI at population scale.
        </p>
      </div>

      <div class="mt-8 pt-6 border-t border-hair flex flex-wrap items-center gap-4 text-xs font-bold uppercase tracking-wider text-mid-navy">
        <span class="flex items-center gap-1.5">
          <svg class="h-4 w-4 text-gold" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          Sovereign Data Governance
        </span>
        <span class="flex items-center gap-1.5">
          <svg class="h-4 w-4 text-gold" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          Frontline Field Operations
        </span>
      </div>
    </div>

    {/* Right: Financial Times Ranking Emblem */}
    <div class="lg:col-span-5 rounded-3xl border border-hair bg-white p-8 sm:p-12 shadow-sm flex flex-col justify-between relative overflow-hidden hover:border-smoke hover:shadow-lg transition-all duration-base">
      <div>
        <h4 class="text-2xl sm:text-3xl font-bold text-navy leading-snug">
          FT High-Growth Companies Asia-Pacific
        </h4>

        <p class="text-base text-mid-navy leading-relaxed mt-3">
          Independent verification by the Financial Times and Statista, recognizing verified institutional growth and impact delivery across the Asia-Pacific region.
        </p>
      </div>

      <div class="mt-8 pt-6 border-t border-hair flex items-center gap-2">
        <span class="inline-flex items-center justify-center rounded-lg bg-navy text-white text-xs font-bold px-3 py-1.5">
          2021
        </span>
        <span class="inline-flex items-center justify-center rounded-lg bg-navy text-white text-xs font-bold px-3 py-1.5">
          2022
        </span>
        <span class="inline-flex items-center justify-center rounded-lg bg-navy text-white text-xs font-bold px-3 py-1.5">
          2025
        </span>
      </div>
    </div>
  </div>
</div>

<style>
  .map-node,
  .map-node * {
    outline: none !important;
    -webkit-tap-highlight-color: transparent;
  }

  .map-node.is-active .node-core,
  .map-node:hover .node-core {
    fill: #B3820A;
    stroke: #0A192F;
    stroke-width: 3;
    r: 7.5;
  }
</style>

<script is:inline src="https://cdn.jsdelivr.net/npm/d3@7/dist/d3.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/topojson-client@3/dist/topojson-client.min.js"></script>

<script>
  import { initInteractiveFootprint } from '../scripts/interactiveFootprint';
  initInteractiveFootprint();
  document.addEventListener('astro:page-load', initInteractiveFootprint);
</script>
