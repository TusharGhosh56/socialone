---
// src/components/ArticleArchiveSearch.astro — Clean Magazine Archive with Search (matches reference layout)
import { Image } from 'astro:assets';
import type { Article } from '../data/insights';

interface Props {
  articles: Article[];
}

const { articles } = Astro.props;
---

<div class="space-y-8 sm:space-y-10" data-archive-root>
  {/* Header + Search Bar Row (exact match to reference screenshot) */}
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4">
    <h2 class="text-2xl sm:text-3xl font-normal text-navy tracking-tight">
      From the archive
    </h2>

    {/* Search Input Box */}
    <div class="relative w-full sm:w-80">
      <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-navy/40">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </div>
      <input
        type="text"
        id="archive-search-input"
        data-archive-search
        placeholder="Search by title or topic..."
        aria-label="Search articles"
        class="w-full rounded-xl border border-hair bg-white/90 pl-10 pr-9 py-2 text-sm text-navy placeholder:text-mid-navy/50 focus:border-gold focus:outline-none focus:ring-1 focus:ring-gold/30 shadow-sm transition-all"
      />
      <button
        type="button"
        id="archive-search-clear"
        data-search-clear
        aria-label="Clear search"
        class="hidden absolute inset-y-0 right-0 flex items-center pr-3 text-navy/40 hover:text-navy cursor-pointer"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  {/* 3-Column Clean Magazine Articles Grid */}
  <div
    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8"
    id="articles-grid"
    data-articles-grid
  >
    {articles.map((article) => (
      <article
        class="article-card group flex flex-col justify-between rounded-2xl border border-hair bg-white p-5 sm:p-6 shadow-sm hover:shadow-md hover:border-gold/40 transition-all duration-300"
        data-article-card
        data-search-corpus={`${article.title} ${article.excerpt} ${article.author.name}`.toLowerCase()}
      >
        <div>
          {/* Clean Card Image (no chips/badges on top) */}
          <div class="relative aspect-[16/10] w-full rounded-xl overflow-hidden bg-navy/5 mb-4">
            <Image
              src={article.image}
              alt={article.title}
              class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
              loading="eager"
            />
          </div>

          {/* Date */}
          <p class="text-eyebrow font-bold uppercase tracking-[0.14em] text-mid-navy/70 mb-2">
            {article.formattedDate}
          </p>

          {/* Title */}
          <h3 class="text-lg sm:text-xl font-bold text-navy group-hover:text-deep-gold transition-colors leading-snug mb-2.5 line-clamp-2">
            {article.title}
          </h3>

          {/* Excerpt */}
          <p class="text-xs sm:text-small text-mid-navy leading-relaxed line-clamp-3 mb-4">
            {article.excerpt}
          </p>
        </div>

        {/* Author Byline */}
        <div class="flex items-center gap-3 pt-4 border-t border-hair/60 mt-2">
          {article.author.avatar ? (
            <div class="h-8 w-8 rounded-full overflow-hidden border border-hair bg-navy/10 shrink-0">
              <Image
                src={article.author.avatar}
                alt={article.author.name}
                class="h-full w-full object-cover"
              />
            </div>
          ) : (
            <div class="h-8 w-8 rounded-full bg-pale-navy flex items-center justify-center text-xs font-bold text-navy shrink-0">
              {article.author.name.slice(0, 2).toUpperCase()}
            </div>
          )}
          <p class="text-xs font-semibold text-navy truncate">{article.author.name}</p>
        </div>
      </article>
    ))}
  </div>

  {/* Empty Results State */}
  <div
    id="archive-empty-state"
    class="hidden text-center py-16 px-4 rounded-2xl border border-dashed border-hair bg-white/60"
  >
    <p class="text-sm font-semibold text-navy">No articles match your search</p>
    <button
      type="button"
      id="archive-reset-filters"
      class="mt-3 text-xs font-bold text-deep-gold hover:underline cursor-pointer"
    >
      Clear search
    </button>
  </div>
</div>

<script>
  function initArchiveSearch() {
    const root = document.querySelector('[data-archive-root]');
    if (!root) return;

    const input = root.querySelector<HTMLInputElement>('[data-archive-search]');
    const clearBtn = root.querySelector<HTMLButtonElement>('[data-search-clear]');
    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-article-card]'));
    const emptyState = root.querySelector<HTMLElement>('#archive-empty-state');
    const resetBtn = root.querySelector<HTMLButtonElement>('#archive-reset-filters');

    function filterCards() {
      let visibleCount = 0;
      const q = (input?.value || '').trim().toLowerCase();

      cards.forEach((card) => {
        const corpus = card.dataset.searchCorpus || '';
        const matchesQuery = !q || corpus.includes(q);

        if (matchesQuery) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (emptyState) {
        if (visibleCount === 0) {
          emptyState.classList.remove('hidden');
        } else {
          emptyState.classList.add('hidden');
        }
      }

      if (clearBtn) {
        if (q.length > 0) {
          clearBtn.classList.remove('hidden');
        } else {
          clearBtn.classList.add('hidden');
        }
      }
    }

    input?.addEventListener('input', filterCards);

    clearBtn?.addEventListener('click', () => {
      if (input) input.value = '';
      filterCards();
      input?.focus();
    });

    resetBtn?.addEventListener('click', () => {
      if (input) input.value = '';
      filterCards();
    });
  }

  initArchiveSearch();
  document.addEventListener('astro:page-load', initArchiveSearch);
</script>
