const columns = [
  {
    title: 'About APLYD',
    links: [
      { label: 'Built for Government', href: '/about/built-for-government' },
      { label: '16 Years of Proof', href: '/about/16-years-of-proof' },
      { label: 'Purpose & Direction', href: '/about/purpose-and-direction' },
      { label: 'How We Work', href: '/about/how-we-work' },
      { label: 'Our Team', href: '/about/people' },
      { label: 'Our Partners', href: '/about/our-partners' },
    ],
  },
  {
    title: 'Services',
    links: [
      { label: 'Our Approach', href: '/services/our-approach' },
      { label: 'For Government', href: '/services/our-capabilities/government' },
      { label: 'For Nonprofits', href: '/services/our-capabilities/nonprofits' },
      { label: 'For Philanthropy', href: '/services/our-capabilities/philanthropy' },
    ],
  },
  {
    title: 'Explore',
    links: [
      { label: 'AI in Action', href: '/ai-in-action' },
      { label: 'Careers', href: '/careers' },
      { label: 'The Athena Group', href: 'https://www.athenainfonomics.com/' },
      { label: 'Get In Touch', href: '/contact' },
    ],
  },
];
---

<footer class="gradient-navy gradient-sheen text-pale-navy" data-footer>
  <div class="container-x relative py-16 sm:py-20">
    <!-- Wordmark + Explore/Company, side by side (not stacked — see this
         file's own header comment) — deliberately kept as its own row
         rather than sharing a width constraint with the base row below,
         same reasoning as before: the base row needs the rest of
         container-x's own width to lay its text out on one line at sm+.
         gap-x-20/gap-y-12 (up from 16/10) per explicit "a bit more space"
         request. Each of this footer's 3 blocks (this row, the base row,
         the big mark) gets its own Reveal, staggered, same fade+rise-in-on-
         viewport-entry convention used everywhere else on this page. -->
    <Reveal class="flex flex-wrap items-start gap-x-20 gap-y-12">
      <a href="/" aria-label="APLYD — home" class="block shrink-0">
        <span class="block h-[76px] w-auto [&>svg]:h-[76px] [&>svg]:w-auto" set:html={wordmarkWhite} />
      </a>
      {
        columns.map((col) => (
          <nav aria-label={col.title}>
            <p class="text-eyebrow font-bold uppercase tracking-[0.14em] text-gold">{col.title}</p>
            <ul class="mt-4 space-y-3">
              {col.links.map((l) => {
                const external = l.href.startsWith('http');
                return (
                  <li>
                    <a
                      href={linkHref(l.href)}
                      target={external ? '_blank' : undefined}
                      rel={external ? 'noopener noreferrer' : undefined}
                      class="text-pale-navy no-underline transition-colors duration-micro hover:text-gold"
                    >
                      {l.label}
                    </a>
                  </li>
                );
              })}
            </ul>
          </nav>
        ))
      }
    </Reveal>

    <!-- base row — LinkedIn ahead of the copyright text, on the same line
         at sm+; width is capped by footerMark.ts once the big logomark's
         own real size is known, so this never runs under it. -->
    <Reveal
      delay={140}
      class="mt-14 flex flex-col gap-3.5 border-t border-white/12 pt-6 text-small text-pale-navy/70 sm:flex-row sm:items-center sm:gap-4 flex-wrap"
      data-footer-base
    >
      <ul class="flex items-center gap-2 sm:gap-2.5 flex-wrap">
        {
          socials
            .filter((s) => s.active)
            .map((s) => (
              <li>
                <a
                  href={s.href}
                  aria-label={s.label}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex h-9 w-9 items-center justify-center rounded-full border border-white/15 text-pale-navy no-underline transition-colors duration-base ease-out hover:border-gold hover:text-gold"
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d={s.path} />
                  </svg>
                </a>
              </li>
            ))
        }
      </ul>
      <span>APLYD · By Athena Infonomics</span>
      <span aria-hidden="true" class="hidden sm:inline">|</span>
      <span>© 2026</span>
      <span aria-hidden="true" class="hidden sm:inline">|</span>
      <span>FT High-Growth Asia-Pacific · 2021 · 2022 · 2025</span>
    </Reveal>

    <!-- Big standalone logomark, bottom-right — hidden below sm (not enough
         room to keep it clear of the base row's text at that width).
         Height set by footerMark.ts to exactly 60% of the footer's own real
         rendered height; width follows automatically from the SVG's own
         viewBox aspect ratio (height:100%/width:auto below). Reveal's own
         translateY only shifts it vertically pre-reveal, so footerMark.ts's
         horizontal (left-edge) measurements stay correct either way. -->
    <Reveal
      as="span"
      delay={60}
      class="footer-mark absolute bottom-0 right-0 hidden w-auto sm:block"
      data-footer-mark
      aria-hidden="true"
    >
      <span class="block h-full w-auto" set:html={markWhite} />
    </Reveal>
  </div>
</footer>

<style>
  .footer-mark {
    pointer-events: none;
  }
  .footer-mark :global(svg) {
    display: block;
    height: 100%;
    width: auto;
  }
</style>

<script>
  import { initFooterMark } from '../scripts/footerMark';
  initFooterMark();
</script>
