---
// Footer (§6.2, §9) — on deep-navy. White wordmark (90% bigger than the
// original footer size, per explicit product decision — h-[76px], was h-10)
// with Explore/Company to its RIGHT (not below — an earlier version of this
// redesign stacked them below the wordmark, then a follow-up request moved
// them beside it instead), plus a big standalone logomark anchored bottom-
// right (see src/scripts/footerMark.ts — sized to exactly 60% of the
// footer's own real height via JS measurement, not a clamp() guess; was
// 1/3 in the original version of this redesign). The old "What We Do"
// column and the "Get in touch / Partner with APLYD" block under the
// wordmark are both gone; the LinkedIn icon moved into the base row.
// (Vision & Mission moved out of here earlier — now its own section right
// after FlowChart — see index.astro; that section was later removed
// entirely, unrelated to this footer redesign.)
import Reveal from './Reveal.astro';
import wordmarkWhite from '../assets/logos/aplyd-wordmark-white.svg?raw';
import markWhite from '../assets/logos/aplyd-mark-white.svg?raw';

// Same helper as Header.astro's own: any '#'-style in-page anchor (About
// Us's #top, Case Studies' #ai-in-action) only resolves on the homepage —
// off it (e.g. /contact), it gets the homepage's own path prepended so it
// navigates there and jumps to the right section, instead of doing nothing.
const isHome = Astro.url.pathname === '/';
const linkHref = (href: string) => (isHome || !href.startsWith('#') ? href : `/${href}`);

