---
// CaseStudyDossier.astro — Full-Bleed Editorial Case Study Briefing with Bain-Style Vector Artwork
import type { CaseStudyItem } from '../data/caseStudies';
import GoldWaveform from './GoldWaveform.astro';
import CaseStudyVectorGraphic from './CaseStudyVectorGraphic.astro';

interface Props {
  caseStudy: CaseStudyItem;
  index: number;
  total: number;
}

const { caseStudy, index, total } = Astro.props;
---

<article class={`case-study-editorial case-study-editorial-${index} relative py-12 sm:py-16 first:pt-4 last:pb-6 border-b border-hair/90 last:border-b-0 space-y-12 transition-colors duration-500`} data-dossier-index={index} id={`dossier-${caseStudy.id}`}>
  {/* Header Meta & Title Block with Bain-Style Vector Artwork */}
  <div class="dossier-header-block space-y-8" id={`dossier-header-${caseStudy.id}`}>
    <div class="flex flex-wrap items-center justify-between gap-4 pb-4 border-b border-hair">
      <div class="flex items-center gap-3 text-xs font-bold uppercase tracking-[0.16em] text-gold">
        <span class="dossier-pill-badge flex items-center gap-1.5 px-3 py-1 rounded-full bg-pale-navy border border-hair text-navy font-bold">
          <span class="h-1.5 w-1.5 rounded-full bg-gold"></span>
          FIELD DOSSIER
        </span>
        {total > 1 && <span class="text-ash font-normal">/ {caseStudy.sector}</span>}
        <span class="text-hair">•</span>
        <span class="text-navy">{caseStudy.client}</span>
      </div>

      <div class="flex items-center gap-2 text-xs font-bold text-mid-navy uppercase tracking-widest bg-pale-navy/60 px-3.5 py-1 rounded-full border border-hair/60">
        <svg class="h-3.5 w-3.5 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>{caseStudy.geography}</span>
      </div>
    </div>

    {/* Editorial Split: Title & Summary (Left) + Bain-Style Brand Vector (Right) */}
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      <div class="lg:col-span-7 space-y-6">
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-light text-navy leading-[1.12] tracking-tight">
          {caseStudy.title}
        </h2>

        <p class="text-xl sm:text-2xl text-mid-navy font-normal leading-relaxed">
          {caseStudy.summary}
        </p>
      </div>

      {/* Bespoke Bain-Style Vector Graphic Artwork Frame */}
      <div class="lg:col-span-5">
        <div class="rounded-3xl border border-hair/90 bg-white/80 p-2 sm:p-2.5 shadow-xl group hover:border-gold/50 transition-all duration-500">
          <CaseStudyVectorGraphic id={caseStudy.id} class="w-full h-auto" />
        </div>
      </div>
    </div>
  </div>

  {/* Structured Metadata Ribbon (Clean Horizontal Table) */}
  <div class="dossier-ribbon-block grid grid-cols-2 md:grid-cols-4 gap-6 p-6 sm:p-8 rounded-2xl border border-hair bg-white/70 backdrop-blur-sm transition-all duration-500 shadow-sm" id={`dossier-ribbon-${caseStudy.id}`}>
    <div class="space-y-1">
      <span class="text-[0.68rem] uppercase font-bold tracking-[0.14em] text-ash block">Client / Partner</span>
      <span class="text-base font-bold text-navy block">{caseStudy.client}</span>
    </div>

    <div class="space-y-1">
      <span class="text-[0.68rem] uppercase font-bold tracking-[0.14em] text-ash block">Sector</span>
      <span class="text-base font-semibold text-navy block">{caseStudy.sector}</span>
    </div>

    <div class="space-y-1">
      <span class="text-[0.68rem] uppercase font-bold tracking-[0.14em] text-ash block">Capabilities</span>
      <span class="text-base font-semibold text-navy block">{caseStudy.capabilities}</span>
    </div>

    <div class="space-y-1">
      <span class="text-[0.68rem] uppercase font-bold tracking-[0.14em] text-ash block">Engagement Type</span>
      <span class="text-base font-semibold text-navy block">{caseStudy.type}</span>
    </div>
  </div>

  {/* 3-Act Narrative Breakdown */}
  <div class="space-y-10 pt-2">
    {/* Grid for Context & What We Did */}
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-stretch">
      {/* Context */}
      <div class="dossier-context-box rounded-2xl border border-hair bg-white/90 p-7 sm:p-9 shadow-sm flex flex-col justify-between transition-all duration-500" id={`dossier-context-${caseStudy.id}`}>
        <div class="space-y-4">
          <div class="flex items-center gap-2 pb-3 border-b border-hair/70">
            <span class="h-2 w-2 rounded-full bg-gold"></span>
            <h3 class="text-lg font-bold uppercase tracking-wider text-navy">Operational Context</h3>
          </div>
          <p class="text-base sm:text-lg text-mid-navy leading-relaxed font-normal">
            {caseStudy.context}
          </p>
        </div>
      </div>

      {/* What We Did */}
      <div class="dossier-delivery-box rounded-2xl border border-hair bg-white/90 p-7 sm:p-9 shadow-sm flex flex-col justify-between transition-all duration-500" id={`dossier-delivery-${caseStudy.id}`}>
        <div class="space-y-4">
          <div class="flex items-center gap-2 pb-3 border-b border-hair/70">
            <span class="h-2 w-2 rounded-full bg-gold"></span>
            <h3 class="text-lg font-bold uppercase tracking-wider text-navy">Institutional Delivery</h3>
          </div>
          <p class="text-base sm:text-lg text-mid-navy leading-relaxed font-normal">
            {caseStudy.whatWeDid}
          </p>
        </div>
      </div>
    </div>

    {/* Why It Matters (Full-Width Impact Callout) */}
    <div class="dossier-impact-box rounded-3xl gradient-navy-mesh gradient-sheen text-white p-8 sm:p-12 lg:p-14 shadow-lg space-y-4 relative overflow-hidden card-hover-accent transition-all duration-500" id={`dossier-impact-${caseStudy.id}`}>
      <GoldWaveform alpha="1.1" />

      <div class="relative z-10 space-y-3">
        <div class="flex items-center gap-2">
          <span class="h-2 w-2 rounded-full bg-gold"></span>
          <h3 class="text-xl sm:text-2xl font-bold text-white tracking-tight">
            Public Value & Lasting Impact
          </h3>
        </div>
        <p class="text-base sm:text-xl text-pale-navy font-normal leading-relaxed max-w-4xl pt-1">
          {caseStudy.whyItMatters}
        </p>
      </div>
    </div>
  </div>
</article>
