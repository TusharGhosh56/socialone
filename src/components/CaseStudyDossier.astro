---
// CaseStudyDossier.astro — Full-Bleed Editorial Case Study Briefing with Real Case Study Photography
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { CaseStudyItem } from '../data/caseStudies';
import GoldWaveform from './GoldWaveform.astro';

import img01 from '../assets/images/cases/01-agriculture-india.jpg';
import img02 from '../assets/images/cases/02-education-evaluation-india.jpg';
import img03 from '../assets/images/cases/03-education-mexico.jpg';
import img04 from '../assets/images/cases/04-msme.jpg';
import img05 from '../assets/images/cases/05-farmer.jpg';
import img06 from '../assets/images/cases/06-learning.jpg';
import img07 from '../assets/images/cases/07-skilling.jpg';
import img08 from '../assets/images/cases/08-agriculture-systems.jpg';
import waterUtilityImg from '../assets/images/cases/water-utility.jpg';
import msmeAiImg from '../assets/images/cases/ai-msme.png';
import transformImg from '../assets/images/cases/transform.jpg';

interface Props {
  caseStudy: CaseStudyItem;
  index: number;
  total: number;
}

const { caseStudy, index, total } = Astro.props;

const caseImages: Record<string, ImageMetadata> = {
  'oral-reading-fluency': img02,
  'andhra-pradesh-rythu-seva': img01,
  'farmer-centric-data-governance': img05,
  'india-msme-adoption': msmeAiImg,
  'water-utilities-sandbox': waterUtilityImg,
  'kampala-citizen-assistant': transformImg,
  'mel-evidence-portal': img06,
  'agrifood-systems-evaluation': img08,
};

const caseImage = caseImages[caseStudy.id] || img01;
---

<article class={`case-study-editorial case-study-editorial-${index} relative py-8 sm:py-14 lg:py-16 first:pt-2 sm:first:pt-4 last:pb-6 border-b border-hair/90 last:border-b-0 space-y-6 sm:space-y-12 transition-colors duration-500`} data-dossier-index={index} id={`dossier-${caseStudy.id}`}>
  {/* Header Title Block with High-Resolution Editorial Photography */}
  <div class="dossier-header-block space-y-4 sm:space-y-8" id={`dossier-header-${caseStudy.id}`}>
    {/* Editorial Split: Title & Summary (Left) + Full-Bleed Photograph (Right) */}
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-12 items-center">
      <div class="lg:col-span-7 space-y-3 sm:space-y-6">
        <h2 class="text-2xl sm:text-4xl lg:text-5xl font-light text-navy leading-[1.12] tracking-tight">
          {caseStudy.title}
        </h2>

        <p class="text-base sm:text-2xl text-mid-navy font-normal leading-relaxed text-pretty">
          {caseStudy.summary}
        </p>
      </div>

      {/* Real High-Resolution Photographic Frame */}
      <div class="lg:col-span-5">
        <div class="relative w-full aspect-[16/10] sm:aspect-[16/10] rounded-2xl sm:rounded-3xl border border-hair/90 overflow-hidden shadow-xl group hover:border-gold/50 transition-all duration-500 bg-navy/5">
          <Image
            src={caseImage}
            alt={caseStudy.title}
            class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
            widths={[500, 800, 1100]}
            sizes="(min-width: 1024px) 42vw, 100vw"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-navy/30 via-transparent to-transparent pointer-events-none"></div>
        </div>
      </div>
    </div>
  </div>

  {/* Structured Metadata Ribbon (Clean Horizontal Table) */}
  <div class="dossier-ribbon-block grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-6 p-4 sm:p-8 rounded-2xl border border-hair bg-white/70 backdrop-blur-sm transition-all duration-500 shadow-sm" id={`dossier-ribbon-${caseStudy.id}`}>
    <div class="space-y-0.5 sm:space-y-1">
      <span class="text-[0.625rem] sm:text-[0.68rem] uppercase font-bold tracking-[0.14em] text-ash block">Client / Partner</span>
      <span class="text-xs sm:text-base font-bold text-navy block">{caseStudy.client}</span>
    </div>

    <div class="space-y-0.5 sm:space-y-1">
      <span class="text-[0.625rem] sm:text-[0.68rem] uppercase font-bold tracking-[0.14em] text-ash block">Sector</span>
      <span class="text-xs sm:text-base font-semibold text-navy block">{caseStudy.sector}</span>
    </div>

    <div class="space-y-0.5 sm:space-y-1">
      <span class="text-[0.625rem] sm:text-[0.68rem] uppercase font-bold tracking-[0.14em] text-ash block">Capabilities</span>
      <span class="text-xs sm:text-base font-semibold text-navy block">{caseStudy.capabilities}</span>
    </div>

    <div class="space-y-0.5 sm:space-y-1">
      <span class="text-[0.625rem] sm:text-[0.68rem] uppercase font-bold tracking-[0.14em] text-ash block">Engagement Type</span>
      <span class="text-xs sm:text-base font-semibold text-navy block">{caseStudy.type}</span>
    </div>
  </div>

  {/* 3-Act Narrative Breakdown */}
  <div class="space-y-5 sm:space-y-10 pt-1 sm:pt-2">
    {/* Grid for Context & What We Did */}
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 sm:gap-8 lg:gap-12 items-stretch">
      {/* Context */}
      <div class="dossier-context-box rounded-2xl border border-hair bg-white/90 p-4.5 sm:p-7 lg:p-9 shadow-sm flex flex-col justify-between transition-all duration-500" id={`dossier-context-${caseStudy.id}`}>
        <div class="space-y-2.5 sm:space-y-4">
          <div class="flex items-center gap-2 pb-2 sm:pb-3 border-b border-hair/70">
            <span class="h-1.5 w-1.5 sm:h-2 sm:w-2 rounded-full bg-gold"></span>
            <h3 class="text-sm sm:text-lg font-bold uppercase tracking-wider text-navy">Operational Context</h3>
          </div>
          <p class="text-xs sm:text-base lg:text-lg text-mid-navy leading-relaxed font-normal text-pretty">
            {caseStudy.context}
          </p>
        </div>
      </div>

      {/* What We Did */}
      <div class="dossier-delivery-box rounded-2xl border border-hair bg-white/90 p-4.5 sm:p-7 lg:p-9 shadow-sm flex flex-col justify-between transition-all duration-500" id={`dossier-delivery-${caseStudy.id}`}>
        <div class="space-y-2.5 sm:space-y-4">
          <div class="flex items-center gap-2 pb-2 sm:pb-3 border-b border-hair/70">
            <span class="h-1.5 w-1.5 sm:h-2 sm:w-2 rounded-full bg-gold"></span>
            <h3 class="text-sm sm:text-lg font-bold uppercase tracking-wider text-navy">Institutional Delivery</h3>
          </div>
          <p class="text-xs sm:text-base lg:text-lg text-mid-navy leading-relaxed font-normal text-pretty">
            {caseStudy.whatWeDid}
          </p>
        </div>
      </div>
    </div>

    {/* Why It Matters (Full-Width Impact Callout) */}
    <div class="dossier-impact-box rounded-2xl sm:rounded-3xl gradient-navy-mesh gradient-sheen text-white p-5 sm:p-10 lg:p-14 shadow-lg space-y-3 sm:space-y-4 relative overflow-hidden card-hover-accent transition-all duration-500" id={`dossier-impact-${caseStudy.id}`}>
      <GoldWaveform alpha="1.1" />

      <div class="relative z-10 space-y-2 sm:space-y-3">
        <div class="flex items-center gap-2">
          <span class="h-1.5 w-1.5 sm:h-2 sm:w-2 rounded-full bg-gold"></span>
          <h3 class="text-lg sm:text-2xl font-bold text-white tracking-tight">
            Public Value & Lasting Impact
          </h3>
        </div>
        <p class="text-xs sm:text-xl text-pale-navy font-normal leading-relaxed max-w-4xl pt-0.5 sm:pt-1 text-pretty">
          {caseStudy.whyItMatters}
        </p>
      </div>
    </div>
  </div>
</article>
