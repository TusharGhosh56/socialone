---
// CaseStudyVectorGraphic.astro — Bespoke Bain-Style Editorial Vector Imagery for APLYD Case Studies
interface Props {
  id: string;
  category?: string;
  class?: string;
  variant?: 'hero' | 'card' | 'compact';
}

const { id, category = 'education', class: className = '', variant = 'card' } = Astro.props;
---

<div class={`case-vector-graphic relative w-full overflow-hidden select-none group/vector ${className}`} data-vector-id={id}>
  {/* Vector Background Gradient & Grid Canvas */}
  <div class="vector-backdrop absolute inset-0 bg-gradient-to-br from-[#0b0e2b] via-[#12173b] to-[#1e2555] opacity-95 transition-opacity duration-500 group-hover/vector:opacity-100"></div>
  
  {/* Institutional Precision Datum Grid */}
  <div class="vector-grid-pattern absolute inset-0 pointer-events-none opacity-25"></div>

  {/* Ambient Atmospheric Radial Glows */}
  <div class="vector-glow-gold absolute -top-10 -right-10 w-40 h-40 rounded-full bg-gold/20 blur-2xl pointer-events-none transition-transform duration-700 group-hover/vector:scale-125"></div>
  <div class="vector-glow-cyan absolute -bottom-10 -left-10 w-40 h-40 rounded-full bg-sky-500/15 blur-2xl pointer-events-none transition-transform duration-700 group-hover/vector:scale-125"></div>

  {/* =========================================================================
      1. ORAL READING FLUENCY (Wadhwani AI / Education)
      Theme: Acoustic Speech Waveforms, Hindi/Gujarati Phoneme Matrix, Bias Scale
      ========================================================================= */}
  {id === 'oral-reading-fluency' && (
    <svg class="relative z-10 w-full h-full" viewBox="0 0 600 340" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="goldGrad-orf" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#F5E9D1" />
          <stop offset="50%" stop-color="#D19C33" />
          <stop offset="100%" stop-color="#996E1D" />
        </linearGradient>
        <linearGradient id="cyanGrad-orf" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#38BDF8" stop-opacity="0.9" />
          <stop offset="100%" stop-color="#0EA5E9" stop-opacity="0.3" />
        </linearGradient>
        <filter id="glow-orf" x="-20%" y="-20%" width="140%" height="140%">
          <feGaussianBlur stdDeviation="6" result="blur" />
          <feComposite in="SourceGraphic" in2="blur" operator="over" />
        </filter>
      </defs>

      {/* Concentric Telemetry Circles */}
      <circle cx="300" cy="170" r="130" stroke="#4A538A" stroke-width="1" stroke-dasharray="4 6" opacity="0.35" />
      <circle cx="300" cy="170" r="95" stroke="#D19C33" stroke-width="1" stroke-dasharray="2 4" opacity="0.45" />

      {/* Acoustic Spectrogram Wave Matrix (Audio Evaluation) */}
      <g opacity="0.85">
        {[20, 45, 75, 110, 85, 130, 95, 140, 105, 80, 120, 90, 60, 40, 70, 100, 125, 90, 50, 30].map((h, i) => {
          const x = 110 + i * 20;
          return (
            <rect
              x={x}
              y={170 - h / 2}
              width="6"
              height={h}
              rx="3"
              fill={i % 3 === 0 ? "url(#goldGrad-orf)" : i % 2 === 0 ? "url(#cyanGrad-orf)" : "#E8ECF4"}
              opacity={0.75 + (i % 3) * 0.1}
              class="transition-transform duration-500 hover:scale-y-110"
            />
          );
        })}
      </g>

      {/* Continuous Audio Sine Waves */}
      <path d="M 60 170 Q 120 70, 180 170 T 300 170 T 420 170 T 540 170" stroke="url(#goldGrad-orf)" stroke-width="2.5" fill="none" opacity="0.8" />
      <path d="M 60 170 Q 120 250, 180 170 T 300 170 T 420 170 T 540 170" stroke="url(#cyanGrad-orf)" stroke-width="1.8" fill="none" opacity="0.5" stroke-dasharray="6 3" />

      {/* Central Algorithmic Assurance Lens / Phoneme Node */}
      <g transform="translate(300, 170)" filter="url(#glow-orf)">
        <circle cx="0" cy="0" r="32" fill="#0B0E2B" stroke="#D19C33" stroke-width="2" />
        <circle cx="0" cy="0" r="22" fill="#1A2150" stroke="#38BDF8" stroke-width="1" />
        {/* Phoneme Wave Icon */}
        <path d="M -10 0 L -5 -8 L 0 8 L 5 -5 L 10 0" stroke="#F5E9D1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        {/* Verification Check Badge */}
        <circle cx="16" cy="-16" r="9" fill="#D19C33" />
        <path d="M 13 -16 L 15.5 -13.5 L 20 -18" stroke="#0B0E2B" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
      </g>

      {/* Evaluation Metadata Callouts */}
      <g transform="translate(80, 50)">
        <rect x="0" y="0" width="140" height="28" rx="6" fill="#12173B" stroke="#4A538A" stroke-width="1" opacity="0.85" />
        <text x="12" y="18" fill="#F5E9D1" font-size="10" font-family="monospace" font-weight="bold">8,000+ SAMPLES</text>
      </g>
      <g transform="translate(380, 260)">
        <rect x="0" y="0" width="150" height="28" rx="6" fill="#12173B" stroke="#D19C33" stroke-width="1" opacity="0.85" />
        <text x="12" y="18" fill="#38BDF8" font-size="10" font-family="monospace" font-weight="bold">HINDI // GUJARATI</text>
      </g>
    </svg>
  )}

  {/* =========================================================================
      2. ANDHRA PRADESH RYTHU SEVA (Agriculture / Govt)
      Theme: Agritech Spatial Contours, Crop Health Matrix, Smallholder Advisory Hub
      ========================================================================= */}
  {id === 'andhra-pradesh-rythu-seva' && (
    <svg class="relative z-10 w-full h-full" viewBox="0 0 600 340" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="goldGrad-ap" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#F5E9D1" />
          <stop offset="50%" stop-color="#D19C33" />
          <stop offset="100%" stop-color="#845D14" />
        </linearGradient>
        <linearGradient id="greenGrad-ap" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#4ADE80" />
          <stop offset="100%" stop-color="#15803D" />
        </linearGradient>
      </defs>

      {/* Field Plot Isometric Contours */}
      <g opacity="0.4" stroke="#4A538A" stroke-width="1">
        <path d="M 100 240 L 300 300 L 500 240 L 300 180 Z" fill="#12173B" fill-opacity="0.5" />
        <path d="M 140 210 L 300 260 L 460 210 L 300 160 Z" fill="#1A2150" fill-opacity="0.4" />
        <path d="M 180 180 L 300 220 L 420 180 L 300 140 Z" fill="#232B65" fill-opacity="0.3" />
      </g>

      {/* Spatial Precision Grid Telemetry */}
      {[[220, 200], [300, 230], [380, 200], [260, 240], [340, 240]].map(([cx, cy], i) => (
        <g transform={`translate(${cx}, ${cy})`}>
          <circle cx="0" cy="0" r="4" fill="#D19C33" />
          <circle cx="0" cy="0" r="10" stroke="#D19C33" stroke-width="0.75" stroke-dasharray="2 2" opacity="0.6" />
          <line x1="0" y1="0" x2="0" y2="-30" stroke="#D19C33" stroke-width="1" stroke-dasharray="2 2" />
        </g>
      ))}

      {/* Central Rythu Seva Advisory Hub Nexus */}
      <g transform="translate(300, 110)">
        {/* Hexagonal Hub Foundation */}
        <polygon points="0,-45 39,-22 39,22 0,45 -39,22 -39,-22" fill="#0B0E2B" stroke="url(#goldGrad-ap)" stroke-width="2" />
        <polygon points="0,-35 30,-17 30,17 0,35 -30,17 -30,-17" fill="#1A2150" stroke="#38BDF8" stroke-width="1" />
        {/* Sprouting Agritech Node */}
        <path d="M 0 15 Q -12 -5, -12 -18 Q -12 -28, 0 -28 Q 12 -28, 12 -18 Q 12 -5, 0 15 Z" fill="url(#greenGrad-ap)" />
        <path d="M 0 12 L 0 -22" stroke="#F5E9D1" stroke-width="1.5" />
        
        {/* Signal Broadcast Waves */}
        <circle cx="0" cy="-28" r="8" stroke="#F5E9D1" stroke-width="1" opacity="0.8" />
        <circle cx="0" cy="-28" r="16" stroke="#D19C33" stroke-width="1" stroke-dasharray="2 3" opacity="0.6" />
      </g>

      {/* Connecting Data Channels to Field Centers */}
      <path d="M 120 100 L 260 110 M 480 100 L 340 110" stroke="url(#goldGrad-ap)" stroke-width="1.5" stroke-dasharray="4 4" />

      {/* Callout Badges */}
      <g transform="translate(60, 80)">
        <rect x="0" y="0" width="130" height="26" rx="6" fill="#12173B" stroke="#4ADE80" stroke-width="1" opacity="0.85" />
        <text x="12" y="17" fill="#4ADE80" font-size="10" font-family="monospace" font-weight="bold">RYTHU SEVA // RSK</text>
      </g>
      <g transform="translate(410, 70)">
        <rect x="0" y="0" width="130" height="26" rx="6" fill="#12173B" stroke="#D19C33" stroke-width="1" opacity="0.85" />
        <text x="12" y="17" fill="#F5E9D1" font-size="10" font-family="monospace" font-weight="bold">AI ADVISORY GRID</text>
      </g>
    </svg>
  )}

  {/* =========================================================================
      3. FARMER-CENTRIC DATA GOVERNANCE (Gates Foundation / Agriculture)
      Theme: Sovereign Data Vault, Cryptographic Consent Ring, Farmer Rights Ledger
      ========================================================================= */}
  {id === 'farmer-centric-data-governance' && (
    <svg class="relative z-10 w-full h-full" viewBox="0 0 600 340" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="shieldGrad-fc" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#D19C33" />
          <stop offset="100%" stop-color="#1A2150" />
        </linearGradient>
      </defs>

      {/* Concentric Protection Orbits */}
      <circle cx="300" cy="170" r="120" stroke="#4A538A" stroke-width="1" stroke-dasharray="6 6" opacity="0.4" />
      <circle cx="300" cy="170" r="85" stroke="#D19C33" stroke-width="1.5" opacity="0.6" />

      {/* Orbiting Consent & Rights Nodes */}
      {[0, 60, 120, 180, 240, 300].map((deg) => {
        const rad = (deg * Math.PI) / 180;
        const x = 300 + 120 * Math.cos(rad);
        const y = 170 + 120 * Math.sin(rad);
        return (
          <g transform={`translate(${x}, ${y})`}>
            <circle cx="0" cy="0" r="8" fill="#12173B" stroke="#38BDF8" stroke-width="1.5" />
            <circle cx="0" cy="0" r="3" fill="#D19C33" />
          </g>
        );
      })}

      {/* Central Sovereign Data Shield / Vault */}
      <g transform="translate(300, 170)">
        <path d="M 0 -50 L 40 -30 L 40 15 Q 40 45, 0 60 Q -40 45, -40 15 L -40 -30 Z" fill="#0B0E2B" stroke="#D19C33" stroke-width="2.5" />
        <path d="M 0 -40 L 30 -24 L 30 12 Q 30 35, 0 48 Q -30 35, -30 12 L -30 -24 Z" fill="#1A2150" stroke="#38BDF8" stroke-width="1" opacity="0.8" />
        {/* Keyhole / Trust Emblem */}
        <circle cx="0" cy="-5" r="8" fill="#F5E9D1" />
        <path d="M -4 0 L 4 0 L 6 16 L -6 16 Z" fill="#F5E9D1" />
      </g>

      <g transform="translate(90, 60)">
        <rect x="0" y="0" width="135" height="26" rx="6" fill="#12173B" stroke="#D19C33" stroke-width="1" opacity="0.9" />
        <text x="12" y="17" fill="#F5E9D1" font-size="10" font-family="monospace" font-weight="bold">CONSENT PROTOCOL</text>
      </g>
      <g transform="translate(380, 250)">
        <rect x="0" y="0" width="145" height="26" rx="6" fill="#12173B" stroke="#38BDF8" stroke-width="1" opacity="0.9" />
        <text x="12" y="17" fill="#38BDF8" font-size="10" font-family="monospace" font-weight="bold">FARMER VALUE SHARE</text>
      </g>
    </svg>
  )}

  {/* =========================================================================
      4. INDIA MSME ADOPTION (MeitY, IndiaAI Mission)
      Theme: Smart Factory Isometric Prisms, AI Readiness Quadrant, Phased Roadmap
      ========================================================================= */}
  {id === 'india-msme-adoption' && (
    <svg class="relative z-10 w-full h-full" viewBox="0 0 600 340" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="goldGrad-msme" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#F5E9D1" />
          <stop offset="100%" stop-color="#D19C33" />
        </linearGradient>
      </defs>

      {/* Isometric Manufacturing Steps / Adoption Staircase */}
      <g opacity="0.85">
        {/* Step 1: Baseline */}
        <polygon points="120,230 200,190 200,240 120,280" fill="#12173B" stroke="#4A538A" stroke-width="1" />
        <polygon points="120,230 200,190 280,230 200,270" fill="#1A2150" stroke="#38BDF8" stroke-width="1" />
        {/* Step 2: Intermediate */}
        <polygon points="220,190 300,150 300,200 220,240" fill="#1A2150" stroke="#4A538A" stroke-width="1" />
        <polygon points="220,190 300,150 380,190 300,230" fill="#232B65" stroke="#38BDF8" stroke-width="1" />
        {/* Step 3: Frontier MSME AI */}
        <polygon points="320,150 400,110 400,160 320,200" fill="#232B65" stroke="#D19C33" stroke-width="1.5" />
        <polygon points="320,150 400,110 480,150 400,190" fill="#0B0E2B" stroke="url(#goldGrad-msme)" stroke-width="2" />
      </g>

      {/* Ascension Trajectory Line with Pulse Points */}
      <path d="M 160 210 L 260 170 L 360 130 L 440 90" stroke="url(#goldGrad-msme)" stroke-width="3" stroke-linecap="round" />
      
      {/* Floating Gear / Automation Nodes */}
      <g transform="translate(440, 90)">
        <circle cx="0" cy="0" r="18" fill="#D19C33" opacity="0.2" />
        <circle cx="0" cy="0" r="10" fill="#D19C33" stroke="#F5E9D1" stroke-width="1.5" />
      </g>

      <g transform="translate(80, 50)">
        <rect x="0" y="0" width="145" height="26" rx="6" fill="#12173B" stroke="#D19C33" stroke-width="1" opacity="0.9" />
        <text x="12" y="17" fill="#F5E9D1" font-size="10" font-family="monospace" font-weight="bold">INDIA-AI // MSME</text>
      </g>
      <g transform="translate(390, 240)">
        <rect x="0" y="0" width="135" height="26" rx="6" fill="#12173B" stroke="#38BDF8" stroke-width="1" opacity="0.9" />
        <text x="12" y="17" fill="#38BDF8" font-size="10" font-family="monospace" font-weight="bold">ADOPTION ROADMAP</text>
      </g>
    </svg>
  )}

  {/* =========================================================================
      5. WATER UTILITIES SANDBOX (Africa Utility Data Collaborative)
      Theme: Fluid Network Grid, Testing Sandbox Matrix, Flow Telemetry Meters
      ========================================================================= */}
  {id === 'water-utilities-sandbox' && (
    <svg class="relative z-10 w-full h-full" viewBox="0 0 600 340" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="waterGrad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#38BDF8" />
          <stop offset="100%" stop-color="#0284C7" />
        </linearGradient>
      </defs>

      {/* Sandbox Enclosure Grid */}
      <rect x="120" y="70" width="360" height="200" rx="16" fill="#0B0E2B" stroke="#38BDF8" stroke-width="1.5" stroke-dasharray="6 4" opacity="0.8" />
      
      {/* Utility Pipeline Flow Graph */}
      <path d="M 80 170 L 200 170 L 200 120 L 320 120 L 320 210 L 440 210 L 520 210" stroke="url(#waterGrad)" stroke-width="4" stroke-linecap="round" fill="none" />
      <path d="M 200 170 L 320 170 L 440 170" stroke="#D19C33" stroke-width="2" stroke-dasharray="3 4" fill="none" />

      {/* Meter Telemetry Nodes */}
      {[[200, 120], [320, 120], [320, 210], [440, 210], [200, 170]].map(([cx, cy]) => (
        <g transform={`translate(${cx}, ${cy})`}>
          <circle cx="0" cy="0" r="10" fill="#12173B" stroke="#F5E9D1" stroke-width="1.5" />
          <circle cx="0" cy="0" r="4" fill="#38BDF8" />
        </g>
      ))}

      {/* Central AI Anomaly / Flow Detection Lens */}
      <g transform="translate(320, 170)">
        <circle cx="0" cy="0" r="26" fill="#1A2150" stroke="#D19C33" stroke-width="2" />
        <path d="M -8 -8 L 8 8 M -8 8 L 8 -8" stroke="#D19C33" stroke-width="1.5" />
        <circle cx="0" cy="0" r="16" stroke="#38BDF8" stroke-width="1" stroke-dasharray="2 3" />
      </g>

      <g transform="translate(80, 40)">
        <rect x="0" y="0" width="140" height="26" rx="6" fill="#12173B" stroke="#38BDF8" stroke-width="1" opacity="0.9" />
        <text x="12" y="17" fill="#38BDF8" font-size="10" font-family="monospace" font-weight="bold">AI UTILITY SANDBOX</text>
      </g>
      <g transform="translate(380, 275)">
        <rect x="0" y="0" width="140" height="26" rx="6" fill="#12173B" stroke="#D19C33" stroke-width="1" opacity="0.9" />
        <text x="12" y="17" fill="#F5E9D1" font-size="10" font-family="monospace" font-weight="bold">FLOW TELEMETRY</text>
      </g>
    </svg>
  )}

  {/* =========================================================================
      6. KAMPALA CITIZEN ASSISTANT (KCCA / Public Services)
      Theme: Civic Municipal Hub, Dual Messaging Channels, Citizen API Dispatch
      ========================================================================= */}
  {id === 'kampala-citizen-assistant' && (
    <svg class="relative z-10 w-full h-full" viewBox="0 0 600 340" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="kccaGrad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#F5E9D1" />
          <stop offset="50%" stop-color="#D19C33" />
          <stop offset="100%" stop-color="#A87820" />
        </linearGradient>
      </defs>

      {/* Municipal Civic Building Outline */}
      <g transform="translate(300, 150)">
        {/* Pillars of Public Administration */}
        <rect x="-80" y="-40" width="160" height="15" rx="3" fill="#1A2150" stroke="#4A538A" stroke-width="1" />
        <polygon points="-90,-40 0,-85 90,-40" fill="#0B0E2B" stroke="url(#kccaGrad)" stroke-width="2" />
        {[-60, -20, 20, 60].map((x) => (
          <rect x={x - 6} y="-25" width="12" height="75" fill="#12173B" stroke="#38BDF8" stroke-width="1" />
        ))}
        <rect x="-90" y="50" width="180" height="18" rx="3" fill="#0B0E2B" stroke="#4A538A" stroke-width="1" />
      </g>

      {/* Conversational Channel Flows (WhatsApp / Telegram Dispatch) */}
      <path d="M 100 120 Q 200 120, 240 150" stroke="#22C55E" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="5 3" />
      <path d="M 500 120 Q 400 120, 360 150" stroke="#38BDF8" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="5 3" />

      {/* Chat Dispatch Bubbles */}
      <g transform="translate(90, 105)">
        <rect x="0" y="0" width="110" height="32" rx="8" fill="#12173B" stroke="#22C55E" stroke-width="1.5" />
        <text x="10" y="20" fill="#4ADE80" font-size="10" font-family="sans-serif" font-weight="bold">💬 WHATSAPP</text>
      </g>
      <g transform="translate(400, 105)">
        <rect x="0" y="0" width="110" height="32" rx="8" fill="#12173B" stroke="#38BDF8" stroke-width="1.5" />
        <text x="10" y="20" fill="#38BDF8" font-size="10" font-family="sans-serif" font-weight="bold">✈️ TELEGRAM</text>
      </g>

      <g transform="translate(230, 265)">
        <rect x="0" y="0" width="140" height="26" rx="6" fill="#12173B" stroke="#D19C33" stroke-width="1" opacity="0.9" />
        <text x="12" y="17" fill="#F5E9D1" font-size="10" font-family="monospace" font-weight="bold">KCCA // GOV API</text>
      </g>
    </svg>
  )}

  {/* =========================================================================
      7. MEL EVIDENCE PORTAL (Gates Foundation / M&E)
      Theme: Multi-Dimensional Semantic Knowledge Graph, Query Beam, Evidence Rings
      ========================================================================= */}
  {id === 'mel-evidence-portal' && (
    <svg class="relative z-10 w-full h-full" viewBox="0 0 600 340" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="melGrad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#F5E9D1" />
          <stop offset="50%" stop-color="#D19C33" />
          <stop offset="100%" stop-color="#38BDF8" />
        </linearGradient>
      </defs>

      {/* Semantic Knowledge Orbit Rings */}
      <ellipse cx="300" cy="170" rx="140" ry="60" stroke="#4A538A" stroke-width="1" stroke-dasharray="4 4" opacity="0.4" transform="rotate(-15, 300, 170)" />
      <ellipse cx="300" cy="170" rx="140" ry="60" stroke="#D19C33" stroke-width="1" stroke-dasharray="6 4" opacity="0.5" transform="rotate(25, 300, 170)" />

      {/* Distributed Document Vector Nodes */}
      {[
        [180, 110], [240, 80], [360, 90], [420, 130],
        [160, 210], [220, 240], [380, 230], [440, 190]
      ].map(([x, y]) => (
        <g transform={`translate(${x}, ${y})`}>
          <line x1="0" y1="0" x2={300 - x} y2={170 - y} stroke="#4A538A" stroke-width="0.75" opacity="0.4" />
          <rect x="-8" y="-10" width="16" height="20" rx="3" fill="#12173B" stroke="#38BDF8" stroke-width="1" />
          <line x1="-4" y1="-4" x2="4" y2="-4" stroke="#F5E9D1" stroke-width="1" />
          <line x1="-4" y1="0" x2="4" y2="0" stroke="#F5E9D1" stroke-width="1" />
        </g>
      ))}

      {/* Central Domain-Tuned LLM Synthesis Core */}
      <g transform="translate(300, 170)">
        <circle cx="0" cy="0" r="32" fill="#0B0E2B" stroke="url(#melGrad)" stroke-width="2.5" />
        <circle cx="0" cy="0" r="20" fill="#1A2150" stroke="#D19C33" stroke-width="1" />
        {/* Core Semantic Node Symbol */}
        <polygon points="0,-10 9,-5 9,5 0,10 -9,5 -9,-5" fill="#F5E9D1" />
      </g>

      <g transform="translate(80, 40)">
        <rect x="0" y="0" width="145" height="26" rx="6" fill="#12173B" stroke="#D19C33" stroke-width="1" opacity="0.9" />
        <text x="12" y="17" fill="#F5E9D1" font-size="10" font-family="monospace" font-weight="bold">DOMAIN-TUNED MODEL</text>
      </g>
      <g transform="translate(380, 270)">
        <rect x="0" y="0" width="145" height="26" rx="6" fill="#12173B" stroke="#38BDF8" stroke-width="1" opacity="0.9" />
        <text x="12" y="17" fill="#38BDF8" font-size="10" font-family="monospace" font-weight="bold">EVIDENCE SYNTHESIS</text>
      </g>
    </svg>
  )}

