---
// ApproachTimeline.astro — Interactive 4-stage lifecycle timeline component for Our Approach
export interface Stage {
  id: string;
  num: string;
  phase: string;
  name: string;
  lead: string;
  body: string;
  outcome: string;
  tag: string;
  deliverables: string[];
}

const stages: Stage[] = [
  {
    id: 'explore',
    num: '01',
    phase: 'Explore',
    name: 'Strategy and direction',
    lead: 'Establishing where AI can create meaningful value and what it will take to deliver it.',
    body: 'Rather than beginning with a technology or a predetermined solution, we start with the decision, service or workflow that needs to improve, and the people and institutions it affects. This means assessing the mandate, availability and quality of data, existing infrastructure, operational workflows and institutional capacity required for implementation.',
    outcome: 'A promising use case is only viable when the underlying data, institutional mandate, operating environment and ownership arrangements can support it. The outcome is a clear view of the opportunity, the conditions required for implementation, and whether the use case is ready to move forward.',
    tag: 'Readiness & Opportunity Analysis',
    deliverables: ['Decision & Mandate Assessment', 'Data Maturity & Infrastructure Review', 'Risk & Feasibility Analysis', 'Sequenced AI Opportunity Roadmap'],
  },
  {
    id: 'design',
    num: '02',
    phase: 'Design',
    name: 'Field and delivery',
    lead: 'Good design begins with the delivery setting and how frontline work actually happens.',
    body: 'Before deciding what to build, we understand how work actually happens, where systems fall short, and what people do to bridge those gaps. We observe frontline workflows, trace cases through the system, and work alongside the teams responsible for delivery. This brings forward the last-mile evidence that is often lost between frontline experience and institutional decision-making.',
    outcome: 'We co-design and prototype with the people who will use the system, testing early versions against real workflows rather than assumed ones. At the end of this stage, the idea is either refined into something worth building or stopped before further resources are committed.',
    tag: 'Frontline Evidence & Co-Design',
    deliverables: ['Last-Mile Workflow Observation', 'Frontline Case Tracing', 'Rapid Operational Prototyping', 'Go / No-Go Evidence Review'],
  },
  {
    id: 'deliver',
    num: '03',
    phase: 'Deliver',
    name: 'Design, build and scale',
    lead: 'Turning a validated prototype into a reliable, integrated system that institutions own.',
    body: 'The third stage turns a validated prototype into a system that can operate reliably within an institution’s existing environment. This requires aligning the product, architecture, data, workflows and governance arrangements needed for sustained use. We undertake AI and data engineering, integrate with existing systems, and define requirements for interoperability, security and decision rights.',
    outcome: 'Rollout is treated as part of implementation. We establish the training, documentation, support and operating structures needed for institutional teams to manage the system from the outset. Scale follows evidence and operational readiness.',
    tag: 'AI Engineering & Capability Transfer',
    deliverables: ['Sovereign AI & Data Engineering', 'MIS & Pipeline Integration', 'Security & Decision Rights Framework', 'Workforce Training & Operating Routines'],
  },
  {
    id: 'assure',
    num: '04',
    phase: 'Assure',
    name: 'Evaluation and assurance',
    lead: 'Independent assessment of model performance, user adoption and real public outcomes.',
    body: 'The final stage assesses whether a system is performing as intended and delivering value for the people and institutions it was designed to serve. We assess model performance, user adoption and workflow outcomes, alongside safety, fairness and broader impact. The findings inform a clear decision: improve, hold or scale. Where the evidence does not support continued use, stopping is a valid outcome.',
    outcome: 'Evaluation is kept independent from delivery, including from our own work. We do not evaluate systems built by our group, and we do not bid to build systems we have evaluated. This separation allows institutions to assess performance, risks and outcomes without a conflict of interest.',
    tag: 'Structural Independence Guarantee',
    deliverables: ['Model Performance & Fairness Audit', 'User Adoption & Workflow Metrics', 'Independent Impact Evaluation', 'Improve / Hold / Scale Decision Readout'],
  },
];
---

<div class="space-y-12">
  {/* 4 Stage Cards Grid */}
  <div class="space-y-8">
    {stages.map((stage) => (
      <div
        id={stage.id}
        class="rounded-3xl border border-hair bg-white p-8 sm:p-12 lg:p-14 shadow-sm hover:border-smoke hover:shadow-xl transition-all duration-base group"
        data-card-spotlight
      >
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 items-start">
          {/* Left Column: Stage Phase & Headline */}
          <div class="lg:col-span-5 space-y-4">
            <div class="flex items-center gap-3">
              <span class="text-4xl sm:text-5xl font-light text-gold font-serif">
                {stage.num}
              </span>
              <span class="inline-flex items-center gap-1.5 rounded-full bg-pale-navy px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-navy">
                <span class="h-1.5 w-1.5 rounded-full bg-gold"></span>
                Stage {stage.num} · {stage.phase}
              </span>
            </div>

            <h3 class="text-2xl sm:text-3xl lg:text-4xl font-black text-navy leading-tight">
              {stage.name}
            </h3>

            <p class="text-base sm:text-lg font-medium text-navy/90 leading-relaxed pt-2">
              {stage.lead}
            </p>

            <div class="pt-4 hidden lg:block">
              <span class="text-xs uppercase font-bold tracking-wider text-mid-navy/70 block mb-2">Key Focus:</span>
              <span class="inline-block text-xs font-bold text-navy bg-paper px-3 py-1.5 rounded-lg border border-hair">
                {stage.tag}
              </span>
            </div>
          </div>

          {/* Right Column: In-depth Narrative & Outcome Card */}
          <div class="lg:col-span-7 space-y-6">
            <p class="text-base sm:text-lg text-mid-navy leading-relaxed font-normal">
              {stage.body}
            </p>

            {/* Outcome Highlight Box */}
            <div class="rounded-2xl border border-hair/80 bg-paper/70 p-6 sm:p-8 space-y-3">
              <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-navy">
                <span class="h-2 w-2 rounded-full bg-gold"></span>
                Stage Outcome & Condition
              </div>
              <p class="text-sm sm:text-base text-mid-navy leading-relaxed">
                {stage.outcome}
              </p>
            </div>

            {/* Core Deliverables Matrix */}
            <div class="pt-2">
              <div class="text-xs uppercase font-bold tracking-wider text-mid-navy/70 mb-3">
                Stage Deliverables:
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                {stage.deliverables.map((item) => (
                  <div class="flex items-center gap-2 text-xs font-bold text-navy bg-white p-2.5 rounded-xl border border-hair shadow-xs">
                    <svg class="h-3.5 w-3.5 text-gold shrink-0" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                    <span>{item}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>
</div>
