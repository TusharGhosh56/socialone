---
// The icon SVG shared across every icon-badge card on the page (Challenge
// section's PrincipleItem, the Principles section's EngagementPrincipleCard)
// — extracted so the same path data isn't duplicated across call sites.
// The icon name type lives HERE (not in src/data/principles.ts, which only
// owns the Challenge section's own content) since it's genuinely shared —
// principles.ts imports it back, not the other way around.
export type IconName = 'people' | 'institution' | 'shield' | 'seedling' | 'evidence';

interface Props {
  icon: IconName;
  // Some call sites (PrincipleItem's stroke-redraw hover flourish) rely on
  // these paths carrying `class="p-stroke"` + `pathLength="100"`; others
  // (EngagementPrincipleCard) don't animate the icon at all and would
  // rather not carry unused animation hooks. Defaults to on since that's
  // every existing call site's behaviour.
  animated?: boolean;
}
const { icon, animated = true } = Astro.props;
const strokeClass = animated ? 'p-stroke' : undefined;
---

<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {icon === 'people' && (
    <>
      <circle class={strokeClass} cx="12" cy="7.5" r="3" pathLength="100" />
      <path class={strokeClass} style="animation-delay:90ms" d="M5.5 19.5c0-3.6 3-6.3 6.5-6.3s6.5 2.7 6.5 6.3" pathLength="100" />
    </>
  )}
  {icon === 'institution' && (
    <>
      <path class={strokeClass} d="M4 18.5V9.5L12 4.5L20 9.5V18.5H4Z" pathLength="100" />
      <path class={strokeClass} style="animation-delay:120ms" d="M8 18.5V10M12 18.5V10M16 18.5V10" pathLength="100" />
    </>
  )}
  {icon === 'shield' && (
    <>
      <path class={strokeClass} d="M12 3.5L18.5 6V11C18.5 15.5 15.8 18.5 12 20C8.2 18.5 5.5 15.5 5.5 11V6L12 3.5Z" pathLength="100" />
      <path class={strokeClass} style="animation-delay:120ms" d="M9 12.2L11.3 14.5L15.3 10" pathLength="100" />
    </>
  )}
  {icon === 'seedling' && (
    <>
      <path class={strokeClass} d="M4 19.5H20M12 19.5V11.5" pathLength="100" />
      <path class={strokeClass} style="animation-delay:100ms" d="M12 13.5Q7 12.5 7 8Q9.8 8.5 12 13.5Z" pathLength="100" />
      <path class={strokeClass} style="animation-delay:180ms" d="M12 10.5Q17 9.8 17 6Q14.5 6.3 12 10.5Z" pathLength="100" />
    </>
  )}
  {icon === 'evidence' && (
    <>
      <path class={strokeClass} d="M4 20.5H20" pathLength="100" />
      <path class={strokeClass} style="animation-delay:90ms" d="M7 20.5V13.5" pathLength="100" />
      <path class={strokeClass} style="animation-delay:150ms" d="M12.5 20.5V8.5" pathLength="100" />
      <path class={strokeClass} style="animation-delay:210ms" d="M18 20.5V4.5" pathLength="100" />
    </>
  )}
</svg>
