---
// AtmosphericCanvas.astro — Institutional Canvas with Brand Gold Dot Lattice, Ambient Spotlight & Guide Rails
interface Props {
  class?: string;
  padded?: boolean;
}

const { class: className = '', padded = true } = Astro.props;
---

<div class={`bg-atmospheric-canvas relative overflow-clip ${className}`} data-ambient-canvas>
  {/* 1. Precision Brand Gold Dot-Matrix Grid */}
  <div class="institutional-dot-grid" aria-hidden="true"></div>

  {/* 2. Hardware-Accelerated Cursor Spotlight Follower */}
  <div class="ambient-spotlight-follower" data-ambient-spotlight aria-hidden="true"></div>

  {/* 3. Architectural Margin Guide Rails */}
  <div class="margin-guide-rail-left hidden 2xl:block" aria-hidden="true"></div>
  <div class="margin-guide-rail-right hidden 2xl:block" aria-hidden="true"></div>

  {/* 4. Content Slot */}
  <div class={`relative z-10 ${padded ? 'space-y-24 sm:space-y-32 py-16 sm:py-24 lg:py-32' : ''}`}>
    <slot />
  </div>
</div>

<script>
  import { initAmbientSpotlight } from '../scripts/ambientSpotlight';
  initAmbientSpotlight();
</script>
