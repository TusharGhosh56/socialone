---
// src/components/NewsDispatchTimeline.astro — Clean News & Updates List
import type { NewsDispatch } from '../data/insights';

interface Props {
  dispatches: NewsDispatch[];
}

const { dispatches } = Astro.props;
---

<div class="space-y-6 sm:space-y-8" data-news-list>
  {dispatches.map((item) => (
    <article class="news-item rounded-2xl border border-hair bg-white p-6 sm:p-8 shadow-sm hover:border-gold/40 transition-all duration-300">
      {/* Date & Location */}
      <div class="flex items-center gap-3 text-xs text-mid-navy/70 mb-3">
        <time datetime={item.date} class="font-semibold text-navy">
          {item.formattedDate}
        </time>
        <span>•</span>
        <span>{item.location}</span>
      </div>

      {/* Headline */}
      <h2 class="text-xl sm:text-2xl font-bold text-navy leading-snug tracking-tight mb-3">
        {item.title}
      </h2>

      {/* Lead paragraph */}
      <p class="text-sm sm:text-base text-mid-navy leading-relaxed mb-4">
        {item.lead}
      </p>

      {/* Expandable full text */}
      <details class="group/dispatch pt-2">
        <summary class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full border border-navy/20 bg-navy/[0.03] hover:bg-gold/15 hover:border-gold text-xs sm:text-sm font-semibold text-navy transition-all duration-200 cursor-pointer select-none list-none shadow-xs group-open/dispatch:bg-navy group-open/dispatch:text-white group-open/dispatch:border-navy">
          <span class="group-open/dispatch:hidden">Read full briefing</span>
          <span class="hidden group-open/dispatch:inline">Collapse briefing</span>
          <span class="flex h-5 w-5 items-center justify-center rounded-full bg-navy/10 text-gold group-open/dispatch:bg-white/20 group-open/dispatch:text-gold transition-transform duration-200 group-open/dispatch:rotate-180">
            <svg class="w-3 h-3" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2"><path d="M2.5 4.5L6 8L9.5 4.5"/></svg>
          </span>
        </summary>
        <div class="mt-4 space-y-3 text-xs sm:text-sm text-navy/85 leading-relaxed pt-3 border-t border-hair/60">
          {item.body.map((para) => (
            <p>{para}</p>
          ))}

          {item.quote && (
            <blockquote class="my-4 rounded-xl border-l-2 border-gold bg-pale-navy/40 p-4 italic text-navy/90">
              <p>"{item.quote.text}"</p>
              <footer class="mt-2 not-italic text-xs font-semibold text-deep-gold">
                — {item.quote.attribution}
              </footer>
            </blockquote>
          )}
        </div>
      </details>
    </article>
  ))}
</div>
