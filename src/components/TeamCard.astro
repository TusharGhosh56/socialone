---
// TeamCard — Our Team section's small cards (TeamCarousel.astro). Renders
// a real photo (astro:assets <Image>, build-time resized/webp — see
// src/data/team.ts's own comment) when one exists; falls back to a plain
// initials circle for anyone without one (everyone currently has a photo,
// but `photo` stays optional for whenever the next hire's doesn't yet) —
// deliberately not a reused/stock photo standing in for them, which would
// misleadingly look like an actual (wrong) photo. A small LinkedIn icon
// sits top-right, hidden until the card is hovered/focused (per explicit
// product decision) — links to each person's real profile (src/data/
// team.ts's `linkedin` field), '#' is just the fallback if one's ever
// missing.
import { Image } from 'astro:assets';
import type { TeamMember } from '../data/team';
interface Props extends TeamMember {
  // True for the duplicated second copy of each row (TeamCarousel.astro's
  // seamless-loop technique) — hidden from assistive tech/tab order so a
  // screen reader/keyboard user doesn't hit the same 12 people twice.
  decorative?: boolean;
}
const { name, title, subtitle, tag, photo, linkedin, decorative = false } = Astro.props;

function initials(fullName: string): string {
  const parts = fullName.replace(/^Dr\.?\s+/i, '').split(' ').filter(Boolean);
  if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();
  return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
}
---

<div class="team-card group relative shrink-0 rounded-lg border border-hair bg-white p-5 shadow-sm" aria-hidden={decorative ? 'true' : undefined} tabindex={decorative ? -1 : undefined}>
  <!-- Top-right, hover/focus-only (group-hover / group-focus-within — the
       latter so a keyboard user tabbing onto the link itself reveals it,
       not just a mouse hover). tabindex/aria-hidden mirror the card's own
       decorative treatment so the duplicated marquee copy's LinkedIn link
       isn't independently reachable either. -->
  <a
    href={linkedin || '#'}
    aria-label={`${name} on LinkedIn`}
    aria-hidden={decorative ? 'true' : undefined}
    tabindex={decorative ? -1 : undefined}
    target="_blank"
    rel="noopener noreferrer"
    class="team-card__linkedin absolute right-3 top-3 flex h-8 w-8 items-center justify-center rounded-full border border-hair bg-white text-navy opacity-0 shadow-sm transition-opacity duration-base ease-out group-hover:opacity-100 group-focus-within:opacity-100 hover:border-gold hover:text-gold"
  >
    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M6.94 8.5H4.06V19.5H6.94V8.5ZM5.5 7.25A1.75 1.75 0 1 0 5.5 3.75A1.75 1.75 0 0 0 5.5 7.25ZM19.94 19.5H17.06V13.75C17.06 12.35 16.5 11.5 15.28 11.5C14.36 11.5 13.81 12.12 13.56 12.72C13.47 12.94 13.44 13.24 13.44 13.55V19.5H10.56S10.6 9.34 10.56 8.5H13.44V9.79C13.83 9.16 14.55 8.26 16.48 8.26C18.88 8.26 19.94 9.86 19.94 12.68V19.5Z"
      />
    </svg>
  </a>
  {photo ? (
    <Image class="team-card__avatar team-card__avatar--photo" src={photo} alt={`${name} - ${title} at APLYD`} width={144} height={144} format="webp" quality={82} />
  ) : (
    <span class="team-card__avatar" aria-hidden="true">{initials(name)}</span>
  )}
  <p class="mt-3 text-center font-bold text-navy">{name}</p>
  <p class="mt-1 text-center text-small text-navy/80">{title}</p>
  {subtitle && <p class="mt-0.5 text-center text-small text-navy/60">{subtitle}</p>}
  <span class="team-card__tag">{tag}</span>
</div>

<style>
  .team-card {
    position: relative;
    z-index: 30;
    width: 15rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    background-color: #ffffff;
  }
  .team-card__avatar {
    display: grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    background: var(--pale-navy);
    color: var(--navy);
    font-weight: 700;
    font-size: 1.125rem;
    box-shadow: 0 0 0 3px var(--white), 0 0 0 4.5px var(--hair);
  }
  .team-card__avatar--photo {
    object-fit: cover;
    /* Astro's <Image> renders width/height as HTML attrs (144x144, for a
       correct aspect-ratio box before the browser has the file) — the
       actual on-screen size still comes from here, same 4.5rem/72px as the
       initials-avatar fallback so a photo vs. no-photo card looks
       identical apart from the image itself. */
    width: 4.5rem;
    height: 4.5rem;
  }
  .team-card__tag {
    margin-top: 0.75rem;
    border-radius: 999px;
    background: var(--pale-navy);
    color: var(--navy);
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.25rem 0.625rem;
    text-align: center;
  }
</style>
