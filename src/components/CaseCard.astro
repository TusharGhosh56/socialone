---
// CaseCard (§7) — image + tag + title + one-liner; whole card is one link
// (still an on-page anchor placeholder until real case-study pages exist —
// see cases.ts). Photo scales 1.03 on hover within overflow-hidden. Goes
// through Astro's build-time image pipeline (astro:assets) — see
// src/data/cases.ts (image comes in already imported) and CLAUDE.md's
// "Images and video". The number badge and "Read the case study" CTA row
// (with its hover-slide arrow) were both removed — no case-study pages to
// send readers to yet.
import { Image } from 'astro:assets';
import type { CaseStudy } from '../data/cases';
interface Props extends CaseStudy {}
const { title, body, tag, href, image } = Astro.props;
---

<a
  href={href}
  data-tilt
  class="case-card hover-glow-gold group flex h-full flex-col overflow-hidden rounded-lg border border-hair bg-white no-underline shadow-sm transition-[transform,box-shadow] duration-base ease-out hover:-translate-y-1 hover:shadow-md motion-reduce:transition-none"
  style="transform-style: preserve-3d; will-change: transform;"
>
  <div class="relative aspect-[16/10] overflow-hidden bg-navy">
    <Image
      class="absolute inset-0 h-full w-full object-cover transition-transform duration-[400ms] ease-out group-hover:scale-[1.03] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
      style="object-position: center 38%;"
      src={image}
      alt=""
      aria-hidden="true"
      widths={[400, 640, 960]}
      sizes="(max-width: 768px) 100vw, 33vw"
      format="webp"
      quality={80}
    />
    <div
      aria-hidden="true"
      class="absolute inset-0 bg-gradient-to-b from-navy/60 via-navy/0 to-navy/0"
    >
    </div>
  </div>
  <div class="flex flex-1 flex-col p-6">
    {/* Ash, was text-deep-gold. This is a repeating metadata label — one per
        card, several on screen at once — so it read as gold-as-styling rather
        than gold-as-emphasis, which the 70/25/5 ratio rules out. Ash is the
        palette's own caption neutral and keeps the tag subordinate to the
        card's navy title, where the emphasis belongs. */}
    <span class="text-eyebrow font-bold uppercase tracking-[0.14em] text-ash">{tag}</span>
    <h3 class="mt-2 text-h3 font-bold text-navy">{title}</h3>
    <p class="mt-3 text-navy/85">{body}</p>
  </div>
</a>
