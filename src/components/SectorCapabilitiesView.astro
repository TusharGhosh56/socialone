---
// SectorCapabilitiesView.astro — Smooth, in-place sector switcher without scroll jumping
import { sectorDataList, type SectorData } from '../data/capabilities';
import Button from './Button.astro';
import CapabilityWorkbench from './CapabilityWorkbench.astro';
import AtmosphericCanvas from './AtmosphericCanvas.astro';
import HeroVideo from './HeroVideo.astro';

interface Props {
  initialSector: 'government' | 'nonprofits' | 'philanthropy';
}

const { initialSector } = Astro.props;

const sectors: SectorData[] = [
  sectorDataList.government,
  sectorDataList.nonprofits,
  sectorDataList.philanthropy,
];

const sectorVideos = [
  {
    id: 'government',
    src: '/video/subpage-hero/government.mp4',
    poster: '/video/posters/government.webp',
    storyTag: 'Government · Sovereign Public Delivery',
  },
  {
    id: 'nonprofits',
    src: '/video/subpage-hero/non_profit.mp4',
    poster: '/video/posters/non_profit.webp',
    storyTag: 'Nonprofits · Frontline Programme Operations',
  },
  {
    id: 'philanthropy',
    src: '/video/subpage-hero/philanthopy.mp4',
    poster: '/video/posters/philanthopy.webp',
    storyTag: 'Philanthropy · Catalytic Portfolio Intelligence',
  },
];
---

<div class="sector-capabilities-view w-full" data-sector-view data-initial-sector={initialSector}>
  {/* ============================ HERO SECTION ============================ */}
  <section class="hero-internal-section bg-navy text-white pt-28 sm:pt-36 lg:pt-40 pb-16 sm:pb-24 lg:pb-28 min-h-screen min-h-[100dvh] flex flex-col justify-center relative overflow-hidden">
    {/* Cinematic Stock Video Background: Applied Capabilities across sectors */}
    <HeroVideo
      videos={sectorVideos}
      activeId={initialSector}
      overlayOpacity={0.65}
    />

    <div class="container-x relative z-10">
      {/* Sector Dynamic Hero Headers */}
      {sectors.map((sec) => {
        const isInit = sec.id === initialSector;
        return (
          <div
            id={`sector-hero-${sec.id}`}
            class={`sector-hero-block transition-opacity duration-300 ${isInit ? 'block opacity-100' : 'hidden opacity-0'}`}
            data-sector-hero={sec.id}
          >
            <h1 class="max-w-4xl text-display font-light text-white leading-[1.08] text-3xl sm:text-5xl lg:text-6xl tracking-tight">
              {sec.heroH1}
            </h1>

            <p class="mt-4 sm:mt-5 max-w-4xl lg:max-w-5xl text-sm sm:text-lg lg:text-xl font-normal text-pale-navy/90 leading-relaxed text-pretty">
              {sec.heroLead}
            </p>
          </div>
        );
      })}

      {/* Interactive Segmented Audience Switcher */}
      <div class="mt-6 sm:mt-8 max-w-3xl">
        <div class="w-full">
          <div class="flex flex-col sm:flex-row items-center justify-between gap-3 sm:gap-4 p-1.5 sm:p-2 bg-white/10 rounded-2xl border border-white/15 backdrop-blur-sm">
            <div class="text-xs font-bold uppercase tracking-wider text-pale-navy/80 px-3 hidden md:block">
              Select Institutional Domain:
            </div>

            <div class="grid grid-cols-3 gap-1.5 sm:gap-2 w-full md:w-auto">
              {sectors.map((s) => {
                const isActive = initialSector === s.id;
                return (
                  <button
                    type="button"
                    class={`sector-switch-btn flex items-center justify-center sm:justify-start gap-1.5 sm:gap-2.5 px-2.5 sm:px-4 py-2 sm:py-2.5 rounded-xl text-[0.6875rem] sm:text-small font-bold transition-all duration-base cursor-pointer border ${
                      isActive
                        ? 'bg-white text-navy shadow-md border-white is-active'
                        : 'bg-white/5 text-white hover:bg-white/15 border-white/10'
                    }`}
                    data-sector-btn={s.id}
                    data-sector-href={s.href}
                    aria-pressed={isActive ? 'true' : 'false'}
                  >
                    <span class={`sector-switch-dot h-1.5 w-1.5 sm:h-2 sm:w-2 rounded-full shrink-0 ${isActive ? 'bg-gold' : 'bg-white/40'}`}></span>
                    <span class="truncate">{s.label}</span>
                  </button>
                );
              })}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ============================ RICH ATMOSPHERIC CANVAS ============================ */}
  <AtmosphericCanvas>
    {/* ============================ SECTOR CAPABILITIES WORKBENCH ============================ */}
    <section class="relative z-10">
      <div class="container-x">
        {sectors.map((sec) => {
          const isInit = sec.id === initialSector;
          return (
            <div
              id={`sector-body-${sec.id}`}
              class={`sector-body-block transition-opacity duration-300 ${isInit ? 'block opacity-100' : 'hidden opacity-0'}`}
              data-sector-body={sec.id}
            >
              <div class="max-w-4xl mb-6 sm:mb-12 space-y-2 sm:space-y-4">
                <div class="text-xs font-bold uppercase tracking-widest text-gold">Capabilities</div>
                <p class="text-base sm:text-xl text-mid-navy leading-relaxed font-normal">
                  {sec.sectionLead}
                </p>
              </div>

              <CapabilityWorkbench
                capabilities={sec.capabilities}
                sectorId={sec.id}
              />
            </div>
          );
        })}
      </div>
    </section>

    {/* ============================ NEXT SECTION CTA ============================ */}
    <section class="relative z-10">
      <div class="container-x">
        {sectors.map((sec) => {
          const isInit = sec.id === initialSector;
          return (
            <div
              id={`sector-cta-${sec.id}`}
              class={`sector-cta-block transition-opacity duration-300 ${isInit ? 'block opacity-100' : 'hidden opacity-0'}`}
              data-sector-cta={sec.id}
            >
              <div class="rounded-3xl border border-hair bg-white/95 backdrop-blur-md p-6 sm:p-10 lg:p-14 shadow-md flex flex-col md:flex-row items-start md:items-center justify-between gap-6 sm:gap-8 card-interactive-sheen final-cta-card">
                <div class="max-w-2xl relative z-10">
                  <div class="text-xs uppercase font-bold tracking-widest text-gold mb-2">Next Sector Domain</div>
                  <h3 class="text-2xl sm:text-3xl font-light text-navy mb-3">
                    {sec.ctaTitle}
                  </h3>
                  <p class="text-base text-mid-navy leading-relaxed font-normal">
                    {sec.ctaDesc}
                  </p>
                </div>
                <div class="relative z-10 w-full sm:w-auto">
                  <Button href={sec.ctaHref} variant="primary" class="w-full sm:w-auto text-center justify-center shadow-sm">
                    {sec.ctaText} &rarr;
                  </Button>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </section>
  </AtmosphericCanvas>
</div>

<script>
  function initSectorCapabilitiesView() {
    const root = document.querySelector('[data-sector-view]');
    if (!root) return;

    const buttons = root.querySelectorAll<HTMLButtonElement>('[data-sector-btn]');
    const heroBlocks = root.querySelectorAll<HTMLElement>('[data-sector-hero]');
    const bodyBlocks = root.querySelectorAll<HTMLElement>('[data-sector-body]');
    const ctaBlocks = root.querySelectorAll<HTMLElement>('[data-sector-cta]');
    const bgVideos = root.querySelectorAll<HTMLVideoElement>('[data-hero-bg-video]');
    const posters = root.querySelectorAll<HTMLImageElement>('[data-hero-poster]');

    const sectorTagMap: Record<string, string> = {
      government: 'Government · Sovereign Public Delivery',
      nonprofits: 'Nonprofits · Frontline Programme Operations',
      philanthropy: 'Philanthropy · Catalytic Portfolio Intelligence',
    };

    // Ensure active video is playing
    bgVideos.forEach((vid) => {
      vid.muted = true;
      if (vid.classList.contains('is-active') && vid.paused) {
        vid.play().catch(() => {});
      }
    });

    function switchSector(targetId: string, updateHistory = true) {
      // 0. Update background video & story tag (only switch if multiple videos exist)
      if (bgVideos.length > 1) {
        bgVideos.forEach((vid) => {
          const matches = vid.getAttribute('data-hero-bg-video') === targetId;
          vid.classList.toggle('opacity-100', matches);
          vid.classList.toggle('is-active', matches);
          vid.classList.toggle('opacity-0', !matches);
          vid.classList.toggle('pointer-events-none', !matches);
          if (matches && vid.paused) {
            vid.play().catch(() => {});
          }
        });
      } else if (bgVideos.length === 1) {
        const vid = bgVideos[0];
        vid.classList.add('opacity-100', 'is-active');
        vid.classList.remove('opacity-0', 'pointer-events-none');
        if (vid.paused) {
          vid.play().catch(() => {});
        }
      }

      // Update static posters in sync
      if (posters.length > 0) {
        posters.forEach((poster) => {
          const matches = poster.getAttribute('data-hero-poster') === targetId;
          poster.classList.toggle('opacity-100', matches);
          poster.classList.toggle('opacity-0', !matches);
          poster.classList.toggle('pointer-events-none', !matches);
        });
      }

      const storyTagEl = root.querySelector('[data-hero-story-tag]');
      if (storyTagEl && sectorTagMap[targetId]) {
        storyTagEl.textContent = sectorTagMap[targetId];
      }

      // 1. Update buttons
      buttons.forEach((btn) => {
        const isActive = btn.getAttribute('data-sector-btn') === targetId;
        btn.classList.toggle('bg-white', isActive);
        btn.classList.toggle('text-navy', isActive);
        btn.classList.toggle('shadow-md', isActive);
        btn.classList.toggle('border-white', isActive);
        btn.classList.toggle('is-active', isActive);

        btn.classList.toggle('bg-white/5', !isActive);
        btn.classList.toggle('text-white', !isActive);
        btn.classList.toggle('border-white/10', !isActive);
        btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');

        const dot = btn.querySelector('.sector-switch-dot');
        if (dot) {
          dot.classList.toggle('bg-gold', isActive);
          dot.classList.toggle('bg-white/40', !isActive);
        }

        if (isActive && updateHistory) {
          const href = btn.getAttribute('data-sector-href');
          if (href && window.location.pathname !== href) {
            window.history.pushState({ sector: targetId }, '', href);
          }
        }
      });

      // 2. Smoothly switch hero blocks
      heroBlocks.forEach((hero) => {
        const matches = hero.getAttribute('data-sector-hero') === targetId;
        if (matches) {
          hero.classList.remove('hidden');
          requestAnimationFrame(() => {
            hero.classList.remove('opacity-0');
            hero.classList.add('opacity-100');
          });
        } else {
          hero.classList.add('hidden', 'opacity-0');
          hero.classList.remove('opacity-100');
        }
      });

      // 3. Smoothly switch body blocks
      bodyBlocks.forEach((body) => {
        const matches = body.getAttribute('data-sector-body') === targetId;
        if (matches) {
          body.classList.remove('hidden');
          requestAnimationFrame(() => {
            body.classList.remove('opacity-0');
            body.classList.add('opacity-100');
          });
        } else {
          body.classList.add('hidden', 'opacity-0');
          body.classList.remove('opacity-100');
        }
      });

      // 4. Smoothly switch CTA blocks
      ctaBlocks.forEach((cta) => {
        const matches = cta.getAttribute('data-sector-cta') === targetId;
        if (matches) {
          cta.classList.remove('hidden');
          requestAnimationFrame(() => {
            cta.classList.remove('opacity-0');
            cta.classList.add('opacity-100');
          });
        } else {
          cta.classList.add('hidden', 'opacity-0');
          cta.classList.remove('opacity-100');
        }
      });

      // 5. Recalculate and synchronize capability card stack positions
      setTimeout(() => {
        window.dispatchEvent(new Event('scroll'));
        window.dispatchEvent(new Event('resize'));
      }, 50);
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const targetId = btn.getAttribute('data-sector-btn');
        if (targetId) {
          switchSector(targetId, true);
        }
      });
    });

    // Handle back / forward navigation seamlessly
    window.addEventListener('popstate', () => {
      const path = window.location.pathname;
      if (path.includes('nonprofits')) {
        switchSector('nonprofits', false);
      } else if (path.includes('philanthropy')) {
        switchSector('philanthropy', false);
      } else {
        switchSector('government', false);
      }
    });
  }

  initSectorCapabilitiesView();
  document.addEventListener('astro:page-load', initSectorCapabilitiesView);
</script>
