---
import { Image } from 'astro:assets';
import type { CapabilityItem } from '../data/capabilities';
import bulbOffImg from '../assets/images/services/lightbulb.png';
import bulbOnImg from '../assets/images/services/lightbulb (1).png';

interface Props {
  capabilities: CapabilityItem[];
  sectorId?: string;
}

const { capabilities, sectorId = 'capabilities' } = Astro.props;
---

<div class="capability-stack-container relative py-4 pb-28" data-capability-stack data-stack-id={sectorId}>
  {/* Stacked Cards Track */}
  <div class="cards-stack-track relative">
    {capabilities.map((cap, idx) => {
      const stickyTop = 100 + idx * 32; // Progressive sticky tab offset
      return (
        <div
          class="stack-card-wrapper sticky transition-all duration-200 mb-20 sm:mb-32 last:mb-0"
          style={`top: ${stickyTop}px; z-index: ${idx + 10};`}
          data-stack-card={idx}
        >
          <article class={`capability-card capability-card-${idx} stack-card relative rounded-3xl border border-hair bg-white/95 backdrop-blur-xl p-8 sm:p-12 lg:p-14 shadow-2xl transition-all duration-300 overflow-hidden card-hover-accent card-interactive-sheen`} data-capability-index={idx}>
            {/* 2-Column Balanced Content Grid */}
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 items-start">
              {/* Left Column: Title with Light Bulb & Overview */}
              <div class="lg:col-span-5 space-y-6">
                <div class="flex items-start gap-3.5">
                  {/* Dynamic Light Bulb Indicator */}
                  <div class="capability-bulb-wrap relative flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-pale-navy/50 border border-hair transition-all duration-400 mt-1 overflow-hidden">
                    {/* Unlit Bulb (Idle) */}
                    <Image
                      src={bulbOffImg}
                      alt="Capability indicator"
                      width={24}
                      height={24}
                      class="capability-bulb-img bulb-off absolute inset-0 m-auto h-5.5 w-5.5 object-contain transition-all duration-400"
                    />
                    {/* Lit Bulb (Powered by Trail) */}
                    <Image
                      src={bulbOnImg}
                      alt="Active capability indicator"
                      width={24}
                      height={24}
                      class="capability-bulb-img bulb-on absolute inset-0 m-auto h-5.5 w-5.5 object-contain transition-all duration-400"
                    />
                  </div>

                  <h3 id={`capability-heading-${sectorId}-${idx}`} class="capability-heading text-2xl sm:text-3xl lg:text-4xl font-bold text-navy leading-tight tracking-tight flex-1">
                    {cap.title}
                  </h3>
                </div>

                <p class="text-base sm:text-lg text-mid-navy font-normal leading-relaxed">
                  {cap.p1}
                </p>
              </div>

              {/* Right Column: Implementation Detail Container */}
              <div class="lg:col-span-7">
                <div class="rounded-2xl border border-hair bg-paper/60 p-6 sm:p-8 lg:p-10">
                  <p class="text-base sm:text-lg text-navy font-normal leading-relaxed">
                    {cap.p2}
                  </p>
                </div>
              </div>
            </div>
          </article>
        </div>
      );
    })}
  </div>
</div>

<style>
  .stack-card-wrapper {
    will-change: transform;
  }

  .stack-card {
    transform-origin: top center;
    box-shadow: 0 12px 32px -12px rgba(18, 23, 59, 0.12), 0 24px 48px -18px rgba(18, 23, 59, 0.08);
  }

  /* Light bulb idle state: shows unlit line bulb */
  .capability-bulb-wrap {
    background-color: rgba(26, 33, 80, 0.03);
    border-color: rgba(26, 33, 80, 0.08);
  }
  .bulb-off {
    opacity: 0.55;
    transform: scale(1);
  }
  .bulb-on {
    opacity: 0;
    transform: scale(0.85);
  }

  /* Powered state: cross-fades seamlessly into the glowing lit bulb image! */
  :global(.capability-card.is-powered) .capability-bulb-wrap {
    background-color: rgba(245, 233, 209, 0.85) !important;
    border-color: rgba(209, 156, 51, 0.75) !important;
    box-shadow: 0 0 16px rgba(209, 156, 51, 0.35) !important;
    transform: scale(1.05);
  }
  :global(.capability-card.is-powered) .bulb-off {
    opacity: 0;
    transform: scale(0.85);
  }
  :global(.capability-card.is-powered) .bulb-on {
    opacity: 1;
    transform: scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .stack-card-wrapper {
      position: static !important;
      top: auto !important;
      transform: none !important;
    }
  }
</style>

<script>
  function initCapabilityStacking() {
    const stacks = document.querySelectorAll<HTMLElement>('[data-capability-stack]');
    if (!stacks.length) return;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    function updateStackTransforms() {
      stacks.forEach((stack) => {
        const wrappers = stack.querySelectorAll<HTMLElement>('[data-stack-card]');
        const total = wrappers.length;

        wrappers.forEach((wrapper, idx) => {
          if (idx === total - 1) return; // Topmost final card stays at scale 1

          const nextWrapper = wrappers[idx + 1];
          if (!nextWrapper) return;

          const nextRect = nextWrapper.getBoundingClientRect();
          const targetTop = 100 + (idx + 1) * 32;

          if (nextRect.top <= targetTop + 80) {
            const progress = Math.max(0, Math.min(1, (targetTop + 80 - nextRect.top) / 80));
            const card = wrapper.querySelector<HTMLElement>('.stack-card');
            if (card) {
              const scale = 1 - progress * 0.035;
              const brightness = 1 - progress * 0.05;
              card.style.transform = `scale(${scale})`;
              card.style.filter = `brightness(${brightness})`;
            }
          } else {
            const card = wrapper.querySelector<HTMLElement>('.stack-card');
            if (card) {
              card.style.transform = 'scale(1)';
              card.style.filter = 'brightness(1)';
            }
          }
        });
      });
    }

    window.addEventListener('scroll', updateStackTransforms, { passive: true });
    updateStackTransforms();
  }

  initCapabilityStacking();
  document.addEventListener('astro:page-load', initCapabilityStacking);
</script>
