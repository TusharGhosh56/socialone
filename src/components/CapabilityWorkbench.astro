---
import type { CapabilityItem } from '../data/capabilities';

interface Props {
  capabilities: CapabilityItem[];
}

const { capabilities } = Astro.props;
---

<div class="space-y-8">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    {capabilities.map((cap) => (
      <div class="rounded-3xl border border-hair bg-white p-8 sm:p-10 shadow-sm flex flex-col justify-between space-y-6">
        <div class="space-y-4">
          <div class="text-xs font-bold uppercase tracking-widest text-gold">
            Capability {cap.num}
          </div>
          <h3 class="text-2xl sm:text-3xl font-light text-navy leading-snug">
            {cap.title}
          </h3>
          <div class="space-y-4 text-base sm:text-lg text-mid-navy leading-relaxed font-normal pt-2">
            <p>{cap.p1}</p>
            <p>{cap.p2}</p>
          </div>
        </div>
      </div>
    ))}
  </div>
</div>
