---
import { Image } from 'astro:assets';
import type { CapabilityItem } from '../data/capabilities';

// Sector-specific curated stock image assets
import gov01 from '../assets/images/capabilities/ai.png';
import gov02 from '../assets/images/built-for-gov/photo-1524178232363-1fb2b075b655.png';
import gov03 from '../assets/images/capabilities/hero-fieldwork.jpg';
import gov04 from '../assets/images/how-we-work-page/building.png';

import non01 from '../assets/images/capabilities/strategy_priority.jpg';
import non02 from '../assets/images/capabilities/operations.png';
import non03 from '../assets/images/how-we-work-page/evidence.png';
import non04 from '../assets/images/how-we-work-page/transfer.png';

import phil01 from '../assets/images/purpose-direction/philanthropy.png';
import phil02 from '../assets/images/capabilities/insight-ai.jpg';
import phil03 from '../assets/images/how-we-work-page/evaluation.png';
import phil04 from '../assets/images/capabilities/independant.jpg';

interface Props {
  capabilities: CapabilityItem[];
  sectorId?: string;
}

const { capabilities, sectorId = 'government' } = Astro.props;

const capabilityImages: Record<string, any[]> = {
  government: [gov01, gov02, gov03, gov04],
  nonprofits: [non01, non02, non03, non04],
  philanthropy: [phil01, phil02, phil03, phil04],
};

const currentImages = capabilityImages[sectorId] || capabilityImages.government;
---

<div class="kinetic-horizon-studio w-full py-4 pb-12 select-none" data-kinetic-studio data-sector-id={sectorId}>
  {/* Panoramic Horizon Shutter Deck */}
  <div class="horizon-deck flex flex-col lg:flex-row gap-4 lg:gap-3.5 h-auto lg:h-[620px] w-full" role="tablist" aria-label="Capabilities Horizon">
    {capabilities.map((cap, idx) => {
      const cardImg = currentImages[idx] || gov01;
      const isInit = idx === 0;

      return (
        <div
          id={`horizon-panel-${sectorId}-${idx}`}
          role="tabpanel"
          data-horizon-panel={idx}
          tabindex="0"
          class={`horizon-panel relative rounded-2xl sm:rounded-3xl overflow-hidden border transition-all duration-700 ease-[cubic-bezier(0.25,1,0.3,1)] cursor-pointer group flex flex-col justify-between ${
            isInit
              ? 'is-expanded border-gold/70 shadow-2xl ring-1 ring-gold/30'
              : 'is-collapsed border-hair hover:border-gold/40 shadow-md'
          }`}
        >
          {/* Background Full-Bleed Photograph */}
          <div class="panel-bg-image-wrap absolute inset-0 overflow-hidden pointer-events-none">
            <Image
              src={cardImg}
              alt={cap.title}
              class="w-full h-full object-cover transition-transform duration-1000 ease-out group-hover:scale-105"
              widths={[640, 1024, 1440]}
              sizes="(min-width: 1024px) 60vw, 100vw"
            />
            {/* Dynamic Multi-Layer Cinematic Scrim */}
            <div class="panel-scrim-dark absolute inset-0 bg-navy/80 transition-opacity duration-500"></div>
            <div class="panel-scrim-expanded absolute inset-0 bg-gradient-to-t from-navy/95 via-navy/75 via-55% to-transparent transition-opacity duration-500"></div>
          </div>

          {/* ==================== COLLAPSED VIEW (Vertical Ribbon Spine on Desktop only) ==================== */}
          <div class="collapsed-content relative z-10 p-5 sm:p-6 flex flex-row lg:flex-col justify-between items-center h-full w-full pointer-events-none">
            {/* Rotated Vertical Title on Desktop */}
            <div class="hidden lg:flex flex-1 items-center justify-center my-8">
              <span class="vertical-title text-sm font-bold text-white/90 tracking-wider uppercase whitespace-nowrap transform -rotate-90 origin-center transition-colors group-hover:text-gold">
                {cap.title}
              </span>
            </div>

            {/* Mobile Fallback Title */}
            <div class="lg:hidden flex-1 px-4">
              <span class="text-sm font-bold text-white leading-tight block">
                {cap.title}
              </span>
            </div>

            {/* Bottom Status Dot */}
            <div class="flex items-center justify-center">
              <span class="h-2 w-2 rounded-full bg-gold/60 transition-transform duration-300 group-hover:scale-150"></span>
            </div>
          </div>

          {/* ==================== EXPANDED VIEW (Rich Architectural Blueprint) ==================== */}
          <div class="expanded-content relative z-10 p-5 sm:p-8 lg:p-10 flex flex-col justify-end gap-4 sm:gap-6 h-full w-full pointer-events-none overflow-y-auto scrollbar-none">
            
            {/* Header: Title */}
            <div class="space-y-3 sm:space-y-4">
              <h3 class="text-xl sm:text-2xl lg:text-3xl font-bold text-white tracking-tight leading-tight max-w-2xl">
                {cap.title}
              </h3>

              <p class="text-sm sm:text-base lg:text-lg text-pale-navy/95 font-normal leading-relaxed max-w-3xl">
                {cap.p1}
              </p>
            </div>

            {/* Bottom Section: Second Paragraph / Technical Detail */}
            {cap.p2 && (
              <div class="pt-3 sm:pt-4 border-t border-white/15">
                <p class="text-xs sm:text-sm lg:text-base text-pale-navy/85 font-normal leading-relaxed max-w-3xl">
                  {cap.p2}
                </p>
              </div>
            )}

          </div>

          {/* Active Bottom Glow Line */}
          <div class="panel-glow-bar absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-gold to-transparent opacity-0 transition-opacity duration-500"></div>
        </div>
      );
    })}
  </div>
</div>

<style>
  /* ==================== DESKTOP PANORAMIC HORIZON STYLES ==================== */
  @media (min-width: 1024px) {
    .horizon-panel.is-collapsed {
      flex: 1 1 0%;
      min-width: 80px;
    }
    .horizon-panel.is-collapsed .collapsed-content {
      opacity: 1;
      visibility: visible;
      transition: opacity 0.4s ease 0.2s;
    }
    .horizon-panel.is-collapsed .expanded-content {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      position: absolute;
      inset: 0;
    }
    .horizon-panel.is-collapsed .panel-scrim-dark {
      opacity: 0.82;
    }
    .horizon-panel.is-collapsed .panel-scrim-expanded {
      opacity: 0;
    }

    .horizon-panel.is-expanded {
      flex: 4.8 1 0%;
    }
    .horizon-panel.is-expanded .collapsed-content {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      position: absolute;
      inset: 0;
    }
    .horizon-panel.is-expanded .expanded-content {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transition: opacity 0.5s ease 0.25s, transform 0.5s ease 0.25s;
    }
    .horizon-panel.is-expanded .panel-scrim-dark {
      opacity: 0;
    }
    .horizon-panel.is-expanded .panel-scrim-expanded {
      opacity: 1;
    }
    .horizon-panel.is-expanded .panel-glow-bar {
      opacity: 1;
    }
  }

  /* ==================== MOBILE / TABLET CONTINUOUS CARD FEED ==================== */
  @media (max-width: 1023px) {
    .horizon-deck {
      display: flex !important;
      flex-direction: column !important;
      gap: 1.25rem !important;
      height: auto !important;
    }
    .horizon-panel {
      position: relative !important;
      min-height: auto !important;
      height: auto !important;
      border-radius: 1.25rem !important;
      border: 1px solid rgba(255, 255, 255, 0.18) !important;
      background: #0A192F !important;
      box-shadow: 0 10px 30px -8px rgba(10, 25, 47, 0.45) !important;
      cursor: default !important;
    }
    .horizon-panel .collapsed-content {
      display: none !important;
    }
    .horizon-panel .expanded-content {
      display: flex !important;
      position: relative !important;
      opacity: 1 !important;
      visibility: visible !important;
      pointer-events: auto !important;
      padding: 1.5rem !important;
    }
    .horizon-panel .panel-scrim-dark {
      opacity: 0 !important;
    }
    .horizon-panel .panel-scrim-expanded {
      opacity: 1 !important;
      background: linear-gradient(to top, rgba(10, 25, 47, 0.98) 0%, rgba(10, 25, 47, 0.88) 60%, rgba(10, 25, 47, 0.65) 100%) !important;
    }
    .horizon-panel .panel-glow-bar {
      opacity: 1 !important;
    }
  }
</style>

<script>
  function initKineticHorizonStudio() {
    const studios = document.querySelectorAll<HTMLElement>('[data-kinetic-studio]');
    if (!studios.length) return;

    studios.forEach((studio) => {
      const panels = Array.from(studio.querySelectorAll<HTMLElement>('[data-horizon-panel]'));
      if (!panels.length) return;

      let currentExpandedIdx = 0;

      function expandPanel(index: number) {
        if (index === currentExpandedIdx) return;
        currentExpandedIdx = index;

        panels.forEach((panel, i) => {
          const isTarget = i === index;
          panel.classList.toggle('is-expanded', isTarget);
          panel.classList.toggle('border-gold/70', isTarget);
          panel.classList.toggle('shadow-2xl', isTarget);
          panel.classList.toggle('ring-1', isTarget);
          panel.classList.toggle('ring-gold/30', isTarget);

          panel.classList.toggle('is-collapsed', !isTarget);
          panel.classList.toggle('border-hair', !isTarget);
          panel.classList.toggle('shadow-md', !isTarget);
          panel.setAttribute('aria-expanded', isTarget ? 'true' : 'false');
        });
      }

      panels.forEach((panel, idx) => {
        // Expand on click (desktop)
        panel.addEventListener('click', () => {
          if (window.innerWidth >= 1024) {
            expandPanel(idx);
          }
        });

        panel.addEventListener('mouseenter', () => {
          if (window.innerWidth >= 1024) {
            expandPanel(idx);
          }
        });

        // Keyboard Accessibility
        panel.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            expandPanel(idx);
          } else if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
            e.preventDefault();
            const next = (idx + 1) % panels.length;
            panels[next]?.focus();
            expandPanel(next);
          } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
            e.preventDefault();
            const prev = (idx - 1 + panels.length) % panels.length;
            panels[prev]?.focus();
            expandPanel(prev);
          }
        });
      });
    });
  }

  initKineticHorizonStudio();
  document.addEventListener('astro:page-load', initKineticHorizonStudio);
</script>
