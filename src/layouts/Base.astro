---
// Base layout (§12) — head, meta, JSON-LD, skip-link, header, footer.
// Self-hosted Lato (§1) — weights 300/400/700/900 + 400 italic, font-display:swap.
import '@fontsource/lato/300.css';
import '@fontsource/lato/400.css';
import '@fontsource/lato/400-italic.css';
import '@fontsource/lato/700.css';
import '@fontsource/lato/900.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Preloader from '../components/Preloader.astro';
import { faqs } from '../data/faqs';
import { services } from '../data/services';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
}

const {
  title = 'APLYD | Applied AI for Governments & Impact-Focused Institutions',
  description = 'APLYD moves artificial intelligence from pilot to public service—engineering sovereign, field-tested AI solutions and institutional capability for governments, multilaterals, and global impact organizations.',
  keywords = 'Applied AI, Government AI, GovTech AI Solutions, Public Sector Digital Transformation, Decision Intelligence, Institutional AI Capability, Sovereign AI Infrastructure, Athena Infonomics, Independent AI Evaluation, Responsible AI in Government, Civic AI, Public Systems AI',
} = Astro.props;

// Canonical from configured `site` (astro.config.mjs → aplyd.ai). Falls back safely.
const site = Astro.site ?? new URL('https://aplyd.ai');
const isHome = Astro.url.pathname === '/';
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL('/og-image.png', site).href;

// Dynamic Path-aware Breadcrumb Schema
const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbs = [
  { '@type': 'ListItem', position: 1, name: 'Home', item: site.href },
  ...pathSegments.map((segment, index) => {
    const itemUrl = new URL('/' + pathSegments.slice(0, index + 1).join('/'), site).href;
    const formattedName = segment
      .split('-')
      .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
      .join(' ');
    return {
      '@type': 'ListItem',
      position: index + 2,
      name: segment === 'about' ? 'About APLYD' : formattedName,
      item: itemUrl,
    };
  }),
];

// --- Unified Schema.org Graph Structured Data (§12) ---
const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${site.href}#organization`,
      name: 'APLYD',
      legalName: 'APLYD by Athena Infonomics',
      url: site.href,
      logo: {
        '@type': 'ImageObject',
        '@id': `${site.href}#logo`,
        url: new URL('/assets/logos/aplyd-wordmark-navy.svg', site).href,
        contentUrl: new URL('/assets/logos/aplyd-wordmark-navy.svg', site).href,
        caption: 'APLYD Logo',
      },
      image: ogImage,
      description:
        'APLYD helps governments and impact-focused institutions apply artificial intelligence to strengthen public systems, improve decisions, and build lasting institutional capability.',
      parentOrganization: {
        '@type': 'Organization',
        name: 'Athena Infonomics',
        url: 'https://www.athenainfonomics.com',
      },
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'Partnerships & Advisory',
        url: new URL('/contact', site).href,
        availableLanguage: ['en'],
      },
      knowsAbout: [
        'Applied Artificial Intelligence',
        'GovTech AI Solutions',
        'Public Sector Digital Transformation',
        'Public Sector AI Implementation',
        'Decision Intelligence',
        'Institutional AI Capability Building',
        'Sovereign AI Infrastructure',
        'Sovereign Codebase Handover',
        'Independent AI Evaluation & Assurance',
        'Algorithmic Bias Audit for Public Services',
        'Responsible AI in Government',
        'AI for Global Development',
        'Frontline Systems Engineering',
      ],
      areaServed: 'Worldwide',
    },
    {
      '@type': 'WebSite',
      '@id': `${site.href}#website`,
      url: site.href,
      name: 'APLYD',
      description: 'Applied AI for governments and impact-focused institutions.',
      publisher: { '@id': `${site.href}#organization` },
      inLanguage: 'en-US',
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      isPartOf: { '@id': `${site.href}#website` },
      about: { '@id': `${site.href}#organization` },
      description: description,
      primaryImageOfPage: {
        '@type': 'ImageObject',
        url: ogImage,
      },
      inLanguage: 'en-US',
    },
    {
      '@type': 'ItemList',
      '@id': `${site.href}#services`,
      name: 'APLYD Applied AI Capabilities',
      description: 'Core service pillars moving institutions from AI ambition to real-world impact.',
      itemListElement: services.map((s, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: {
          '@type': 'Service',
          name: s.title,
          description: s.body,
          provider: {
            '@id': `${site.href}#organization`,
          },
        },
      })),
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonical}#faq`,
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: breadcrumbs,
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#232B65" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="author" content="APLYD by Athena Infonomics" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph / Facebook / LinkedIn -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="APLYD — Applied AI for Governments and Impact-Focused Institutions" />
    <meta property="og:site_name" content="APLYD" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="APLYD — Applied AI for Governments and Impact-Focused Institutions" />

    <!-- Structured Data (JSON-LD Graph) -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />
  </head>
  <body>
    {isHome && <Preloader />}
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <svg class="flow-line-svg" aria-hidden="true" width="1" height="1">
      <path class="flow-line-path" />
      <g class="flow-line-dots"></g>
      <g class="flow-line-head-group" opacity="0">
        <circle class="flow-line-head-halo" cx="0" cy="0" r="14" />
        <circle class="flow-line-head" cx="0" cy="0" r="5" />
      </g>
    </svg>

    <script>
      import { initFlowLine } from '../scripts/flowLine';
      initFlowLine();
      document.addEventListener('astro:page-load', initFlowLine);
    </script>
  </body>
</html>
