---
// Base layout (§12) — head, meta, JSON-LD, skip-link, header, footer.
// Self-hosted Lato (§1) — weights 300/400/700/900 + 400 italic, font-display:swap.
import '@fontsource/lato/300.css';
import '@fontsource/lato/400.css';
import '@fontsource/lato/400-italic.css';
import '@fontsource/lato/700.css';
import '@fontsource/lato/900.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Preloader from '../components/Preloader.astro';
import { faqs } from '../data/faqs';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'APLYD — Intelligence, Applied | Applied AI for Governments & Development',
  description = 'APLYD helps governments and development institutions apply AI to make better decisions, strengthen public systems, and build lasting capability. By Athena Infonomics.',
} = Astro.props;

// Canonical from configured `site` (astro.config.mjs → aplyd.ai). Falls back safely.
const site = Astro.site ?? new URL('https://aplyd.ai');
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL('/og-image.png', site).href;

// --- Structured data (§12) ---
const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'APLYD',
  url: site.href,
  logo: new URL('/favicon.svg', site).href,
  description,
  parentOrganization: {
    '@type': 'Organization',
    name: 'Athena Infonomics',
  },
  // TODO (§12/§16): add real profile URLs.
  sameAs: [] as string[],
};

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'APLYD',
  url: site.href,
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: site.href }],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#232B65" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="APLYD" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Preconnect not needed: fonts are self-hosted & bundled. -->

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  </head>
  <body>
    <Preloader />
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    {/* Page-wide flowing connector line (src/scripts/flowLine.ts). One svg,
        raw page-pixel coordinates via the "0x1 svg, overflow:visible" trick —
        no viewBox/scale bookkeeping needed. pointer-events:none so it can
        never block clicks; z-index sits below the fixed header (z-50) and
        mobile menu (z-60) but above normal section content. */}
    <svg class="flow-line-svg" aria-hidden="true" width="1" height="1">
      <path class="flow-line-path" />
      <g class="flow-line-dots"></g>
    </svg>
  </body>
</html>
