---
// Base layout (§12) — head, meta, JSON-LD, skip-link, header, footer.
// Self-hosted Lato (§1) — weights 300/400/700/900 + 400 italic, font-display:swap.
import '@fontsource/lato/300.css';
import '@fontsource/lato/400.css';
import '@fontsource/lato/400-italic.css';
import '@fontsource/lato/700.css';
import '@fontsource/lato/900.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Preloader from '../components/Preloader.astro';
import { faqs } from '../data/faqs';
import { services } from '../data/services';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
}

const {
  title = 'APLYD | Applied AI for Governments & Public Institutions',
  description = 'APLYD helps governments and impact-focused institutions apply artificial intelligence to strengthen public systems, improve decisions, and build lasting capability.',
  keywords = 'Applied AI, Government AI, Public Sector Artificial Intelligence, Decision Intelligence, Institutional AI Capability, Athena Infonomics, Field Intelligence, AI Evaluation',
} = Astro.props;

// Canonical from configured `site` (astro.config.mjs → aplyd.ai). Falls back safely.
const site = Astro.site ?? new URL('https://aplyd.ai');
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL('/og-image.png', site).href;

// --- Structured data (§12) ---
const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'APLYD',
  legalName: 'APLYD by Athena Infonomics',
  url: site.href,
  logo: new URL('/assets/logos/aplyd-wordmark-navy.svg', site).href,
  description,
  parentOrganization: {
    '@type': 'Organization',
    name: 'Athena Infonomics',
    url: 'https://www.athenainfonomics.com',
  },
  knowsAbout: [
    'Applied Artificial Intelligence',
    'Public Sector AI Implementation',
    'Decision Intelligence',
    'Institutional Capability Building',
    'Independent AI Evaluation & Assurance',
  ],
  areaServed: 'Worldwide',
  sameAs: [] as string[],
};

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'APLYD',
  url: site.href,
  description,
  inLanguage: 'en',
  publisher: {
    '@type': 'Organization',
    name: 'APLYD',
  },
};

const servicesLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'APLYD Applied AI Capabilities',
  description: 'Core service pillars moving institutions from AI ambition to real-world impact.',
  itemListElement: services.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Service',
      name: s.title,
      description: s.body,
      provider: {
        '@type': 'Organization',
        name: 'APLYD',
      },
    },
  })),
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.href },
    ...(Astro.url.pathname.startsWith('/contact')
      ? [{ '@type': 'ListItem', position: 2, name: 'Contact', item: canonical }]
      : []),
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#232B65" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="APLYD by Athena Infonomics" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph / Facebook / LinkedIn -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="APLYD" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(servicesLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  </head>
  <body>
    <Preloader />
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    {/* Page-wide flowing connector line (src/scripts/flowLine.ts). One svg,
        raw page-pixel coordinates via the "0x1 svg, overflow:visible" trick —
        no viewBox/scale bookkeeping needed. pointer-events:none so it can
        never block clicks; z-index sits below the fixed header (z-50) and
        mobile menu (z-60) but above normal section content. */}
    <svg class="flow-line-svg" aria-hidden="true" width="1" height="1">
      <path class="flow-line-path" />
      <g class="flow-line-dots"></g>
    </svg>
  </body>
</html>
